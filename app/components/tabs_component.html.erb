<div>
  <div class="sm:hidden">
    <label for="tabs" class="sr-only">Select a tab</label>
    <!-- Use an "onChange" listener to redirect the user to the selected tab URL. -->
    <select id="tabs" name="tabs" class="block w-full py-2 pl-3 pr-10 text-base border-gray-300 rounded-md focus:border-teal-500 focus:outline-none focus:ring-teal-500 sm:text-sm">
      <% tabs.each do |tab| %>
        <option <%= "selected" if tab.current %> value="<%= tab.path %>"><%= tab.title %></option>
      <% end %>
    </select>
  </div>
  <div class="hidden sm:block">
    <div class="border-b border-gray-200">
      <nav class="flex -mb-px space-x-8" aria-label="Tabs">
        <% tabs.each do |tab| %>
          <%= link_to tab.title, tab.path,
              class: class_names(
                "px-1 py-4 text-sm font-medium whitespace-nowrap",
                "border-teal-500 text-teal-600" => tab.current,
                "border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700" => !tab.current
              ),
              data: { turbo_prefetch: tab.prefetch }
          %>
        <% end %>
      </nav>
    </div>
  </div>
</div>
