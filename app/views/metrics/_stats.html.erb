<%= turbo_frame_tag :stats do %>
  <div class="mb-6">
    <dl class="grid grid-cols-1 overflow-hidden bg-white border border-gray-200 divide-y divide-gray-200 rounded-lg md:grid-cols-3 md:divide-x md:divide-y-0">
      <div class="px-4 py-5 sm:p-6">
        <dt class="text-base font-normal text-gray-900">Running Containers</dt>
        <dd class="flex items-baseline justify-between mt-1 md:block lg:flex">
          <div class="flex items-baseline text-2xl font-semibold text-indigo-600">
            <%= containers.size %>
          </div>
          <div class="mt-2">
            <% containers.map(&:dokku_process_type).tally.each do |process_type, count| %>
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800 mr-2 mb-2"><%= process_type %>: <%= count %></span>
            <% end %>
          </div>
        </dd>
      </div>
      <div class="px-4 py-5 sm:p-6">
        <dt class="text-base font-normal text-gray-900">Total CPU Usage</dt>
        <dd class="flex items-baseline justify-between mt-1 md:block lg:flex">
          <div class="flex items-baseline text-2xl font-semibold text-indigo-600">
            <%= total_cpu_usage %>%
          </div>
        </dd>
      </div>
      <div class="px-4 py-5 sm:p-6">
        <dt class="text-base font-normal text-gray-900">Total Memory Usage</dt>
        <dd class="flex items-baseline justify-between mt-1 md:block lg:flex">
          <div class="flex items-baseline text-2xl font-semibold text-indigo-600">
            <%= memory_usage_percentage %>%
            <span class="ml-2 text-sm font-medium text-gray-500"><%= memory_usage_megabytes.to_s %> / <%= memory_usage_limit_megabytes.to_s %> MB</span>
          </div>
        </dd>
      </div>
    </dl>
  </div>
<% end %>
