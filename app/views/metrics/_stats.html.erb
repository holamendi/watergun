<%= turbo_frame_tag :stats do %>
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
    <div class="card bg-elevated p-4">
      <div class="text-sm text-text-secondary">Running Containers</div>
      <div class="text-2xl font-semibold text-accent mt-1"><%= containers.size %></div>
      <div class="flex flex-wrap gap-1 mt-2">
        <% containers.map(&:dokku_process_type).tally.each do |process_type, count| %>
          <span class="badge badge-sm badge-ghost font-mono"><%= process_type %>: <%= count %></span>
        <% end %>
      </div>
    </div>
    <div class="card bg-elevated p-4">
      <div class="text-sm text-text-secondary">Total CPU Usage</div>
      <div class="text-2xl font-semibold text-accent mt-1"><%= total_cpu_usage %>%</div>
    </div>
    <div class="card bg-elevated p-4">
      <div class="text-sm text-text-secondary">Total Memory Usage</div>
      <div class="text-2xl font-semibold text-accent mt-1"><%= memory_usage_percentage %>%</div>
      <div class="text-sm text-text-secondary mt-1"><%= memory_usage_megabytes %> / <%= memory_usage_limit_megabytes %> MB</div>
    </div>
  </div>
<% end %>
