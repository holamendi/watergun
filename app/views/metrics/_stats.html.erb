<%= turbo_frame_tag :stats do %>
  <div class="mb-6">
    <dl class="stats shadow w-full">
      <div class="stat">
        <div class="stat-title">Running Containers</div>
        <div class="stat-value text-primary"><%= containers.size %></div>
        <div class="stat-desc">
          <% containers.map(&:dokku_process_type).tally.each do |process_type, count| %>
            <span class="badge badge-neutral mr-2 mb-2"><%= process_type %>: <%= count %></span>
          <% end %>
        </div>
      </div>
      <div class="stat">
        <div class="stat-title">Total CPU Usage</div>
        <div class="stat-value text-primary"><%= total_cpu_usage %>%</div>
      </div>
      <div class="stat">
        <div class="stat-title">Total Memory Usage</div>
        <div class="stat-value text-primary"><%= memory_usage_percentage %>%</div>
        <div class="stat-desc"><%= memory_usage_megabytes.to_s %> / <%= memory_usage_limit_megabytes.to_s %> MB</div>
      </div>
    </dl>
  </div>
<% end %>
