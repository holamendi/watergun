
<div id="<%= dom_id(service, :header) %>">
  <div class="flex justify-between mb-6">
    <div>
      <h1 class="text-3xl font-extrabold"><%= service.name %>
        <% if service.reload_current_action.present? %>
          <span class="font-normal badge badge-accent badge-lg" data-turbo-temporary>
            <%= service.current_action.action_type %> <span class="ml-4 loading loading-spinner loading-xs" data-turbo-temporary></span>
          </span>
        <% end %>
      </h1>
    </div>
    <div class="join">
      <%= link_to "Restart", restart_service_path(service), class: "btn join-item", disabled: service.current_action.present?, data: { "turbo-method" => :post } %>
    </div>
  </div>
  <div role="tablist" class="w-full mb-4 lg:w-1/2 tabs tabs-bordered">
    <%= link_to "overview", service, class: class_names("tab", "tab-active" => action_name  == "show"), role: "tab" %>
    <%= link_to "activity", activity_service_path(service), class: class_names("tab", "tab-active" => action_name  == "activity"), role: "tab" %>
    <%= link_to "settings", edit_service_path(service), class: class_names("tab", "tab-active" => action_name.in?(%w[edit update])), role: "tab" %>
  </div>
</div>
