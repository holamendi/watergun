<div>
  <div class="flex justify-between mb-10">
    <div>
      <h1 class="text-3xl font-extrabold"><%= service.name %>
        <% if service.reload_current_action.present? %>
          <span class="font-normal badge badge-accent badge-lg" data-turbo-temporary>
            <%= service.current_action.type %> <span class="ml-4 loading loading-spinner loading-xs" data-turbo-temporary></span>
          </span>
        <% end %>
      </h1>
    </div>
  </div>
  <div role="tablist" class="w-full mb-4 lg:w-1/2 tabs tabs-bordered tabs-md">
    <%= link_to "Activity", service_path(service), class: class_names("tab", "tab-active" => (controller_name == "services" && action_name  == "show")), role: "tab" %>
    <%= link_to "Linked Apps", service_service_links_path(service), class: class_names("tab", "tab-active" => (controller_name == "service_links")), role: "tab" %>
    <%= link_to "Metrics", service_metrics_path(service), class: class_names("tab", "tab-active" => (controller_name == "metrics")), role: "tab" %>
    <%= link_to "Environment", edit_app_environment_configuration_path(app), class: class_names("tab", "tab-active" => (controller_name == "environment_configurations")), role: "tab" if false %>
    <%= link_to "Settings", edit_service_path(service), class: class_names("tab", "tab-active" => (controller_name == "services" && action_name.in?(%w[edit update]))), role: "tab" %>
  </div>
</div>

