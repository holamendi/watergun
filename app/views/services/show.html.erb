<%= turbo_stream_from @service %>
<%= render "header", service: @service %>
<table class="table">
  <thead>
    <tr>
      <th>Id</th>
      <th>Action</th>
      <th>Completed</th>
      <th>Status</th>
    </tr>
  </thead>
  <tbody>
    <% @latest_actions.each do |action| %>
      <tr>
        <td><%= action.id %></td>
        <td><%= action.action_type %> <% if action.status_running? %>(running)<% end %></td>
        <td><%= action.completed_at %></td>
        <td><%= action.status %></td>
      </tr>
    <% end %>
  </tbody>
</table>
