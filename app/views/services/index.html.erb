<div class="flex justify-between mb-6">
  <h1 class="text-3xl font-extrabold">Services</h1>
  <%= link_to "Add new service", new_service_path, class: "link font-normal" %>
</div>
<div class="overflow-x-auto rounded-lg">
  <table class="table">
    <thead>
      <tr class="pl-0 uppercase">
        <th>Name</th>
        <th>Type</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @services.each do |service| %>
        <tr>
          <td class="py-6"><%= link_to service.name, service, class: "link" %></td>
          <td><%= service.service_type.capitalize %></td>
          <td class="text-right"><%= link_to "Delete", service, class: "text-error", data: { "turbo-method": :delete, "turbo-confirm": "Are you sure? "} %></td>
        </tr>
      <% end %>
    </table>
  </div>
</div>
