<%= turbo_stream_from @service %>
<%= render "services/header", service: @service %>
<div class="flex py-2">
  <%= link_to "Link App", new_service_service_link_path(@service), class: "btn" %>
</div>
<table class="table">
  <thead>
    <tr>
      <th>App</th>
      <th>Status</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @service_links.each do |service_link| %>
      <tr>
        <td><%= service_link.app.name %></td>
        <td><%= service_link.status %></td>
        <td class="text-right"><%= link_to "Unlink", service_service_link_path(@service, service_link), class: "text-error", data: { "turbo-method": :delete, "turbo-confirm": "Are you sure? "} %></td>
      </tr>
    <% end %>
  </tbody>
</table>
