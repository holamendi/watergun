<div class="flex justify-between mb-6">
  <h1 class="text-3xl font-extrabold">Apps</h1>
  <%= link_to "New App", new_app_path, class: "btn btn-primary", data: { turbo_frame: "modal_frame" } %>
</div>
<div class="overflow-x-auto rounded-lg">
  <table class="table">
    <thead>
      <tr class="pl-0 uppercase">
        <th>Name</th>
        <th>Last deploy</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @apps.each do |app| %>
        <tr>
          <td class="py-6"><%= link_to app.name, app, class: "link" %></td>
          <td >
            <% if app.last_deployment.present? %>
              <div class="tooltip" data-tip="<%= app.last_deployment.finished_at.to_s %>">
                <%= time_ago_in_words(app.last_deployment.finished_at) %> ago
              </div>
            <% end %>
          </td>
          <td>
            <%= app.last_deployment.sha.first(7) %>
          </td>
          <td class="text-right"><%= link_to "Delete", app, class: "text-error", data: { "turbo-method": :delete, "turbo-confirm": "Are you sure? "} %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
