<div class="flex justify-between mb-6">
  <h1 class="text-3xl font-extrabold">Apps</h1>
  <%= link_to "Add new app", new_app_path, class: "link font-normal", data: { turbo_frame: "modal_frame" } %>
</div>
<div class="overflow-x-auto rounded-lg">
  <table class="table">
    <thead>
      <tr class="pl-0 uppercase">
        <th>Name</th>
        <th>URL</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @apps.each do |app| %>
        <tr>
          <td class="py-6"><%= link_to app.name, app, class: "link" %></td>
          <td><%= link_to app.url, app.url, class: "link", target: :blank if app.url %></td>
          <td class="text-right"><%= link_to "Delete", app, class: "text-error", data: { "turbo-method": :delete, "turbo-confirm": "Are you sure? "} %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
