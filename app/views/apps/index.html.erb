<div class="flex justify-between mb-6">
  <h1 class="text-3xl font-extrabold">apps</h1>
  <%= link_to "new app", new_app_path, class: "link font-normal"  %>
</div>
<div class="overflow-x-auto rounded-lg">
  <table class="table">
    <thead>
      <tr class="pl-0 uppercase">
        <th>Name</th>
        <th>Last Deploy</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @apps.each do |app| %>
        <tr >
          <td class="py-6"><%= link_to app.name, app, class: "link" %></td>
          <td><%= l Time.current.to_date %></td>
          <td><%= link_to "Delete", app, class: "text-error", data: { "turbo-method": :delete, "turbo-confirm": "Are you sure? "} %></td>
        </tr>
      <% end %>
    </table>
  </div>
</div>
