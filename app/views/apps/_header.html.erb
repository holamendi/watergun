<%= turbo_stream_from app, :header %>
<div id="<%= dom_id(app, :header) %>">
  <div class="flex justify-between mb-6">
    <div>
      <h1 class="text-3xl font-extrabold"><%= app.name %>
        <% if app.reload_current_server_event.present? %>
          <span class="font-normal badge badge-accent badge-lg" data-turbo-temporary>
            <%= app.current_server_event.event_type %> <span class="ml-4 loading loading-spinner loading-xs" data-turbo-temporary></span>
          </span>
        <% end %>
      </h1>
    </div>
    <div class="join">
      <%= link_to "Deploy", deploy_app_path(app), class: "btn join-item", disabled: app.current_server_event.present?, data: { "turbo-method" => :post } %>
      <%= link_to "Restart", restart_app_path(app), class: "btn join-item", disabled: app.current_server_event.present?, data: { "turbo-method" => :post } %>
      <% if app.ssl_enabled? %>
        <%= link_to "Disable SSL", disable_ssl_app_path(app), class: "btn join-item", disabled: app.current_server_event.present?, data: { "turbo-method" => :post } %>
      <% else %>
        <%= link_to "Enable SSL", enable_ssl_app_path(app), class: "btn join-item", disabled: app.current_server_event.present?, data: { "turbo-method" => :post } %>
      <% end %>
    </div>
  </div>
  <div role="tablist" class="w-full mb-4 lg:w-1/2 tabs tabs-bordered">
    <%= link_to "overview", app_path(app), class: class_names("tab", "tab-active" => action_name  == "show"), role: "tab" %>
    <%= link_to "activity", activity_app_path(app), class: class_names("tab", "tab-active" => action_name  == "activity"), role: "tab" %>
    <%= link_to "settings", edit_app_path(app), class: class_names("tab", "tab-active" => action_name.in?(%w[edit update])), role: "tab" %>
  </div>
</div>
