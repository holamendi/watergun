<div>
  <div class="flex justify-between mb-10">
    <div>
      <h1 class="text-3xl font-extrabold"><%= app.name %>
        <% if app.reload_current_server_action.present? %>
          <span class="font-normal badge badge-accent badge-lg" data-turbo-temporary>
            <%= app.current_server_action.type.split(".").last %> <span class="ml-4 loading loading-spinner loading-xs" data-turbo-temporary></span>
          </span>
        <% end %>
      </h1>
      <% if app.last_deployed_at.present? && app.url.present? %>
        <%= link_to app.url, app.url, class: "link text-neutral text-sm", target: :blank %>
      <% end %>
    </div>
  </div>
  <div role="tablist" class="w-full mb-4 lg:w-2/3 tabs tabs-boxed tabs-md">
    <%= link_to "Overview", app_path(app), class: class_names("tab", "tab-active" => (controller_name == "apps" && action_name  == "show")), role: "tab" %>
    <%= link_to "Services", app_services_path(app), class: class_names("tab", "tab-active" => (controller_name == "services")), role: "tab" %>
    <%= link_to "Metrics", app_metrics_path(app), class: class_names("tab", "tab-active" => (controller_name == "metrics")), role: "tab" %>
    <%= link_to "Environment", edit_app_environment_configuration_path(app), class: class_names("tab", "tab-active" => (controller_name == "environment_configurations")), role: "tab" %>
    <%= link_to "Settings", edit_app_path(app), class: class_names("tab", "tab-active" => (controller_name == "apps" && action_name.in?(%w[edit update]))), role: "tab" %>
  </div>
</div>
