<h2 class="text-xl font-extrabold">General</h2>
<%= form_with model: app, class: "space-y-6" do |form| %>
  <div class="form-control">
    <%= form.label :name, class: "label" %>
    <%= form.text_field :name, class: "input input-bordered" %>
  </div>
  <div class="form-control">
    <%= form.label :git_repo, "Github Repo", class: "label" %>
    <%= turbo_frame_tag "git_repositories", src: git_repositories_path do %>
      <span class="loading loading-spinner loading-xs"></span>
    <% end %>
  </div>
  <%= form.submit "Save", class: "btn btn-primary text-white" %>
<% end %>
