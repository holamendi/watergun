<div role="tablist" class="w-full pb-4 overflow-scroll lg:w-1/2 tabs tabs-bordered">
  <%= link_to "Deployments", app_path(app), class: class_names("tab", "tab-active" => (controller_name == "apps" && action_name  == "show")), role: "tab" %>
  <%= link_to "Services", app_services_path(app), class: class_names("tab", "tab-active" => (controller_name == "services")), role: "tab" %>
  <%= link_to "Metrics", app_metrics_path(app), class: class_names("tab", "tab-active" => (controller_name == "metrics")), role: "tab" %>
  <%= link_to "Environment", edit_app_env_configuration_path(app), class: class_names("tab", "tab-active" => (controller_name == "environment_configurations")), role: "tab" %>
  <%= link_to "Settings", edit_app_path(app), class: class_names("tab", "tab-active" => (controller_name == "apps" && action_name.in?(%w[edit update]))), role: "tab" %>
</div>
