<%= turbo_stream_from @app %>
<%= render "header", app: @app %>
<% if @app.deploy_source %>
  <div class="flex py-2">
    <%= button_to "Deploy", app_deployments_path(@app), class:"btn btn-primary", disabled: @app.reload_current_action.present?  %>
  </div>
  <table class="table">
    <thead>
      <tr>
        <th>Action</th>
        <th>Completed</th>
        <th>Status</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @recent_actions.each do |action| %>
        <tr>
          <td><%= action.action_code %></td>
          <td>
            <% if action.completed? %>
              <div class="tooltip" data-tip="<%= action.completed_at.to_s %>">
                <%= time_ago_in_words(action.completed_at) %> ago
              </div>
            <% end %>
          </td>
          <td>
            <% if action.status_pending? %>
              <div class="badge badge-ghost">Queued</div>
            <% elsif action.status_running? %>
              <div class="text-white badge badge-info">Running</div>
            <% elsif action.status_success? %>
              <div class="text-white badge badge-success">Success</div>
            <% elsif action.status_failure? %>
              <div class="text-white badge badge-error">Failed</div>
            <% end %>
          </td>
          <td class="text-right"><% if action.completed? %> <%= link_to "View logs", logs_action_path(action), target: :_blank, class: "link" %> <% end %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <%= link_to "Add a deploy source", new_app_deploy_source_path(@app), class: "btn btn-primary text-white" %>
<% end %>
