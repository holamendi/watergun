<%= turbo_stream_from @app %>
<%= render "header", app: @app %>
<% if @app.deploy_source %>
  <div class="flex py-2">
    <%= button_to "Deploy", app_actions_path(@app), {params: { action_type: "deploy" }, class:"btn btn-primary btn-sm", disabled: @app.reload_current_action.present? } %>
  </div>
  <table class="table">
    <thead>
      <tr>
        <th>Id</th>
        <th>Action</th>
        <th>Completed</th>
        <th>Status</th>
      </tr>
    </thead>
    <tbody>
      <% @latest_actions.each do |action| %>
        <tr>
          <td><%= action.id %></td>
          <td><%= action.type %> <% if action.status_running? %>(running)<% end %></td>
          <td><%= action.completed_at %></td>
          <td><%= action.status %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <%= link_to "Add a deploy source", new_app_deploy_source_path(@app), class: "btn btn-primary text-white" %>
<% end %>
