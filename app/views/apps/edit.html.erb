<%= turbo_stream_from @app %>

<%= render "header", app: @app %>
<div class="w-full pb-6 md:w-1/3">
  <%= render "form", app: @app %>
</div>

<h1 class="pb-4 text-xl font-bold text-error">Danger zone</h1>
<%= button_to "Delete", app_path(@app), method: :delete, class: "btn btn-error btn-sm rounded-md font-normal text-sm", data: { turbo_confirm: "Sure?"} %>




