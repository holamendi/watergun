<%= render "header", app: @app %>
<div class="flex">
  <div>
    <%= render "menu", app: @app %>
  </div>
  <div class="flex-1 p-6 ml-4 border rounded-lg border-base-300">
    <%= render "form", app: @app %>
    <%= button_to "Destroy App", app_path(@app), class: "btn btn-error text-white mt-4", method: :delete, data: { "turbo-confirm": "Are you sure?" } %>
  </div>
</div>
