<%= turbo_stream_from @app %>
<%= render "apps/header", app: @app %>

<div class="flex py-2">
  <%= link_to "Attach Service", new_app_service_path(@app), class: "btn btn-primary float-right" %>
</div>
<table class="table">
  <thead>
    <tr>
      <th>Name</th>
      <th>Type</th>
      <th>Status</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @service_links.each do |service_link| %>
      <tr>
        <td><%= service_link.service.name %></td>
        <td><%= service_link.service.service_type %></td>
        <td>
           <% if service_link.pending? %>
              <div class="text-white badge badge-info">Provisioning</div>
            <% elsif service_link.linked? %>
              <div class="text-white badge badge-success">Active</div>
            <% end  %>
        </td>
        <td class="text-right"><%= link_to "Delete", app_service_path(@app, service_link.service), class: "text-error", data: { "turbo-method": :delete, "turbo-confirm": "Are you sure? "} %></td>
      </tr>
    <% end %>
  </tbody>
</table>
