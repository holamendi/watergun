<div class="dropdown dropdown-end">
  <div tabindex="0"
       role="button"
       class="<%= button_classes || "btn btn-primary" %>">
    <%= text %>
    <svg class="w-5 h-5 -mr-1" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
      <path fill-rule="evenodd" d="M10 5a1 1 0 011 1v3h3a1 1 0 110 2h-3v3a1 1 0 11-2 0v-3H6a1 1 0 110-2h3V6a1 1 0 011-1z" clip-rule="evenodd" />
    </svg>
  </div>
  <ul tabindex="0" class="dropdown-content menu bg-surface rounded z-10 w-56 p-2 shadow-lg border border-border">
    <% items.each do |item| %>
      <li><%= item %></li>
    <% end %>
  </ul>
</div>
