<% breadcrumbs = [] %>
<% breadcrumbs << [@project.name, project_path(@project)] if @project&.persisted? %>
<% breadcrumbs << [@app.name, project_app_path(@project, @app)] if @app&.persisted? %>
<% breadcrumbs << [@service.name, project_service_path(@project, @service)] if @service&.persisted? %>

<% if breadcrumbs.any? %>
  <div class="breadcrumbs text-sm font-mono">
    <ul>
      <% breadcrumbs.each do |(title, url)| %>
        <li>
          <% if url.nil? %>
            <%= title %>
          <% else %>
            <%= link_to title, url %>
          <% end %>
        </li>
      <% end %>
    </ul>
  </div>
<% end %>
