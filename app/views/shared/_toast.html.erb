<% class_mapping = {
    "notice" => "alert-success",
    "success" => "alert-success",
    "alert" => "alert-error",
    "error" => "alert-error",
    "warning" => "alert-warning",
    "info" => "alert-info"
  }
%>

<div role="alert" class="alert <%= class_mapping[type.to_s] %>" data-turbo-temporary>
  <span><%= message %></span>
  <button class="float-right" onclick="this.parentElement.remove()">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.2" stroke="currentColor" class="w-4 h-4">
      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>
</div>
