<%= turbo_stream_from Current.user, :toasts %>

<div id="toasts" aria-live="assertive" class="fixed inset-x-0 top-0 flex flex-col items-end px-4 py-6 space-y-4 pointer-events-none sm:p-6">
  <div class="flex flex-col items-center w-full space-y-4 sm:items-end">
    <% flash.each do |type, message| %>
      <%= render "shared/toast", message:, type: %>
    <% end %>
  </div>
</div>

