
<div id="<%= dom_id(log_stream) %>"
     class="px-2 py-1 relative overflow-auto text-xs text-gray-100 rounded-md bg-base-100 h-full"
     data-controller="log-stream"
     data-log-stream-url-value="<%= url %>"
     data-log-stream-ping-interval-value="5000"
     data-turbo-temporary>
  <div data-log-stream-target="overlay">
    <div class="absolute top-0 left-0 flex flex-col items-center justify-center w-full h-full">
      <div class="font-mono text-lg">
        initializing
      </div>
    </div>
  </div>
</div>
