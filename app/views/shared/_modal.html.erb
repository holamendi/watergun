<%# locals: (id: nil, title: nil) -%>

<dialog id="<%= id %>" class="modal">
  <div class="modal-box">
    <form method="dialog">
      <button class="absolute text-lg font-normal btn btn-circle btn-ghost right-2 top-2">✕</button>
    </form>
    <h3 class="text-lg font-bold"><%= title %></h3>
    <%= yield %>
  </div>
</dialog>
