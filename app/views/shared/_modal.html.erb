<%# locals: (id:, title:, frame: nil) -%>

<dialog id="<%= id %>" class="modal" data-controller="dialog">
  <div class="modal-box">
    <% header = capture do %>
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-sm font-semibold text-text-primary"><%= title %></h3>
        <form method="dialog">
          <%= config_close_button %>
        </form>
      </div>
    <% end %>

    <% if frame.present? %>
      <turbo-frame id="<%= frame %>" data-action="turbo:frame-load->dialog#open">
        <%= header %>
        <%= yield %>
      </turbo-frame>
    <% else %>
      <%= header %>
      <%= yield %>
    <% end %>
  </div>
</dialog>
