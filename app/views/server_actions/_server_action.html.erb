<tr id="<%= dom_id(server_action) %>" class="hover">
  <td>
    <%= link_to server_action_path(server_action), class: "flex items-center gap-2 hover:text-primary" do %>
      <span class="font-mono text-xs text-base-content/50">#<%= server_action.id %></span>
      <span class="font-medium"><%= server_action.slug %></span>
    <% end %>
  </td>
  <td>
    <% if server_action.actionable_type.present? %>
      <span class="font-mono text-sm">
        <%= "#{server_action.actionable_type.underscore.split('/').last}:#{server_action.actionable_id}" %>
      </span>
    <% else %>
      <span class="text-base-content/40 italic text-sm">destroyed</span>
    <% end %>
  </td>
  <td>
    <span class="text-sm"><%= server_action.user&.email || "—" %></span>
  </td>
  <td>
    <% if server_action.finished? %>
      <div class="tooltip" data-tip="<%= server_action.finished_at.strftime('%b %d, %Y at %H:%M:%S') %>">
        <span class="text-sm"><%= time_ago_in_words(server_action.finished_at) %> ago</span>
      </div>
    <% else %>
      <span class="text-base-content/40">—</span>
    <% end %>
  </td>
  <td>
    <% if server_action.finished? %>
      <span class="font-mono text-sm"><%= server_action.duration.round(1) %>s</span>
    <% else %>
      <span class="text-base-content/40">—</span>
    <% end %>
  </td>
  <td>
    <%= status_badge(server_action.status) %>
  </td>
  </tr>
