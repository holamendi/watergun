<%= turbo_stream_from Current.account, :server_actions %>

<% @title = "Activity" %>

<div class="page-shell py-6">
  <div class="mb-6">
    <h1 class="text-xl font-semibold text-text-primary">Activity</h1>
    <p class="text-text-muted text-xs mt-1">Recent server actions and deployments.</p>
  </div>

  <% if @server_actions.any? %>
    <div id="server_actions" class="bg-surface rounded border border-border divide-y divide-border">
      <%= render @server_actions %>
    </div>

    <%= render "shared/pagination", pagy: @pagy %>
  <% else %>
    <div class="bg-surface rounded border border-border p-8 text-center">
      <svg class="mx-auto h-10 w-10 text-text-muted" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
      </svg>
      <h3 class="mt-3 text-sm font-medium text-text-primary">No activity yet</h3>
      <p class="mt-1 text-xs text-text-muted">Server actions will appear here as they run.</p>
    </div>
  <% end %>
</div>
