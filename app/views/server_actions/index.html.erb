<%= turbo_stream_from current_account, :server_actions %>

<h1 class="pb-6 text-xl font-bold">Activity</h1>
<div class="overflow-x-auto rounded-md bg-base-100">
  <table class="table table-xs">
    <thead>
      <tr>
        <th>ID</th>
        <th>Slug</th>
        <th>Actionable</th>
        <th>User</th>
        <th>Finished</th>
        <th>Duration</th>
        <th>Status</th>
        <th></th>
      </tr>
    </thead>
    <tbody id="server_actions">
      <%= render @server_actions %>
    </tbody>
  </table>
</div>
