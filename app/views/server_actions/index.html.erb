<%= turbo_stream_from Current.account, :server_actions %>

<% @title = "Activity" %>

<div class="page-shell py-6">
  <div class="page-header">
    <div>
      <h1 class="page-title">Activity</h1>
      <div class="page-header-sub">Recent server actions across all projects</div>
    </div>
  </div>

  <% if @server_actions.any? %>
    <div id="server_actions" class="activity-list">
      <%= render @server_actions %>
    </div>

    <%= render "shared/pagination", pagy: @pagy %>
  <% else %>
    <div class="bg-surface rounded-lg border border-border p-8 text-center">
      <h3 class="text-sm font-medium text-text-primary">No activity yet</h3>
      <p class="mt-1 text-xs text-text-muted">Server actions will appear here as they run.</p>
    </div>
  <% end %>
</div>
