<%= turbo_stream_from current_org, :server_actions %>
<div class="overflow-x-auto rounded-lg">
  <table class="table table-xs">
    <thead>
      <tr>
        <th>id</th>
        <th>code</th>
        <th>actionable</th>
        <th>payload</th>
        <th>status</th>
        <th>finished_at</th>
        <th>duration</th>
      </tr>
    </thead>
    <tbody>
      <% @server_actions.each do |action| %>
        <tr>
          <td><%= action.id %></td>
          <td><%= action.class::ACTION_CODE %></td>
          <td><%= "#{action.actionable_type.downcase}_#{action.actionable_id}" %></td>
          <td><pre><%= JSON.pretty_generate(action.payload) %></pre></td>
          <td><span class="badge <%= status_badge_class(action.status) %>"><%= action.status %></span></td>
          <td><%= action.finished_at %></td>
          <td><% if action.finished? %><%= action.duration.round(1) %><% end %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
