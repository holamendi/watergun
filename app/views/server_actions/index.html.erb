<%= turbo_stream_from Current.account, :server_actions %>

<% @title = "Activity" %>

<%= container do %>
  <%= page_header(@title) %>

  <div class="flow-root">
    <div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
      <div class="inline-block min-w-full py-2 align-middle sm:px-6 lg:px-8">
        <table class="table">
          <thead>
            <tr>
              <th>ID</th>
              <th>Slug</th>
              <th>Actionable</th>
              <th>User</th>
              <th>Finished</th>
              <th>Duration</th>
              <th>Status</th>
              <th>
                <span class="sr-only">Actions</span>
              </th>
            </tr>
          </thead>
          <tbody id="server_actions">
            <%= render @server_actions %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
<% end %>
