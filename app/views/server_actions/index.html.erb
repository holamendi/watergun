<%= turbo_stream_from Current.account, :server_actions %>

<% @title = "Activity" %>

<%= container do %>
  <%= page_header(@title) %>

  <div class="card bg-base-100 shadow-sm">
    <div class="overflow-x-auto">
      <table class="table table-sm">
        <thead>
          <tr class="text-xs uppercase text-base-content/60">
            <th>Action</th>
            <th>Target</th>
            <th>User</th>
            <th>Completed</th>
            <th>Duration</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody id="server_actions">
          <%= render @server_actions %>
        </tbody>
      </table>
    </div>
  </div>

  <%= render "shared/pagination", pagy: @pagy %>
<% end %>
