<div class="overflow-x-auto rounded-lg">
  <table class="table">
    <thead>
      <tr>
        <th>id</th>
        <th>code</th>
        <th>actionable</th>
        <th>payload</th>
        <th>status</th>
        <th>created_at</th>
        <th>finished_at</th>
        <th>duration</th>
      </tr>
    </thead>
    <tbody>
      <% @server_actions.each do |action| %>
        <tr>
          <td><%= action.id %></td>
          <td><%= action.type %></td>
          <td><%= "#{action.actionable_type.downcase}_#{action.actionable_id}" %></td>
          <td><pre><%= JSON.pretty_generate(action.payload) %></pre></td>
          <td><%= action.status %></td>
          <td><%= action.finished_at %></td>
          <td><%= action.duration %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
