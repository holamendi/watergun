<%= turbo_stream_from @server_action %>

<% @title = @server_action.slug %>

<div class="page-shell py-6">
  <div class="mb-4">
    <%= ui_back_link "All Activity", server_actions_path %>
  </div>

  <%= ui_page_header(
      title: content_tag(:span, @server_action.slug, class: "font-mono"),
      subtitle: "##{@server_action.id}"
    ) do %>
    <%= status_badge(@server_action.status) %>
  <% end %>

  <% if @server_action.failure_message.present? %>
    <div class="bg-error-soft border border-error/30 rounded-xl p-4 mb-6">
      <div class="flex items-start gap-3">
        <svg class="h-5 w-5 text-error flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span class="text-sm text-error"><%= @server_action.failure_message %></span>
      </div>
    </div>
  <% end %>

  <div class="deploy-info-grid">
    <div class="deploy-info-item">
      <div class="deploy-info-label">Source</div>
      <div class="deploy-info-value mono"><%= @server_action.source %></div>
    </div>
    <div class="deploy-info-item">
      <div class="deploy-info-label">Server</div>
      <div class="deploy-info-value"><%= @server_action.server.name %></div>
    </div>
    <div class="deploy-info-item">
      <div class="deploy-info-label">Target</div>
      <div class="deploy-info-value mono">
        <% if @server_action.actionable_type.present? %>
          <%= "#{@server_action.actionable_type.underscore.split('/').last}:#{@server_action.actionable_id}" %>
        <% else %>
          <span class="text-text-muted">destroyed</span>
        <% end %>
      </div>
    </div>
    <div class="deploy-info-item">
      <div class="deploy-info-label">User</div>
      <div class="deploy-info-value"><%= @server_action.user&.email || "-" %></div>
    </div>
    <div class="deploy-info-item">
      <div class="deploy-info-label">Duration</div>
      <div class="deploy-info-value mono">
        <% if @server_action.finished? %>
          <%= @server_action.duration.round(2) %>s
        <% else %>
          -
        <% end %>
      </div>
    </div>
    <div class="deploy-info-item">
      <div class="deploy-info-label">Created</div>
      <div class="deploy-info-value" title="<%= @server_action.created_at.strftime('%b %d, %Y at %H:%M:%S') %>">
        <%= time_ago_in_words(@server_action.created_at) %> ago
      </div>
    </div>
  </div>

  <div class="section-label">Payload</div>
  <div class="bg-surface rounded-lg border border-border mb-6">
    <div class="p-4">
      <pre class="p-4 overflow-auto font-mono text-xs rounded-lg bg-elevated text-text-secondary max-h-64"><%= JSON.pretty_generate(@server_action.payload || {}) %></pre>
    </div>
  </div>

  <div class="section-label">Logs</div>
  <div class="log-panel">
    <% if @server_action.queued? || @server_action.running? %>
      <div class="p-8 text-center">
        <svg class="animate-spin mx-auto h-5 w-5 text-warning mb-2" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        <p class="text-xs text-text-muted">Waiting for action to complete...</p>
      </div>
    <% elsif @server_action.log.present? && @server_action.log.ssh_commands.any? %>
      <div class="divide-y divide-border">
        <% @server_action.log.ssh_commands.each do |command| %>
          <div>
            <div class="px-4 py-2 bg-elevated flex items-center justify-between">
              <code class="text-xs font-mono text-accent"><%= command["cmd"] %></code>
              <% if command["exit_code"] && command["exit_code"] != 0 %>
                <span class="px-2 py-0.5 text-xxs font-medium rounded bg-error-soft text-error">exit <%= command["exit_code"] %></span>
              <% end %>
            </div>
            <% output_text = command["output"]&.map { |o| o["data"] }&.join %>
            <% if output_text.present? %>
              <pre class="log-panel-content max-h-64 whitespace-pre-wrap"><%= output_text %></pre>
            <% else %>
              <div class="p-4 text-text-muted text-xs italic">No output</div>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="p-8 text-center">
        <p class="text-xs text-text-muted">No logs available</p>
      </div>
    <% end %>
  </div>
</div>
