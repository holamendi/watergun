<%= turbo_stream_from Current.account, :projects %>

<% @title = "Projects" %>
<% modal_id = "new_project_modal" %>

<div class="page-shell py-6">
  <%= page_header(title: "Projects") do %>
    <%= modal_trigger "New Project", modal_id: modal_id, size: :sm %>
  <% end %>

  <% if @projects.any? %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
      <%= render @projects %>
    </div>
  <% else %>
    <%= empty_state(title: "No projects yet") do %>
      <%= modal_trigger "Create your first project", modal_id: modal_id, variant: :ghost, class: "text-accent hover:underline" %>
    <% end %>
  <% end %>
</div>

<%= modal(id: modal_id, title: "New Project") do %>
  <%= render "form", project: @project %>
<% end %>
