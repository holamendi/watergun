<%= turbo_stream_from current_account, :projects %>
<div class="flex justify-between pb-[60px]">
  <h1 class="text-3xl font-normal">Projects</h1>
  <% if @projects.any? %>
    <div class="flex gap-5">
      <%= link_to new_project_path, class: "bg-[#0f1022] border-primary btn w-[140px] min-h-[45px] h-[45px] rounded-[10px] font-normal" do %>
        <span class="text-white text-normal">Project</span>
      <% end %>
    </div>
  <% end %>
</div>
<div id="projects w-full">
  <% if @projects.any? %>
    <div class="grid grid-cols-1 gap-[30px] lg:grid-cols-3 xl:grid-cols-4">
      <%= render @projects %>
    </div>
  <% else %>
    <div class="flex justify-center py-10">
      <div>
        <p><%= button_tag "Create your first project", class: "btn btn-lg btn-ghost link font-normal no-animation", onclick: "project_modal.showModal()" %></p>
      </div>
    </div>
  <% end %>
</div>
<%= render "shared/modal", id: "project_modal", title: "New Project" do %>
  <%= render "form", project: Project.new %>
<% end %>
