<%= turbo_stream_from Current.account, :projects %>

<% @title = "Projects" %>

<div class="page-shell py-6">
  <div class="page-header">
    <h1 class="page-title">Projects</h1>
    <%= link_to new_project_path, class: "btn btn-primary btn-sm" do %>
      New Project
    <% end %>
  </div>

  <% if @projects.any? %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
      <%= render @projects %>
    </div>
  <% else %>
    <div class="bg-surface rounded border border-border p-12 text-center">
      <p class="text-text-secondary mb-4">No projects yet</p>
      <%= link_to "Create your first project", new_project_path, class: "text-accent hover:underline" %>
    </div>
  <% end %>
</div>
