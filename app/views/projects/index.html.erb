<%= turbo_stream_from Current.account, :projects %>

<% @title = "Projects" %>

<%= container do %>
  <%= page_header(@title) do %>
    <%= link_to "New project", new_project_path, class: "inline-flex items-center rounded-md bg-teal-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-teal-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-600" %>
  <% end %>

  <ul role="list" class="overflow-hidden bg-white divide-y divide-gray-100 shadow-sm ring-1 ring-gray-900/5 sm:rounded-xl">
    <%= render @projects %>
  </ul>
<% end %>
