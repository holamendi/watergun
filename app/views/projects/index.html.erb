<%= turbo_stream_from Current.account, :projects %>

<% @title = "Projects" %>

<%= container do %>
  <%= page_header(@title) do %>
    <%= link_to "New project", new_project_path, class: "btn btn-primary" %>
  <% end %>

  <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
    <%= render @projects %>
  </div>
<% end %>
