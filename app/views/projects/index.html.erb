<%= turbo_stream_from Current.account, :projects %>

<% @title = "Projects" %>
<% modal_id = "new_project_modal" %>
<% import_modal_id = "dokku_import_modal" %>

<div class="page-shell py-6">
  <%= page_header(title: "Projects") do %>
    <div class="flex items-center gap-2">
      <%= modal_trigger "Import Dokku", modal_id: import_modal_id, variant: :secondary, size: :sm %>
      <%= modal_trigger "New Project", modal_id: modal_id, size: :sm %>
    </div>
  <% end %>

  <% if @projects.any? %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
      <%= render @projects %>
    </div>
  <% else %>
    <%= empty_state(title: "No projects yet") do %>
      <%= modal_trigger "Create your first project", modal_id: modal_id, variant: :ghost, class: "text-accent hover:underline" %>
    <% end %>
  <% end %>
</div>

<%= modal(id: modal_id, title: "New Project") do %>
  <%= render "form", project: @project %>
<% end %>

<%= modal(id: import_modal_id, title: "Import Dokku") do %>
  <%= form_with url: dokku_import_path, method: :post, class: "space-y-4" do |form| %>
    <label class="flex items-start gap-3 cursor-pointer">
      <%= form.check_box :include_watergun, class: "checkbox mt-1" %>
      <div>
        <span class="text-xs font-medium">Include Watergun resources</span>
        <p class="text-xs text-text-muted mt-0.5">Import apps and services whose Dokku IDs start with <code class="font-mono bg-elevated px-1 py-0.5 rounded-sm text-xxs">watergun</code>.</p>
      </div>
    </label>

    <div class="flex justify-end">
      <%= submit_button "Start import" %>
    </div>
  <% end %>
<% end %>
