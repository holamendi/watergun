<%= turbo_stream_from Current.account, :projects %>

<%= render PageHeaderComponent.new(title: "Projects") do |component| %>
  <% component.with_actions do %>
    <%= link_to "+ Project", new_project_path, class: "btn text-primary hover:btn-outline w-32" %>
  <% end %>
<% end %>

<div id="projects" class="grid grid-cols-1 gap-7 lg:grid-cols-3 xl:grid-cols-4">
  <%= render @projects %>
</div>

