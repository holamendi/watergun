
<h1 class="pb-6 text-2xl font-bold">Projects</h1>
<%= link_to "Create new project", new_project_path, class: "btn link btn-ghost" %>
<table class="table">
  <thead>
    <tr>
      <th>Name</th>
    </tr>
  </thead>
  <tbody>
    <% @projects.each do |project| %>
      <tr>
        <td><%= link_to project.name, project, class: "link" %></td>
      </tr>
    <% end %>
  </tbody>
</table>
