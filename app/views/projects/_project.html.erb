<% kept_apps = project.apps.select(&:kept?) %>
<% kept_services = project.services.select(&:kept?) %>

<%= link_to project_path(project),
    id: dom_id(project),
    class: "project-card" do %>
  <div class="project-card-header">
    <div class="project-name"><%= project.name %></div>
  </div>

  <div class="project-stats">
    <div class="project-stat">
      <span class="project-stat-num"><%= kept_apps.size %></span> <%= "app".pluralize(kept_apps.size) %>
    </div>
    <div class="project-stat">
      <span class="project-stat-num"><%= kept_services.size %></span> <%= "service".pluralize(kept_services.size) %>
    </div>
  </div>
<% end %>
