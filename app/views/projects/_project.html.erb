<%= link_to project_path(project), id: dom_id(project), class: "card bg-base-200 border border-base-300 hover:border-primary transition-colors" do %>
  <div class="card-body">
    <h2 class="card-title"><%= project.name %></h2>
    <p class="text-sm text-base-content/60">
      <% app_count = project.apps.kept.size %>
      <% service_count = project.services.kept.size %>
      <% if app_count.positive? || service_count.positive? %>
        <% parts = [] %>
        <% parts << pluralize(app_count, "app") if app_count.positive? %>
        <% parts << pluralize(service_count, "service") if service_count.positive? %>
        <%= parts.join(" • ") %>
      <% else %>
        No resources
      <% end %>
    </p>
    <div class="card-actions justify-end mt-2">
      <% if project.last_deployment %>
        <div class="badge badge-success">
          Deployed <%= time_ago_in_words(project.last_deployment.finished_at) %> ago
        </div>
      <% else %>
        <div class="badge badge-ghost">Not deployed</div>
      <% end %>
    </div>
  </div>
<% end %>
