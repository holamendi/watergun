<%= link_to project do %>
  <div class="bg-[#222121] rounded-[15px] p-10 outline-1 hover:outline hover:outline-primary">
    <h2 class="pb-5 text-base font-normal"><%= project.name %></h2>
    <div class="flex flex-col gap-[10px] mb-5 font-thin">
      <p class="text-sm"><%= pluralize project.apps.kept.size, "app" %></p>
      <p class="text-sm"><%= pluralize project.services.kept.size, "service" %></p>
    </div>
    <div class="flex gap-2">
      <span class="text-sm uppercase font-space-grotesk"><%= time_ago_in_words(project.updated_at) %> ago</span>
    </div>
  </div>
<% end%>
