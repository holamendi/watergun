<% kept_apps = project.apps.select(&:kept?) %>
<% kept_services = project.services.select(&:kept?) %>

<%= link_to project_path(project),
    id: dom_id(project),
    class: "group bg-surface rounded border border-border p-4 hover:border-accent/50 hover:shadow-lg hover:shadow-accent/10 transition-all" do %>
  <div class="mb-3">
    <span class="font-medium group-hover:text-accent transition-colors"><%= project.name %></span>
  </div>

  <% if kept_apps.any? || kept_services.any? %>
    <div class="flex items-center gap-2 flex-wrap">
      <% kept_apps.each do |app| %>
        <div class="w-6 h-6 rounded bg-elevated flex items-center justify-center" title="<%= app.name %>">
          <%= app_icon(app) %>
        </div>
      <% end %>
      <% kept_services.each do |service| %>
        <div class="w-6 h-6 rounded bg-elevated flex items-center justify-center" title="<%= service.name %> (<%= service.service_type.titleize %>)">
          <%= service_icon(service.service_type) %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="text-xs text-text-muted">Empty project</div>
  <% end %>
<% end %>
