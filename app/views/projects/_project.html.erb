<li id="<%= dom_id(project) %>" class="flex relative gap-x-6 justify-between px-4 py-5 hover:bg-gray-50 sm:px-6">
  <div class="flex gap-x-4 min-w-0">
    <div class="flex-auto min-w-0">
      <p class="font-semibold leading-6 text-gray-900">
        <%= link_to project_path(project) do %>
          <span class="absolute inset-x-0 bottom-0 -top-px"></span>
          <%= project.name %>
        <% end %>
      </p>
      <p class="flex mt-1 text-sm leading-5 text-gray-500">
        <% app_count = project.apps.kept.size %>
        <% service_count = project.services.kept.size %>

        <% if app_count.positive? %>
          <%= pluralize app_count, "app" %>
        <% end %>
        <% if service_count.positive? %>
          • <%= pluralize service_count, "service" %>
        <% end %>
      </p>
    </div>
  </div>
  <div class="flex gap-x-4 items-center shrink-0">
    <div class="hidden sm:flex sm:flex-col sm:items-end">
      <% if project.last_deployment %>
        <div class="flex gap-x-1.5 items-center mt-1">
          <div class="flex-none p-1 rounded-full bg-emerald-500/20">
            <div class="w-1.5 h-1.5 bg-emerald-500 rounded-full"></div>
          </div>
          <p class="text-sm leading-5 text-gray-500">Deployed <%= time_ago_in_words(project.last_deployment.finished_at) %> ago</p>
        </div>
      <% else %>
        <p class="mt-1 text-sm leading-5 text-gray-500">Not deployed</p>
      <% end %>
    </div>
    <svg class="flex-none w-5 h-5 text-gray-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
      <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" />
    </svg>
  </div>
</li>
