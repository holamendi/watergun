<%= link_to project, id: dom_id(project) do %>
  <div class="h-full p-9 bg-base-100 rounded-2xl outline-1 hover:outline hover:outline-primary">
    <h2 class="pb-5 text-lg font-normal"><%= project.name %></h2>
    <div class="flex flex-col gap-2 mb-5 font-extralight">
      <p class="text-sm"><%= pluralize project.apps.kept.size, "app" %></p>
      <p class="text-sm"><%= pluralize project.services.kept.size, "service" %></p>
    </div>
    <div>
      <div class="flex items-center gap-2 text-sm uppercase font-space-grotesk">
        <% if project.last_deployment %>
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 stroke-green-500">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
          </svg>
          <span>
            <%= time_ago_in_words(project.last_deployment.finished_at) %> ago
          </span>
        <% else %>
          Not deployed
        <% end %>
      </div>
    </div>
  </div>
<% end %>
