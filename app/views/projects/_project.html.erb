<%# locals: (project:) -%>

<%= link_to project do %>
  <div class="flex h-full rounded-md shadow-lg hover:shadow-xl card bg-base-200">
    <div class="flex-grow card-body">
      <h2 class="text-lg font-bold"><%= project.name %></h2>
      <ul class="text-sm">
        <li><%= pluralize project.apps.kept.count, "app" %></li>
        <li><%= pluralize project.services.kept.count, "service" %></li>
      </ul>
    </div>
  </div>
<% end %>
