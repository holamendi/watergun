<%= turbo_stream_from @app %>
<% @title = @app.name %>

<div class="px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto">
  <%# Header %>
  <div class="flex items-center justify-between mb-6">
    <div>
      <%= link_to project_path(@project), class: "text-sm text-base-content/60 hover:text-base-content inline-flex items-center gap-1 mb-1" do %>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
        </svg>
        <%= @project.name %>
      <% end %>
      <div class="flex items-center gap-2">
        <h1 class="text-2xl font-semibold font-mono"><%= @app.name %></h1>
        <%= status_dot(@app.status) %>
      </div>
      <div class="text-sm text-base-content/60 mt-1">
        <% if @app.github_repo.present? %>
          <%= @app.github_repo.branch %> branch
          <% if @app.deployed? %>
            · deployed <%= time_ago_in_words(@app.deployed_at) %> ago
          <% end %>
        <% elsif @app.deployed? %>
          Deployed <%= time_ago_in_words(@app.deployed_at) %> ago
        <% else %>
          Not deployed
        <% end %>
      </div>
    </div>

    <div class="flex items-center gap-2">
      <% if @app.github_repo.present? && !@app.temporary_status? %>
        <%= button_to project_app_deployments_path(@project, @app),
            class: "btn btn-primary btn-sm",
            form: { data: { turbo_stream: true } } do %>
          Deploy
        <% end %>
      <% end %>
      <% if @app.deployed? && !@app.temporary_status? %>
        <%= button_to project_app_restarts_path(@project, @app),
            class: "btn btn-ghost btn-sm",
            form: { data: { turbo_stream: true } } do %>
          Restart
        <% end %>
      <% end %>
      <%= link_to edit_project_app_path(@project, @app), class: "btn btn-ghost btn-sm btn-square", title: "Settings" do %>
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.325.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 0 1 1.37.49l1.296 2.247a1.125 1.125 0 0 1-.26 1.431l-1.003.827c-.293.241-.438.613-.43.992a7.723 7.723 0 0 1 0 .255c-.008.378.137.75.43.991l1.004.827c.424.35.534.955.26 1.43l-1.298 2.247a1.125 1.125 0 0 1-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.47 6.47 0 0 1-.22.128c-.331.183-.581.495-.644.869l-.213 1.281c-.09.543-.56.94-1.11.94h-2.594c-.55 0-1.019-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 0 1-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 0 1-1.369-.49l-1.297-2.247a1.125 1.125 0 0 1 .26-1.431l1.004-.827c.292-.24.437-.613.43-.991a6.932 6.932 0 0 1 0-.255c.007-.38-.138-.751-.43-.992l-1.004-.827a1.125 1.125 0 0 1-.26-1.43l1.297-2.247a1.125 1.125 0 0 1 1.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.086.22-.128.332-.183.582-.495.644-.869l.214-1.28Z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
        </svg>
      <% end %>
    </div>
  </div>

  <%# Process cards %>
  <% running_containers = @app.containers.running %>
  <% if running_containers.any? %>
    <div class="flex flex-wrap gap-3 mb-6">
      <% running_containers.group_by(&:dokku_process_type).each do |process_type, containers| %>
        <% container = containers.first %>
        <div class="card bg-base-200 p-3 min-w-32">
          <div class="flex items-center gap-2 mb-1">
            <span class="status status-success status-sm"></span>
            <span class="font-mono text-sm font-medium"><%= process_type %></span>
          </div>
          <% if container.cpu_percent.present? %>
            <div class="text-xs text-base-content/60">
              <%= number_to_percentage(container.cpu_percent, precision: 0) %> CPU · <%= number_to_human_size(container.memory_usage || 0) %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>

  <%# Tabs %>
  <div class="tabs tabs-border mb-6">
    <%= link_to "Deployments", project_app_deployments_path(@project, @app),
        class: "tab #{controller_name == 'apps' ? 'tab-active' : ''}" %>
    <%= link_to "Logs", project_app_log_streams_path(@project, @app),
        class: "tab", data: { turbo_prefetch: false } %>
    <%= link_to "Variables", project_app_env_variables_path(@project, @app),
        class: "tab" %>
    <%= link_to "Domains", project_app_domains_path(@project, @app),
        class: "tab" %>
    <%= link_to "Metrics", project_app_metrics_path(@project, @app),
        class: "tab" %>
  </div>

  <%# Recent deployments %>
  <% if @deployments.any? %>
    <div class="card bg-base-200 divide-y divide-base-300">
      <% @deployments.each do |deployment| %>
        <%= render "projects/apps/deployments/deployment_row", deployment: deployment %>
      <% end %>
    </div>
    <div class="mt-4">
      <%= link_to "View all deployments", project_app_deployments_path(@project, @app), class: "text-sm text-primary hover:underline" %>
    </div>
  <% else %>
    <div class="text-center py-12">
      <svg class="mx-auto h-12 w-12 text-base-content/40" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5m-13.5-9L12 3m0 0 4.5 4.5M12 3v13.5" />
      </svg>
      <h3 class="mt-4 text-lg font-medium">No deployments yet</h3>
      <p class="mt-1 text-sm text-base-content/60">Deploy your app to get started.</p>
      <% if @app.github_repo.present? %>
        <div class="mt-6">
          <%= button_to project_app_deployments_path(@project, @app),
              class: "btn btn-primary btn-sm",
              form: { data: { turbo_stream: true } } do %>
            Deploy now
          <% end %>
        </div>
      <% else %>
        <div class="mt-6">
          <%= link_to "Connect GitHub repo", new_app_github_repo_path(@app), class: "btn btn-primary btn-sm" %>
        </div>
      <% end %>
    </div>
  <% end %>

  <%# Linked Services %>
  <% linked_services = @app.services.kept %>
  <% if linked_services.any? %>
    <section class="mt-8">
      <h2 class="text-sm font-medium text-base-content/60 uppercase tracking-wide mb-3">Linked Services</h2>
      <div class="card bg-base-200 divide-y divide-base-300">
        <% linked_services.each do |service| %>
          <div class="p-4 flex items-center justify-between">
            <div class="flex items-center gap-2">
              <%= status_dot(service.status) %>
              <%= link_to service.name, project_service_metrics_path(@project, service), class: "font-mono hover:text-primary" %>
              <span class="badge badge-sm badge-ghost"><%= service.service_type.to_s.titleize %></span>
            </div>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>

  <%# External links %>
  <% if @app.github_repo.present? || @app.default_domain.present? %>
    <section class="mt-8">
      <h2 class="text-sm font-medium text-base-content/60 uppercase tracking-wide mb-3">Links</h2>
      <div class="flex flex-wrap gap-3">
        <% if @app.github_repo.present? %>
          <%= link_to @app.github_repo.web_url, target: :_blank, class: "btn btn-ghost btn-sm gap-2" do %>
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
            </svg>
            <%= @app.github_repo.repo %>
          <% end %>
        <% end %>
        <% if @app.deployed? && @app.default_domain.present? %>
          <%= link_to @app.default_domain.url, target: :_blank, class: "btn btn-ghost btn-sm gap-2" do %>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244" />
            </svg>
            <%= @app.default_domain.hostname %>
          <% end %>
        <% end %>
      </div>
    </section>
  <% end %>
</div>
