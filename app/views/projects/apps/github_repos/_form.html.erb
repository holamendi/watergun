<%= form_with model: github_repo, url: project_app_github_repo_path(github_repo.app.project, github_repo.app), id: "github_repo_form" do |form| %>
  <div class="grid max-w-2xl grid-cols-1 gap-x-6 gap-y-6 sm:grid-cols-6 md:col-span-2">
    <div class="sm:col-span-3">
      <fieldset class="fieldset">
        <legend class="fieldset-legend">Repository</legend>
        <%= form.text_field :repo, class: "input w-full", disabled: true %>
      </fieldset>
    </div>
    <div class="sm:col-span-3">
      <fieldset class="fieldset">
        <legend class="fieldset-legend">Branch</legend>
        <%= form.text_field :branch, class: "input w-full", disabled: true %>
      </fieldset>
    </div>
    <div class="sm:col-span-full">
      <label class="flex items-start gap-3 cursor-pointer">
        <%= form.check_box :webhook_deploy, class: "checkbox checkbox-primary mt-1" %>
        <div>
          <span class="font-medium">Deploy on Push</span>
          <p class="text-sm text-base-content/60">Automatically deploy the app when a push is made to the <code class="font-mono bg-base-200 px-1 py-0.5 rounded-sm"><%= github_repo.branch %></code> branch.</p>
        </div>
      </label>
    </div>
  </div>
  <div class="flex items-center mt-6 gap-x-6">
    <%= submit_button "Connect repository" %>
  </div>
<% end %>
