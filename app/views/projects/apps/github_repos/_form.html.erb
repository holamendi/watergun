<%= form_with model: github_repo, url: project_app_github_repo_path(github_repo.app.project, github_repo.app), class: "space-y-4" do |form| %>
  <% unless current_org.github_access_token.present? %>
    <%= form.label :github_access_token, class: "form-control" do %>
      <div class="label"><span class="label-text">Github access token</span></div>
      <%= text_field_tag :github_access_token, params[:github_access_token], class: "input input-bordered w-full" %>
    <% end %>
  <% end %>
  <%= form.label :repository, class: "form-control" do %>
    <div class="label"><span class="label-text">Repository</span></div>
    <%= form.text_field :repo, class: "input input-bordered w-full" %>
    <%= error_messages_for(form.object, :repo) %>
  <% end %>
  <%= form.label :branch, class: "form-control" do %>
    <div class="label"><span class="label-text">Branch</span></div>
    <%= form.text_field :branch, class: "input input-bordered w-full" %>
    <%= error_messages_for(form.object, :branch) %>
  <% end %>
  <%= button_tag type: "submit",
                 class: "btn btn-primary no-animation",
                 data: { turbo_submits_with: "<span class='loading loading-spinner'></span>" } do %>
    Save
  <% end %>
  <a class="btn btn-ghost" onclick="github_repo_modal.close()">Cancel</a>
<% end %>
