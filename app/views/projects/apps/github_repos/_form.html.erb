<%= form_with model: github_repo, url: project_app_github_repo_path(github_repo.app.project, github_repo.app), id: "github_repo_form" do |form| %>
  <div class="flex flex-col gap-5">
    <div class="flex flex-col flex-wrap w-full gap-x-4 md:flex-row">
      <label class="flex-1 form-control">
        <div class="pl-0 label"> <span class="label-text">Repo</span></div>
        <%= form.text_field :repo, class: "w-full p-3 text-sm font-light input font-poppins focus:border-primary focus:outline-none", readonly: true, disabled: true %>
      </label>
      <label class="flex-1 form-control">
        <div class="pl-0 label"><span class="text-sm text-white uppercase font-space-grotesk font-extralight label-text">Branch</span></div>
        <%= form.text_field :branch, class: "w-full p-3 text-sm font-light input font-poppins focus:border-primary focus:outline-none", readonly: true, disabled: true %>
      </label>
    </div>
    <label class="form-control">
      <div class="pl-0 label"><span class="label-text">Deploy on push</span></div>
      <%= form.check_box :webhook_deploy, class: "checkbox" %>
    </label>
    <div class="flex justify-end">
      <%= button_tag "Save", type: "submit", class: "btn btn-primary" %>
    </div>
  </div>
<% end %>
