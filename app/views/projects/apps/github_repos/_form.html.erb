<%= form_with model: github_repo, url: project_app_github_repo_path(github_repo.app.project, github_repo.app), id: "github_repo_form" do |form| %>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
    <fieldset class="fieldset">
      <legend class="fieldset-legend">Repository</legend>
      <%= form.text_field :repo, disabled: true, class: "input w-full font-mono text-text-muted cursor-not-allowed" %>
    </fieldset>
    <fieldset class="fieldset">
      <legend class="fieldset-legend">Branch</legend>
      <%= form.text_field :branch, disabled: true, class: "input w-full font-mono text-text-muted cursor-not-allowed" %>
    </fieldset>
  </div>
  <label class="flex items-start gap-3 cursor-pointer">
    <%= form.check_box :webhook_deploy, class: "checkbox mt-1" %>
    <div>
      <span class="text-xs font-medium">Deploy on Push</span>
      <p class="text-xs text-text-muted mt-0.5">Automatically deploy the app when a push is made to the <code class="font-mono bg-elevated px-1 py-0.5 rounded-sm text-xxs"><%= github_repo.branch %></code> branch.</p>
    </div>
  </label>
  <div class="mt-4 flex justify-end">
    <%= submit_button "Save repository" %>
  </div>
<% end %>
