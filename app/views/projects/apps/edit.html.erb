<%= turbo_stream_from @app %>

<%= render "header", app: @app %>

<div class="settings-section">
  <h2>Github Repo</h2>
  <%= render "projects/apps/github_repos/form", github_repo: @app.github_repo || @app.build_github_repo %>
</div>

<div class="my-10 divider"></div>

<div class="settings-section">
  <h2>Builder</h2>
  <%= render "projects/apps/builders/form", app: @app %>
</div>

<div class="my-10 divider"></div>

<div class="settings-section">
  <h2>Danger Zone</h2>
  <%= button_to "Delete App", project_app_path(current_project, @app), method: :delete, class: "btn rounded-full btn-error text-white", data: { turbo_confirm: "Sure?"} %>
</div>

