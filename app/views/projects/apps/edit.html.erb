<%= turbo_stream_from @app %>

<%= render "header", app: @app %>
<%= render "tabs", app: @app %>

<%= container do %>
  <div class="space-y-6 py-6">
    <div class="card bg-base-200">
      <div class="card-body">
        <div class="grid grid-cols-1 gap-x-8 gap-y-6 md:grid-cols-3">
          <div>
            <h2 class="font-semibold">General</h2>
            <p class="text-sm text-base-content/60 mt-1">Basic app information and identifiers.</p>
          </div>
          <div class="md:col-span-2">
            <%= render "form", app: @app %>
          </div>
        </div>
      </div>
    </div>

    <div class="card bg-base-200">
      <div class="card-body">
        <div class="grid grid-cols-1 gap-x-8 gap-y-6 md:grid-cols-3">
          <div>
            <h2 class="font-semibold">GitHub Repository</h2>
            <p class="text-sm text-base-content/60 mt-1">Connect a repository for automated deployments.</p>
          </div>
          <div class="md:col-span-2">
            <%= render "projects/apps/github_repos/form", github_repo: @app.github_repo || @app.build_github_repo %>
          </div>
        </div>
      </div>
    </div>

    <div class="card bg-base-200">
      <div class="card-body">
        <div class="grid grid-cols-1 gap-x-8 gap-y-6 md:grid-cols-3">
          <div>
            <h2 class="font-semibold">Builder</h2>
            <p class="text-sm text-base-content/60 mt-1">Configure how your app is built and deployed.</p>
          </div>
          <div class="md:col-span-2">
            <%= render "projects/apps/builders/form", app: @app %>
          </div>
        </div>
      </div>
    </div>

    <div class="card bg-base-200">
      <div class="card-body">
        <div class="grid grid-cols-1 gap-x-8 gap-y-6 md:grid-cols-3">
          <div>
            <h2 class="font-semibold">Domains</h2>
            <p class="text-sm text-base-content/60 mt-1">Custom domains and SSL certificates.</p>
          </div>
          <div class="md:col-span-2">
            <%= render "projects/apps/domains/domains", app: @app %>
          </div>
        </div>
      </div>
    </div>

    <div class="card bg-error/10 border border-error/20">
      <div class="card-body">
        <div class="grid grid-cols-1 gap-x-8 gap-y-6 md:grid-cols-3">
          <div>
            <h2 class="font-semibold text-error">Danger Zone</h2>
            <p class="text-sm text-base-content/60 mt-1">Irreversible actions that affect your app.</p>
          </div>
          <div class="md:col-span-2">
            <p class="text-sm text-base-content/70 mb-4">Once you delete an app, there is no going back. This will permanently remove the app and all its data from the server.</p>
            <%= button_to "Delete App", project_app_path(@project, @app), method: :delete, class: "btn btn-error", data: { turbo_confirm: "Are you sure you want to delete this app? This action cannot be undone."} %>
          </div>
        </div>
      </div>
    </div>
  </div>
<% end %>
