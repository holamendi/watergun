<%= turbo_stream_from @app %>
<% @title = "#{@app.name} · Settings" %>

<%= render "projects/apps/header", app: @app, active_tab: :edit %>

<div class="page-shell py-6">
  <div class="space-y-6">
    <div class="form-card" id="general">
      <div class="card-header">
        <span class="card-title">App Name</span>
      </div>
      <div class="card-body">
        <%= render "form", app: @app %>
      </div>
    </div>

    <div class="form-card" id="repository">
      <div class="card-header">
        <span class="card-title">Repository</span>
      </div>
      <div class="card-body">
        <%= render "projects/apps/github_repos/form", github_repo: @app.github_repo || @app.build_github_repo %>
      </div>
    </div>

    <div class="form-card" id="builder">
      <div class="card-header">
        <span class="card-title">Builder</span>
      </div>
      <div class="card-body">
        <%= render "projects/apps/builders/form", app: @app %>
      </div>
    </div>

    <div id="danger-zone">
      <div class="section-label" style="color: var(--color-error);">Danger Zone</div>
      <div class="danger-zone">
        <div class="danger-zone-header">Delete Application</div>
        <div class="danger-zone-desc">
          Once you delete this application, there is no going back. This will permanently remove the app,
          its deployments, domains, and environment variables from the server.
        </div>
        <%= button_to "Delete Application", project_app_path(@project, @app),
            method: :delete,
            class: "btn btn-danger btn-sm",
            data: { turbo_confirm: "Delete #{@app.name}? This cannot be undone." } %>
      </div>
    </div>
  </div>
</div>
