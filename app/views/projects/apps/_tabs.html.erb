<div class="py-3">
  <div class="max-w-5xl px-4 mx-auto lg:px-8 sm:px-6">
    <div role="tablist" class="tabs tabs-bordered">
      <%= tab_link "Deployments", project_app_deployments_path(app.project, app), controller_name == "deployments" %>
      <%= tab_link "Metrics", project_app_metrics_path(app.project, app), controller_name == "metrics" %>
      <%= tab_link "Logs", project_app_log_streams_path(app.project, app), controller_name == "log_streams", data: { turbo_prefetch: false } %>
      <%= tab_link "Variables", project_app_env_variables_path(app.project, app), controller_name == "env_variables" %>
      <%= tab_link "Settings", edit_project_app_path(app.project, app), controller_name == "apps" && action_name == "edit" %>
    </div>
  </div>
</div>
