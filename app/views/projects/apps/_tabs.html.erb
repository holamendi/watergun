<div class="pt-8">
  <%= component :tabs, [
    {
      title: "Deployments",
      path: project_app_path(app.project, app),
      current: controller_name == "apps" && action_name == "show"
    },
    {
      title: "Metrics",
      path: project_app_metrics_path(app.project, app),
      current: controller_name == "metrics"
    },
    {
      title: "Logs",
      path: project_app_log_streams_path(app.project, app),
      current: controller_name == "log_streams",
      prefetch: false
    },
    {
      title: "Variables",
      path: project_app_env_variables_path(app.project, app),
      current: controller_name == "env_variables"
    },
    {
      title: "Settings",
      path: edit_project_app_path(app.project, app),
      current: controller_name == "apps" && action_name == "edit"
    }
  ] %>
</div>
