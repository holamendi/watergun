<%= form_with model: app, url: project_app_builder_path(app.project, app), id: "builder_form" do |form| %>
  <div class="max-w-xs">
    <label class="block text-xs font-medium text-text-secondary mb-1.5">Builder</label>
    <%= form.select :builder, App.builders, {}, class: "w-full px-3 py-2 bg-base border border-border rounded text-sm focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20 transition-all" %>
    <%= error_messages_for(form.object, :builder) %>
  </div>
  <div class="mt-4">
    <%= submit_button "Save builder" %>
  </div>
<% end %>
