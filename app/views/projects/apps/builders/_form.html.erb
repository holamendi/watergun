<%= form_with model: app, url: project_app_builder_path(app.project, app), class: "config-settings-form", id: "builder_form" do |form| %>
  <fieldset class="fieldset">
    <legend class="fieldset-legend">Builder</legend>
    <%= form.select :builder, App.builders, {}, class: "select w-full" %>
    <%= error_messages_for(form.object, :builder) %>
  </fieldset>
  <div class="config-form-footer">
    <%= config_action "Save builder", type: :submit %>
  </div>
<% end %>
