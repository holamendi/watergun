<%= form_with model: app, url: project_app_builder_path(app.project, app), id: "builder_form" do |form| %>
  <div class="flex flex-col gap-5">
    <div class="flex flex-col flex-wrap w-full gap-x-4 md:flex-row">
      <label class="w-full md:w-1/2 form-control">
        <div class="pl-0 label"> <span class="label-text">Builder</span></div>
        <%= form.select :builder, App.builders, {}, class: "select select-bordered font-light focus:border-primary focus:outline-none" %>
        <%= error_messages_for(form.object, :builder) %>
      </label>
    </div>
    <div class="flex justify-end">
      <%= button_tag "Save", type: "submit", class: "btn btn-primary no-animation w-20 rounded-full" %>
    </div>
  </div>
<% end %>
