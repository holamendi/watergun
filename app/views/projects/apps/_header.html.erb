<%= turbo_stream_from app %>
<% @title = app.name %>
<% active_tab ||= nil %>

<div class="-mt-6 border-b border-border bg-surface">
  <div class="max-w-7xl mx-auto px-4 flex items-center justify-between">
    <nav class="scrollable-tabs flex items-center gap-0 -mb-px overflow-x-auto" aria-label="App navigation">
      <%= link_to "Overview", project_app_path(app.project, app),
          class: class_names("shrink-0 px-3 py-2.5 text-xs border-b-2",
            "text-accent font-medium border-accent": active_tab == :overview,
            "text-text-secondary hover:text-text-primary border-transparent hover:border-text-muted": active_tab != :overview),
          aria: { current: (active_tab == :overview ? "page" : nil) } %>
      <%= link_to "Deployments", project_app_deployments_path(app.project, app),
          class: class_names("shrink-0 px-3 py-2.5 text-xs border-b-2",
            "text-accent font-medium border-accent": active_tab == :deployments,
            "text-text-secondary hover:text-text-primary border-transparent hover:border-text-muted": active_tab != :deployments),
          aria: { current: (active_tab == :deployments ? "page" : nil) } %>
      <%= link_to "Logs", project_app_log_streams_path(app.project, app),
          class: class_names("shrink-0 px-3 py-2.5 text-xs border-b-2",
            "text-accent font-medium border-accent": active_tab == :log_streams,
            "text-text-secondary hover:text-text-primary border-transparent hover:border-text-muted": active_tab != :log_streams),
          aria: { current: (active_tab == :log_streams ? "page" : nil) },
          data: { turbo_prefetch: false } %>
      <%= link_to "Variables", project_app_env_variables_path(app.project, app),
          class: class_names("shrink-0 px-3 py-2.5 text-xs border-b-2",
            "text-accent font-medium border-accent": active_tab == :env_variables,
            "text-text-secondary hover:text-text-primary border-transparent hover:border-text-muted": active_tab != :env_variables),
          aria: { current: (active_tab == :env_variables ? "page" : nil) } %>
      <%= link_to "Domains", project_app_domains_path(app.project, app),
          class: class_names("shrink-0 px-3 py-2.5 text-xs border-b-2",
            "text-accent font-medium border-accent": active_tab == :domains,
            "text-text-secondary hover:text-text-primary border-transparent hover:border-text-muted": active_tab != :domains),
          aria: { current: (active_tab == :domains ? "page" : nil) } %>
      <%= link_to "Metrics", project_app_metrics_path(app.project, app),
          class: class_names("shrink-0 px-3 py-2.5 text-xs border-b-2",
            "text-accent font-medium border-accent": active_tab == :metrics,
            "text-text-secondary hover:text-text-primary border-transparent hover:border-text-muted": active_tab != :metrics),
          aria: { current: (active_tab == :metrics ? "page" : nil) } %>
      <%= link_to "Settings", edit_project_app_path(app.project, app),
          class: class_names("shrink-0 px-3 py-2.5 text-xs border-b-2",
            "text-accent font-medium border-accent": active_tab == :edit,
            "text-text-secondary hover:text-text-primary border-transparent hover:border-text-muted": active_tab != :edit),
          aria: { current: (active_tab == :edit ? "page" : nil) } %>
    </nav>

    <div class="flex items-center shrink-0">
      <span class="text-xxs text-text-muted">
        <span class="w-1.5 h-1.5 rounded-full bg-success inline-block mr-1"></span>
        <% if app.deployed? %>
          <%= time_ago_in_words(app.deployed_at) %> ago
        <% else %>
          Not deployed
        <% end %>
      </span>
    </div>
  </div>
</div>
