<div id="<%= dom_id(app, :header) %>">
  <div class="flex justify-between pb-6">
    <div>
      <h1 class="pb-6 text-3xl font-normal">
        <%= app.name %>
        <% if app.temporary_status? %>
          <span class="text-sm font-normal text-success">
            <%= app.status %>
            <span class="loading loading-spinner loading-xs"></span>
          </span>
        <% end %>
      </h1>
      <% if app.github_repo.present? %>
        <div class="flex mb-4 space-x-10">
          <%= link_to app.github_repo.web_url, target: :_blank ,class: "font-extralight text-sm link" do %>
            <svg xmlns="http://www.w3.org/2000/svg" class="inline w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.438 9.8 8.205 11.385.6.11.82-.26.82-.577v-2.165c-3.338.726-4.042-1.61-4.042-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.09-.745.083-.73.083-.73 1.205.085 1.84 1.24 1.84 1.24 1.07 1.835 2.807 1.305 3.492.998.108-.775.42-1.305.763-1.605-2.665-.3-5.466-1.335-5.466-5.93 0-1.31.467-2.38 1.235-3.22-.123-.303-.535-1.523.117-3.176 0 0 1.008-.322 3.3 1.23.957-.266 1.98-.398 3-.403 1.02.005 2.043.137 3 .403 2.29-1.552 3.297-1.23 3.297-1.23.653 1.653.24 2.873.118 3.176.77.84 1.233 1.91 1.233 3.22 0 4.61-2.803 5.625-5.475 5.92.43.37.823 1.102.823 2.222v3.293c0 .32.218.694.825.577C20.565 21.8 24 17.3 24 12c0-6.63-5.37-12-12-12z"/></svg>
            <%= app.github_repo.repo %>
          <% end %>

          <% if app.deployed? && app.default_domain.present? %>
            <%= link_to app.default_domain.url, target: :_blank, class: "font-extralight text-sm link" do %>
              <svg xmlns="http://www.w3.org/2000/svg" class="inline w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm0 22c-5.514 0-10-4.486-10-10S6.486 2 12 2s10 4.486 10 10-4.486 10-10 10zm0-18c-4.411 0-8 3.589-8 8s3.589 8 8 8 8-3.589 8-8-3.589-8-8-8zm0 14c-3.313 0-6-2.687-6-6s2.687-6 6-6 6 2.687 6 6-2.687 6-6 6z"/></svg>
              <%= app.default_domain.url %>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
