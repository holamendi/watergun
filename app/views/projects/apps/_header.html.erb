<%= turbo_stream_from app %>
<% @title = app.name %>
<% active_tab ||= nil %>

<div class="app-tabs-wrapper">
  <div class="app-tabs">
    <nav class="scrollable-tabs flex items-center gap-0 -mb-px overflow-x-auto" aria-label="App navigation">
      <%= link_to "Deployments", project_app_deployments_path(app.project, app),
          class: class_names("app-tab",
            "app-tab-active": active_tab == :deployments,
            "app-tab-inactive": active_tab != :deployments),
          aria: { current: (active_tab == :deployments ? "page" : nil) } %>
      <%= link_to "Logs", project_app_log_streams_path(app.project, app),
          class: class_names("app-tab",
            "app-tab-active": active_tab == :logs,
            "app-tab-inactive": active_tab != :logs),
          aria: { current: (active_tab == :logs ? "page" : nil) },
          data: { turbo_prefetch: false } %>
      <%= link_to "Metrics", project_app_metrics_path(app.project, app),
          class: class_names("app-tab",
            "app-tab-active": active_tab == :metrics,
            "app-tab-inactive": active_tab != :metrics),
          aria: { current: (active_tab == :metrics ? "page" : nil) } %>
      <%= link_to "Settings", project_app_settings_path(app.project, app),
          class: class_names("app-tab",
            "app-tab-active": active_tab == :settings,
            "app-tab-inactive": active_tab != :settings),
          aria: { current: (active_tab == :settings ? "page" : nil) } %>
    </nav>

    <div class="flex items-center shrink-0">
      <span class="text-xxs text-text-muted">
        <span class="w-1.5 h-1.5 rounded-full bg-success inline-block mr-1"></span>
        <% if app.deployed? %>
          <%= time_ago_in_words(app.deployed_at) %> ago
        <% else %>
          Not deployed
        <% end %>
      </span>
    </div>
  </div>
</div>
