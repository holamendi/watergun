<%= turbo_stream_from app %>
<% @title = app.name %>

<div class="bg-surface border-b border-border">
  <div class="max-w-6xl mx-auto px-4 py-4">
    <!-- Back + Title -->
    <div class="flex items-center justify-between mb-4">
      <div>
        <%= link_to project_path(app.project), class: "text-xs text-text-muted hover:text-text-secondary mb-1 inline-block" do %>
          &larr; <%= app.project.name %>
        <% end %>
        <h1 class="text-xl font-semibold flex items-center gap-2">
          <span class="font-mono"><%= app.name %></span>
          <%= status_dot(app.status) %>
        </h1>
        <div class="text-xs text-text-muted mt-1">
          <% if app.deployed? %>
            Last deployed <%= time_ago_in_words(app.deployed_at) %> ago
          <% else %>
            Never deployed
          <% end %>
        </div>
      </div>

      <div class="flex items-center gap-2">
        <% if app.github_repo.present? && !app.temporary_status? %>
          <%= button_to project_app_deployments_path(app.project, app),
              class: "px-4 py-2 bg-gradient-to-r from-accent to-accent-hover text-white text-xs font-medium rounded-lg shadow shadow-accent/20",
              form: { data: { turbo_stream: true } } do %>
            Deploy
          <% end %>
        <% end %>
        <% if app.deployed? && !app.temporary_status? %>
          <%= button_to project_app_restarts_path(app.project, app),
              class: "px-4 py-2 bg-elevated hover:bg-border text-text-primary text-xs font-medium rounded-lg border border-border",
              form: { data: { turbo_stream: true } } do %>
            Restart
          <% end %>
        <% end %>
      </div>
    </div>

    <!-- Tabs -->
    <div class="inline-flex bg-elevated rounded-lg p-0.5">
      <%= link_to "Overview", project_app_path(app.project, app),
          class: "px-3 py-1.5 text-xs rounded-md #{current_page?(project_app_path(app.project, app)) ? 'text-text-primary bg-surface shadow-sm font-medium' : 'text-text-secondary hover:text-text-primary'}" %>
      <%= link_to "Deployments", project_app_deployments_path(app.project, app),
          class: "px-3 py-1.5 text-xs rounded-md #{request.path.include?('deployments') ? 'text-text-primary bg-surface shadow-sm font-medium' : 'text-text-secondary hover:text-text-primary'}" %>
      <%= link_to "Logs", project_app_log_streams_path(app.project, app),
          class: "px-3 py-1.5 text-xs rounded-md #{request.path.include?('logs') ? 'text-text-primary bg-surface shadow-sm font-medium' : 'text-text-secondary hover:text-text-primary'}",
          data: { turbo_prefetch: false } %>
      <%= link_to "Variables", project_app_env_variables_path(app.project, app),
          class: "px-3 py-1.5 text-xs rounded-md #{request.path.include?('env') ? 'text-text-primary bg-surface shadow-sm font-medium' : 'text-text-secondary hover:text-text-primary'}" %>
      <%= link_to "Domains", project_app_domains_path(app.project, app),
          class: "px-3 py-1.5 text-xs rounded-md #{request.path.include?('domains') ? 'text-text-primary bg-surface shadow-sm font-medium' : 'text-text-secondary hover:text-text-primary'}" %>
      <%= link_to "Metrics", project_app_metrics_path(app.project, app),
          class: "px-3 py-1.5 text-xs rounded-md #{request.path.include?('metrics') ? 'text-text-primary bg-surface shadow-sm font-medium' : 'text-text-secondary hover:text-text-primary'}" %>
      <%= link_to "Settings", edit_project_app_path(app.project, app),
          class: "px-3 py-1.5 text-xs rounded-md #{current_page?(edit_project_app_path(app.project, app)) ? 'text-text-primary bg-surface shadow-sm font-medium' : 'text-text-secondary hover:text-text-primary'}" %>
    </div>
  </div>
</div>
