<%= turbo_stream_from app %>
<% @title = app.name %>
<% active_tab ||= nil %>

<div class="bg-surface border-b border-border">
  <div class="max-w-7xl mx-auto px-4 py-3">
    <%# Back + Title %>
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4">
      <div>
        <%= link_to project_path(app.project), class: "text-xxs text-text-muted hover:text-accent" do %>
          &larr; <%= app.project.name %>
        <% end %>
        <h1 class="text-lg font-semibold flex items-center gap-2">
          <%= app.name %>
          <span class="w-2 h-2 rounded-full bg-success shadow-lg shadow-success/50"></span>
        </h1>
        <div class="text-xs text-text-muted mt-0.5">
          <% if app.deployed? %>
            Last deployed <%= time_ago_in_words(app.deployed_at) %> ago
          <% else %>
            Never deployed
          <% end %>
        </div>
      </div>

      <div class="flex items-center gap-2">
        <% if app.github_repo.present? && !app.temporary_status? %>
          <%= form_with url: project_app_deployments_path(app.project, app), data: { turbo_stream: true } do %>
            <%= submit_button "Deploy", size: :sm %>
          <% end %>
        <% end %>
        <% if app.deployed? && !app.temporary_status? %>
          <%= form_with url: project_app_restarts_path(app.project, app), data: { turbo_stream: true } do %>
            <%= submit_button "Restart", variant: :secondary, size: :sm %>
          <% end %>
        <% end %>
      </div>
    </div>

    <%# Segmented Control Tabs %>
    <div class="overflow-x-auto">
      <nav class="inline-flex bg-elevated rounded p-0.5" aria-label="App navigation">
        <%= link_to "Overview", project_app_path(app.project, app),
            class: class_names("px-3 py-1.5 text-xs rounded-sm",
              "text-text-primary bg-surface shadow-sm font-medium": active_tab == :overview,
              "text-text-secondary hover:text-text-primary": active_tab != :overview),
            aria: { current: (active_tab == :overview ? "page" : nil) } %>
        <%= link_to "Deployments", project_app_deployments_path(app.project, app),
            class: class_names("px-3 py-1.5 text-xs rounded-sm",
              "text-text-primary bg-surface shadow-sm font-medium": active_tab == :deployments,
              "text-text-secondary hover:text-text-primary": active_tab != :deployments),
            aria: { current: (active_tab == :deployments ? "page" : nil) } %>
        <%= link_to "Logs", project_app_log_streams_path(app.project, app),
            class: class_names("px-3 py-1.5 text-xs rounded-sm",
              "text-text-primary bg-surface shadow-sm font-medium": active_tab == :log_streams,
              "text-text-secondary hover:text-text-primary": active_tab != :log_streams),
            aria: { current: (active_tab == :log_streams ? "page" : nil) },
            data: { turbo_prefetch: false } %>
        <%= link_to "Variables", project_app_env_variables_path(app.project, app),
            class: class_names("px-3 py-1.5 text-xs rounded-sm",
              "text-text-primary bg-surface shadow-sm font-medium": active_tab == :env_variables,
              "text-text-secondary hover:text-text-primary": active_tab != :env_variables),
            aria: { current: (active_tab == :env_variables ? "page" : nil) } %>
        <%= link_to "Domains", project_app_domains_path(app.project, app),
            class: class_names("px-3 py-1.5 text-xs rounded-sm",
              "text-text-primary bg-surface shadow-sm font-medium": active_tab == :domains,
              "text-text-secondary hover:text-text-primary": active_tab != :domains),
            aria: { current: (active_tab == :domains ? "page" : nil) } %>
        <%= link_to "Metrics", project_app_metrics_path(app.project, app),
            class: class_names("px-3 py-1.5 text-xs rounded-sm",
              "text-text-primary bg-surface shadow-sm font-medium": active_tab == :metrics,
              "text-text-secondary hover:text-text-primary": active_tab != :metrics),
            aria: { current: (active_tab == :metrics ? "page" : nil) } %>
        <%= link_to "Settings", edit_project_app_path(app.project, app),
            class: class_names("px-3 py-1.5 text-xs rounded-sm",
              "text-text-primary bg-surface shadow-sm font-medium": active_tab == :edit,
              "text-text-secondary hover:text-text-primary": active_tab != :edit),
            aria: { current: (active_tab == :edit ? "page" : nil) } %>
      </nav>
    </div>
  </div>
</div>
