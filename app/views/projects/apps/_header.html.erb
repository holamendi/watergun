<div class="flex justify-between pb-6">
  <div>
    <h1 class="text-2xl font-bold"><%= app.name %></h1>
    <% if app.github_repo.present? %>
      <span class="text-sm text-conten"><%= app.github_repo.repo %></span>
    <% end %>
    <% if app.deployed? && app.url.present? %>
      <span class="block text-sm text-content link text-accent-content"><%= link_to app.url, app.url, target: :_blank %></span>
    <% end %>
  </div>
  <div class="flex gap-x-2">
    <% if app.github_repo.present?%>
      <%= button_to project_app_deployments_path(current_project, @app),
          class: "btn btn-primary btn-sm rounded-md font-normal text-sm",
          data: { turbo_submits_with: "<span class='loading loading-spinner'></span>Save"} do %>
        Deploy
      <% end %>
    <% end %>
    <% if app.deployed? %>
      <%= button_to "Restart", project_app_restarts_path(current_project, @app), class: "btn btn-primary btn-sm rounded-md font-normal text-sm" %>
    <% end %>
  </div>
</div>
<div role="tablist" class="w-full pb-6 overflow-auto lg:w-2/3 tabs tabs-bordered">
  <%= link_to "Deployments", project_app_path(current_project, @app), class: class_names("tab", "tab-active" => (controller_name == "apps" && action_name  == "show")), role: "tab" %>
  <%= link_to "Metrics", project_app_metrics_path(current_project, @app), class: class_names("tab", "tab-active" => (controller_name == "metrics")), role: "tab" %>
  <%= link_to "Environment", edit_project_app_env_configuration_path(current_project, @app), class: class_names("tab", "tab-active" => (controller_name == "env_configurations")), role: "tab" %>
  <%= link_to "Domains", project_app_domains_path(current_project, @app),class: class_names("tab", "tab-active" => (controller_name == "domains")), role: "tab" %>
  <%= link_to "Settings", edit_project_app_path(current_project, @app), class: class_names("tab", "tab-active" => (controller_name == "apps" && action_name.in?(%w[edit update]))), role: "tab" %>
</div>
