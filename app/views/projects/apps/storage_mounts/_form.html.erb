<%= form_with model: [storage_mount.project, storage_mount.app, storage_mount], class: "space-y-4", id: "storage_mount_form", data: {turbo_frame: "storage_mount_form"} do |form| %>
  <fieldset class="fieldset">
    <legend class="fieldset-legend">Container path</legend>
    <%= form.text_field :container_path, class: "input w-full", placeholder: "/app/uploads" %>
    <%= error_messages_for(form.object, :container_path) %>
  </fieldset>
  <fieldset class="fieldset">
    <legend class="fieldset-legend">Directory ownership</legend>
    <%= form.select :chown, [["Builder default", ""], ["Keep Dokku-managed ownership", "false"], ["UID:GID 1000:1000 (Heroku / Nixpacks)", "heroku"], ["UID:GID 32767:32767 (Herokuish)", "herokuish"], ["UID:GID 2000:2000 (Paketo)", "paketo"]], {}, class: "input w-full" %>
    <%= error_messages_for(form.object, :chown) %>
    <p class="text-xs text-text-secondary">For non-root Dockerfile apps, choose the preset matching the image user. Dokku 0.36 supports these presets only, not arbitrary UID:GID. Ownership changes apply recursively to this mount directory.</p>
  </fieldset>
  <p class="text-sm text-warning">Adding storage restarts the app and hides image contents at this path. Existing files are not copied into storage.</p>
  <%= submit_button "Add mount and restart" %>
<% end %>
