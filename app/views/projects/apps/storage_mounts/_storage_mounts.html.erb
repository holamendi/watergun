<%# locals: (project:, app:, storage_mounts:, modal_id:) -%>

<div id="storage_mounts">
  <% if storage_mounts.any? %>
    <div class="card bg-elevated divide-y divide-border">
      <%= render storage_mounts %>
    </div>
  <% else %>
    <%= empty_state(
        title: "No storage mounts configured",
        body: "Add a persistent storage mount to preserve data across deployments."
      ) do %>
      <%= modal_trigger "+ Add Mount", modal_id: modal_id, size: :sm %>
    <% end %>
  <% end %>
</div>
