<% status_label, status_color = {
  "active" => ["Mounted", :green],
  "pending" => ["Mounting", :yellow],
  "deleting" => ["Detaching", :yellow],
  "detaching" => ["Detaching", :yellow],
  "configured" => ["Restart pending", :yellow],
  "detach_configured" => ["Detach pending", :yellow],
  "detached" => ["Retained", :neutral],
  "error" => ["Mount failed", :red],
  "detach_failed" => ["Detach failed", :red]
}.fetch(storage_mount.status) %>
<% ownership = {"heroku" => "UID:GID 1000:1000", "herokuish" => "UID:GID 32767:32767", "paketo" => "UID:GID 2000:2000", "false" => "Dokku-managed"}.fetch(storage_mount.chown, "Unchanged") %>
<% resume_label = if storage_mount.detached? || storage_mount.detach_configured?
  "Reattach"
elsif storage_mount.configured?
  "Apply mount"
elsif storage_mount.detach_failed?
  "Retry detach"
elsif storage_mount.error?
  "Retry mount"
end %>
<% detach_label = if storage_mount.active? || storage_mount.configured? || storage_mount.detach_configured? || storage_mount.error?
  storage_mount.detach_configured? ? "Apply detach" : "Detach (keep data)"
end %>

<div id="<%= dom_id(storage_mount) %>">
  <div class="storage-mount-row">
    <div class="storage-mount-paths">
      <span class="storage-container-path" title="<%= storage_mount.container_path %>"><%= storage_mount.container_path %></span>
      <span class="storage-host-path" title="<%= storage_mount.host_path %>"><%= storage_mount.host_path %></span>
      <span class="storage-ownership"><%= ownership %></span>
    </div>
    <div class="storage-mount-status"><%= badge(status_label, color: status_color) %></div>
    <div class="storage-mount-actions">
      <% if resume_label || detach_label %>
        <%= row_actions(id: dom_id(storage_mount, :actions), label: "Actions for #{storage_mount.container_path}") do %>
            <% if resume_label %>
              <%= modal_trigger resume_label, modal_id: dom_id(storage_mount, :resume_modal), variant: :ghost, class: "storage-menu-action", role: "menuitem", tabindex: -1 %>
            <% end %>
            <% if detach_label %>
              <%= modal_trigger detach_label, modal_id: dom_id(storage_mount, :detach_modal), variant: :ghost, class: "storage-menu-action", role: "menuitem", tabindex: -1 %>
            <% end %>
        <% end %>
      <% end %>
    </div>
  </div>
  <% if resume_label %>
    <%= render "projects/apps/storage_mounts/action_dialog", storage_mount: storage_mount, action: :resume, label: resume_label, method: :patch %>
  <% end %>
  <% if detach_label %>
    <%= render "projects/apps/storage_mounts/action_dialog", storage_mount: storage_mount, action: :detach, label: detach_label, method: :delete %>
  <% end %>
</div>
