<%= turbo_stream_from @app %>
<%= turbo_stream_from @app, :storage_mounts %>

<% modal_id = dom_id(@app, :storage_mount_modal) %>

<%= render "projects/apps/settings/layout", app: @app, active_section: :storage do %>
  <%= page_header(
      title: "Storage",
      subtitle: "#{@storage_mounts.size} #{'mount'.pluralize(@storage_mounts.size)} configured"
    ) do %>
    <%= modal_trigger "+ Add Mount", modal_id: modal_id, size: :sm %>
  <% end %>

  <%= render "storage_mounts",
      project: @project,
      app: @app,
      storage_mounts: @storage_mounts,
      modal_id: modal_id %>
<% end %>

<%= modal(id: modal_id, title: "Add Storage Mount") do %>
  <%= render "projects/apps/storage_mounts/form", storage_mount: @app.storage_mounts.new %>
<% end %>
