<%= turbo_stream_from @app %>
<%= render "projects/apps/header", app: @app %>

<%= form_with model: @env_configuration, url: project_app_env_configuration_path(current_project, @app), class: "space-y-4" do |form| %>
  <%= form.text_area :variables, value: @env_configuration.variables_as_string, class: "textarea rounded-md text-sm textarea-sm textarea-bordered w-full h-96" %>
  <%= form.submit "Save", class: "btn btn-primary btn-sm rounded-md font-normal text-sm" %>
<% end %>
