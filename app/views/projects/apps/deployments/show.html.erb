<%= turbo_stream_from @deployment %>

<%= render "projects/apps/header", app: @app, active_tab: :deployments %>

<div class="page-shell py-6">
  <div class="mb-4">
    <%= back_link "All Deployments", project_app_deployments_path(@project, @app) %>
  </div>

  <div id="<%= dom_id(@deployment, :info) %>">
    <%= render "projects/apps/deployments/deployment_info", deployment: @deployment %>
  </div>

  <div class="section-label">Build Log</div>
  <div class="log-panel">
    <div id="<%= dom_id(@deployment, :logs) %>"
         class="log-panel-content log-panel-content-relaxed max-h-[400px] min-h-[200px] space-y-1 text-text-primary"
         data-controller="auto-scroll">

      <% server_action = @deployment.server_action %>
      <% if server_action&.log&.ssh_commands.present? %>
        <% server_action.log.ssh_commands.each do |cmd| %>
          <div class="mb-4">
            <div class="text-accent font-medium mb-2">$ <%= cmd["cmd"] %></div>
            <% output_text = cmd["output"]&.map { |o| o["data"] }&.join %>
            <% if output_text.present? %>
              <pre class="whitespace-pre-wrap break-words text-text-primary"><%= ansi_to_html(output_text) %></pre>
            <% end %>
            <% if cmd["exit_code"] && cmd["exit_code"] != 0 %>
              <div class="text-error mt-1">Exit code: <%= cmd["exit_code"] %></div>
            <% end %>
          </div>
        <% end %>
      <% elsif @deployment.deploying? || @deployment.pending? %>
        <div class="flex flex-col items-center justify-center py-12 text-text-muted" data-auto-scroll-target="placeholder">
          <svg class="animate-spin h-5 w-5 text-warning mb-2" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          <p>Waiting for logs...</p>
        </div>
      <% elsif @deployment.error? && server_action&.failure_message.present? %>
        <div class="text-error">
          <pre class="whitespace-pre-wrap"><%= server_action.failure_message %></pre>
        </div>
      <% else %>
        <div class="flex items-center justify-center py-12 text-text-muted">
          <p>No logs available for this deployment.</p>
        </div>
      <% end %>
    </div>
  </div>
</div>
