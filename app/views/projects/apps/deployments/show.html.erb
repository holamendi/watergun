<%= turbo_stream_from @deployment %>

<div class="px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto">
  <%= render "projects/apps/header", app: @app, active_tab: :deployments %>

  <%# Back to deployments list %>
  <div class="mb-4">
    <%= link_to project_app_deployments_path(@project, @app), class: "text-sm text-primary hover:underline inline-flex items-center gap-1" do %>
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
      </svg>
      All deployments
    <% end %>
  </div>

  <%# Deployment info card %>
  <div class="card bg-base-200 mb-6">
    <div class="card-body">
      <div class="flex items-center justify-between mb-4">
        <div class="flex items-center gap-3">
          <%= status_dot(@deployment.status, size: :md) %>
          <span class="text-xl font-bold font-mono"><%= @deployment.short_sha %></span>
          <%= status_badge(@deployment.status) %>
        </div>

        <div class="text-sm text-base-content/60">
          <% if @deployment.finished? && @deployment.duration %>
            Completed in <%= distance_of_time_in_words(@deployment.duration) %>
          <% elsif @deployment.deploying? %>
            <span class="flex items-center gap-2">
              <span class="loading loading-spinner loading-xs"></span>
              Deploying...
            </span>
          <% elsif @deployment.pending? %>
            <span class="flex items-center gap-2">
              <span class="loading loading-spinner loading-xs"></span>
              Pending...
            </span>
          <% end %>
        </div>
      </div>

      <% if @deployment.commit_message.present? %>
        <p class="text-base-content/80 mb-3"><%= @deployment.commit_message.lines.first&.strip %></p>
      <% end %>

      <div class="flex flex-wrap items-center gap-4 text-sm text-base-content/60">
        <% if @deployment.author_login.present? %>
          <div class="flex items-center gap-2">
            <% if @deployment.author_avatar_url.present? %>
              <img src="<%= @deployment.author_avatar_url %>" alt="<%= @deployment.author_login %>" class="w-5 h-5 rounded-full">
            <% end %>
            <% if @deployment.author_url.present? %>
              <%= link_to @deployment.author_login, @deployment.author_url, target: :_blank, class: "hover:text-primary" %>
            <% else %>
              <%= @deployment.author_login %>
            <% end %>
          </div>
        <% end %>

        <% if @deployment.commit_html_url.present? %>
          <%= link_to @deployment.commit_html_url, target: :_blank, class: "hover:text-primary inline-flex items-center gap-1" do %>
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
            </svg>
            View commit
          <% end %>
        <% end %>

        <% if @deployment.started_at %>
          <span>Started <%= time_ago_in_words(@deployment.started_at) %> ago</span>
        <% elsif @deployment.created_at %>
          <span>Created <%= time_ago_in_words(@deployment.created_at) %> ago</span>
        <% end %>
      </div>
    </div>
  </div>

  <%# Build logs %>
  <div class="card bg-base-300 overflow-hidden">
    <div class="px-4 py-3 border-b border-base-content/10 flex items-center justify-between">
      <h2 class="text-sm font-medium">Build Logs</h2>
      <% if @deployment.deploying? %>
        <span class="text-xs text-base-content/60 flex items-center gap-1">
          <span class="loading loading-spinner loading-xs"></span>
          Live
        </span>
      <% end %>
    </div>

    <div id="<%= dom_id(@deployment, :logs) %>"
         class="p-4 bg-[#1e1e2e] text-[#cdd6f4] font-mono text-xs overflow-auto max-h-[600px] min-h-[200px]"
         data-controller="deployment-logs"
         data-deployment-logs-target="container">

      <% server_action = @deployment.server_action %>
      <% if server_action&.log&.ssh_commands.present? %>
        <% server_action.log.ssh_commands.each do |cmd| %>
          <div class="mb-4">
            <div class="text-[#89b4fa] mb-1">$ <%= cmd["cmd"] %></div>
            <% output_text = cmd["output"]&.map { |o| o["data"] }&.join %>
            <% if output_text.present? %>
              <pre class="whitespace-pre-wrap break-words"><%= ansi_to_html(output_text) %></pre>
            <% end %>
            <% if cmd["exit_code"] && cmd["exit_code"] != 0 %>
              <div class="text-[#f38ba8] mt-1">Exit code: <%= cmd["exit_code"] %></div>
            <% end %>
          </div>
        <% end %>
      <% elsif @deployment.deploying? || @deployment.pending? %>
        <div class="flex flex-col items-center justify-center py-12 text-base-content/40" data-deployment-logs-target="placeholder">
          <span class="loading loading-spinner loading-md mb-2"></span>
          <p>Waiting for logs...</p>
        </div>
      <% elsif @deployment.error? && server_action&.failure_message.present? %>
        <div class="text-[#f38ba8]">
          <pre class="whitespace-pre-wrap"><%= server_action.failure_message %></pre>
        </div>
      <% else %>
        <div class="flex items-center justify-center py-12 text-base-content/40">
          <p>No logs available for this deployment.</p>
        </div>
      <% end %>

      <div data-deployment-logs-target="scrollAnchor"></div>
    </div>
  </div>
</div>
