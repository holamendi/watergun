<div class="page-header">
  <div>
    <h1 class="page-title">Deploy #<%= deployment.id %></h1>
    <% if deployment.commit_message.present? %>
      <div class="page-header-sub"><%= deployment.commit_message.lines.first&.strip %></div>
    <% end %>
  </div>
  <%= status_badge(deployment.status) %>
</div>

<div class="deploy-info-grid">
  <div class="deploy-info-item">
    <div class="deploy-info-label">Commit</div>
    <div class="deploy-info-value mono text-accent">
      <% if deployment.commit_html_url.present? %>
        <%= link_to deployment.short_sha, deployment.commit_html_url, target: :_blank, class: "hover:underline" %>
      <% else %>
        <%= deployment.short_sha %>
      <% end %>
    </div>
  </div>
  <% if deployment.author_login.present? %>
    <div class="deploy-info-item">
      <div class="deploy-info-label">Author</div>
      <div class="deploy-info-value">
        <% if deployment.author_url.present? %>
          <%= link_to deployment.author_login, deployment.author_url, target: :_blank, class: "hover:text-accent" %>
        <% else %>
          <%= deployment.author_login %>
        <% end %>
      </div>
    </div>
  <% end %>
  <% if deployment.finished? && deployment.duration %>
    <div class="deploy-info-item">
      <div class="deploy-info-label">Duration</div>
      <div class="deploy-info-value"><%= distance_of_time_in_words(deployment.duration) %></div>
    </div>
  <% end %>
  <div class="deploy-info-item">
    <div class="deploy-info-label">Status</div>
    <div class="deploy-info-value flex items-center gap-2">
      <% if deployment.deploying? || deployment.pending? %>
        <svg class="animate-spin h-3 w-3 text-warning" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
      <% end %>
      <%= deployment.status.to_s.titleize %>
    </div>
  </div>
  <div class="deploy-info-item">
    <div class="deploy-info-label">Created</div>
    <div class="deploy-info-value">
      <% if deployment.created_at %>
        <%= time_ago_in_words(deployment.created_at) %> ago
      <% end %>
    </div>
  </div>
</div>
