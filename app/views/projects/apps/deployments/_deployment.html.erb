<tr id="<%= dom_id(deployment) %>">
  <td>
    <div class="tooltip tooltip-secondary font-space-grotesk" data-tip="<%= deployment.commit_message %> (<%= deployment.author_login %>)">
      <%= link_to deployment.short_sha, deployment.commit_html_url, target: :_blank, class: "link"  %>
    </div>
  </td>
  <td>
    <% if deployment.finished? %>
      <div class="tooltip" data-tip="<%= deployment.finished_at.to_s %>">
        <%= time_ago_in_words(deployment.finished_at) %> ago
      </div>
    <% end %>
  </td>
  <td>
    <% if deployment.finished?%>
      <%= deployment.duration.round %> seconds
    <% end %>
  </td>
  <td>
    <span class="badge <%= status_badge_class(deployment.status) %> badge-outline"><%= deployment.status %></span>
  </td>
</tr>
