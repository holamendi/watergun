<div id="<%= dom_id(deployment) %>" class="bg-base-200 first:rounded-t-box last:rounded-b-box p-4 hover:bg-base-300/50 transition-colors">
  <div class="flex items-start gap-4">
    <%# Author avatar %>
    <% if deployment.author_avatar_url.present? %>
      <div class="flex-shrink-0">
        <img src="<%= deployment.author_avatar_url %>" alt="<%= deployment.author_login %>" class="w-8 h-8 rounded-full" title="<%= deployment.author_login %>">
      </div>
    <% end %>

    <%# Main content %>
    <div class="flex-1 min-w-0">
      <div class="flex items-center justify-between gap-2">
        <div class="flex items-center gap-2 min-w-0">
          <%= link_to deployment.commit_html_url, target: "_blank", rel: "noopener noreferrer", class: "font-mono text-sm font-semibold hover:underline" do %>
            <%= deployment.short_sha %>
          <% end %>
          <%= status_badge(deployment.status) %>
        </div>
        <span class="text-xs text-base-content/50 flex-shrink-0">
          <% if deployment.finished? %>
            <time title="<%= deployment.finished_at %>" datetime="<%= deployment.finished_at.iso8601 %>">
              <%= time_ago_in_words(deployment.finished_at) %> ago
            </time>
          <% elsif deployment.deploying? || deployment.pending? %>
            <span class="inline-flex items-center gap-1">
              <span class="loading loading-spinner loading-xs"></span>
              In progress
            </span>
          <% end %>
        </span>
      </div>
      <% if deployment.commit_message.present? %>
        <p class="text-sm text-base-content/70 mt-1 truncate"><%= deployment.commit_message.lines.first.strip %></p>
      <% end %>
    </div>
  </div>
</div>
