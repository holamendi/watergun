<li id="<%= dom_id(deployment) %>" class="px-4 py-5 hover:bg-gray-50 sm:px-6">
  <div class="flex items-center gap-x-3">
    <% if deployment.author_avatar_url.present? %>
      <img src="<%= deployment.author_avatar_url %>" alt="" class="flex-none w-6 h-6 bg-gray-800 rounded-full">
    <% else %>
      <div class="flex-none w-6 h-6 bg-gray-800 rounded-full"></div>
    <% end %>
    <%= link_to deployment.short_sha, deployment.commit_html_url, class: "flex-auto text-sm font-semibold leading-6 text-gray-900 truncate hover:underline" %>
    <% case deployment.status %>
    <% when "success" %>
      <span class="inline-flex items-center px-2 py-1 text-xs font-medium text-green-700 rounded-md bg-green-50 ring-1 ring-inset ring-green-600/20">Success</span>
    <% when "error" %>
      <span class="inline-flex items-center px-2 py-1 text-xs font-medium text-red-700 rounded-md bg-red-50 ring-1 ring-inset ring-red-600/20">Error</span>
    <% when "deploying" %>
      <span class="inline-flex items-center px-2 py-1 text-xs font-medium text-blue-700 rounded-md bg-blue-50 ring-1 ring-inset ring-blue-600/20">
        <svg class="-ml-1 mr-1.5 size-2 text-blue-500 animate-spin" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        Deploying
      </span>
    <% else %>
      <span class="inline-flex items-center px-2 py-1 text-xs font-medium text-gray-700 rounded-md bg-gray-50 ring-1 ring-inset ring-gray-600/20">Pending</span>
    <% end %>
    <% if deployment.finished?%>
      <time title="<%= deployment.finished_at.to_s %>" datetime="<%= deployment.finished_at.to_s %>" class="flex-none text-sm text-gray-500">Deployed <%= time_ago_in_words(deployment.finished_at) %> ago</time>
    <% end %>
  </div>
  <p class="mt-3 text-sm text-gray-500 truncate"><%= deployment.commit_message.lines.first %></p>
</li>
