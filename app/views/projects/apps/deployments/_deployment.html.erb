<li id="<%= dom_id(deployment) %>" class="py-4">
  <div class="flex items-center gap-x-3">
    <img src="<%= deployment.author_avatar_url %>" alt="" class="flex-none w-6 h-6 bg-gray-800 rounded-full">
    <%= link_to deployment.short_sha, deployment.commit_html_url, class: "flex-auto text-sm font-semibold leading-6 text-gray-900 truncate hover:underline" %>
    <% if deployment.finished?%>
      <time title="<%= deployment.finished_at.to_s %>" datetime="<%= deployment.finished_at.to_s %>" class="flex-none text-xs text-gray-500">Deployed <%= time_ago_in_words(deployment.finished_at) %> ago</time>
    <% else %>
      <div class="flex-none p-1 rounded-full bg-emerald-500/20 animate-pulse">
        <div class="h-1.5 w-1.5 rounded-full bg-emerald-500"></div>
      </div>
      <span class="flex-none text-xs text-gray-500"><%= deployment.status.titleize %></span>
    <% end %>
  </div>

  <p class="mt-3 text-sm text-gray-500 truncate"><%= deployment.commit_message %></p>
</li>
