<%= turbo_stream_from @app, :deployments %>

<%= render "projects/apps/header", app: @app, active_tab: :deployments %>

<div class="page-shell py-6">
  <% if @app.github_repo.present? %>
    <%= page_header(
        title: "Deployments",
        subtitle: "#{@deployments.size} total #{'deployment'.pluralize(@deployments.size)}"
      ) do %>
      <% unless @app.temporary_status? %>
        <%= form_with url: project_app_deployments_path(@app.project, @app), data: { turbo_stream: true } do %>
          <%= submit_button "Deploy Now", size: :sm %>
        <% end %>
      <% end %>
    <% end %>

    <% if @deployments.any? %>
      <div id="deployments" class="resource-list">
        <%= render @deployments %>
      </div>
    <% else %>
      <%= empty_state(title: "No deployments yet", body: "Click Deploy Now to get started.") %>
    <% end %>
  <% else %>
    <%= empty_state(
        title: "Connect a GitHub repository",
        body: "Link a repository to enable deployments."
      ) do %>
      <%= button "Connect Repository",
          href: new_project_app_github_repo_path(@project, @app),
          size: :sm %>
    <% end %>
  <% end %>
</div>
