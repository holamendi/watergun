<% content_for :header do %>
  <%= render "projects/apps/header", app: @app %>
  <%= render "projects/apps/tabs", app: @app %>
<% end %>
<div class="flex justify-between pb-6">
  <div>
    <%= link_to "New Variable", new_project_app_env_variable_path(@project, @app), class: "btn btn-ghost link font-normal", data: { turbo_frame: "new_env_variable" } %>
  </div>
</div>
<div class="flex flex-col w-full space-y-2">
  <%= turbo_frame_tag "new_env_variable", target: "_top" %>
</div>
<table class="min-w-full divide-y divide-gray-300">
  <thead>
    <tr>
      <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 sm:pl-0">Key</th>
      <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Value</th>
      <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-0">
        <span class="sr-only">Edit</span>
      </th>
    </tr>
  </thead>
  <tbody class="divide-y divide-gray-200">
    <%= render @env_variables %>
  </tbody>
</table>
