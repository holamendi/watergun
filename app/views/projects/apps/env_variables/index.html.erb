<%= render "projects/apps/settings/layout", app: @app, active_section: :variables do %>
  <div>
    <%= page_header(
        title: "Environment Variables",
        subtitle: "#{@env_variables.size} #{'variable'.pluralize(@env_variables.size)} configured"
      ) do %>
      <%= config_action "+ Add Variable",
          href: new_project_app_env_variable_path(@project, @app),
          data: { turbo_frame: "env_variable_form" } %>
    <% end %>

    <%= render "env_variables", project: @project, app: @app, env_variables: @env_variables %>
  </div>
<% end %>

<%= modal(id: "env_var_modal", title: "Add Variable", frame: "env_variable_form") do %>
  <%= render "form", env_variable: @app.env_variables.new %>
<% end %>
