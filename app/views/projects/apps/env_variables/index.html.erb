<%= turbo_stream_from @app %>
<%= render "projects/apps/header", app: @app %>
<%= render "projects/apps/tabs", app: @app %>

<div class="flex justify-between pb-6">
  <div>
    <%= link_to "New Variable", new_project_app_env_variable_path(@project, @app), class: "btn btn-ghost link font-normal", data: { turbo_frame: "new_env_variable" } %>
  </div>
</div>

<div class="flex flex-col w-full space-y-2">
  <%= turbo_frame_tag "new_env_variable", target: "_top" %>
  <%= render @env_variables %>
</div>
