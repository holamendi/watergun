<%= form_with model: [current_project, current_app, env_variable], class: "flex flex-row px-4 py-2 border rounded-md" do |form| %>
  <div class="w-1/4">
    <% if form.object.new_record?%>
      <%= form.text_field :name, class: "input input-bordered input-sm", placeholder: "NAME" %>
      <%= error_messages_for(form.object, :name) %>
    <% else %>
      <%= env_variable.name %>
    <% end %>
  </div>
  <div class="w-2/4">
    <div class="flex space-x-2">
      <div>
        <%= form.text_field :value, class: "input input-bordered input-sm", placeholder: "Value" %>
        <%= error_messages_for(form.object, :value) %>
      </div>
    </div>
  </div>
  <div class="w-1/4 text-right">
    <%= button_tag type: "submit", class: "btn btn-primary no-animation btn-sm", data: { turbo_submits_with: "<span class='loading loading-spinner'></span>Save" } do %>
      Save
    <% end %>
  </div>
<% end %>
