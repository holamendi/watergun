<%= form_with model: [@project, @app, env_variable], class: "flex flex-row px-4 py-2" do |form| %>
  <div class="w-1/4 truncate">
    <% if form.object.new_record?%>
      <%= form.text_field :name, class: "input input-bordered input-sm", placeholder: "NAME", autofocus: true %>
      <%= error_messages_for(form.object, :name) %>
    <% else %>
      <%= env_variable.name %>
    <% end %>
  </div>
  <div class="w-2/4">
    <div class="flex space-x-2">
      <div>
        <%= form.text_field :value, class: "input input-bordered input-sm", placeholder: "Value", autofocus: form.object.persisted? %>
        <%= error_messages_for(form.object, :value) %>
      </div>
    </div>
  </div>
  <div class="w-1/4 text-right">
    <%= component "submit_button", text: "Save" %>
  </div>
<% end %>
