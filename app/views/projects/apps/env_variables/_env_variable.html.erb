<%= turbo_frame_tag env_variable do %>
  <div class="flex flex-row px-2 pt-3 space-x-4 border rounded-md">
    <div class="w-1/3">
      <%= env_variable.name %>
      <% if env_variable.syncing? %>
        <span class='loading loading-spinner'></span>
      <% end %>
    </div>
    <div class="w-2/3 overflow-auto group">
      <span class="group-hover:hidden">*******</span>
      <span class="hidden group-hover:inline-block"><%= env_variable.value %></span>
    </div>
    <div class="text-right">
      <div class="dropdown dropdown-bottom dropdown-end">
        <div tabindex="0" role="button" class="btn btn-ghost btn-sm">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.2" stroke="currentColor" class="size-6">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 12a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0ZM12.75 12a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0ZM18.75 12a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z" />
          </svg>
        </div>
        <ul tabindex="0" class="dropdown-content z-[1] menu p-2 shadow bg-base-100 rounded-box w-52">
          <li>
            <%= link_to "Edit", edit_project_app_env_variable_path(current_project, current_app, env_variable) %>
          </li>
          <li>
            <%= link_to "Delete", project_app_env_variable_path(current_project, current_app, env_variable), class: "text-red-500", data: { turbo_method: :delete, turbo_confirm: "Sure? "} %>
          </li>
        </ul>
      </div>
    </div>
  </div>
<% end %>
