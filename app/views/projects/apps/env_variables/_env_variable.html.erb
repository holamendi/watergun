<%= turbo_frame_tag env_variable, class: "py-2 sm:flex" do %>
  <dt class="font-medium sm:w-64 sm:flex-none sm:pr-6">
    <div class="truncate" title="<%= env_variable.name %>">
      <%= env_variable.name %>
    </div>
  </dt>
  <dd class="flex justify-between mt-1 gap-x-6 sm:mt-0 sm:flex-auto">
    <div class="truncate max-w-[400px]" title="<%= env_variable.value %>">
      <%= env_variable.value %>
    </div>
    <div class="flex-shrink-0">
      <%= link_to "Edit",
        edit_project_app_env_variable_path(@project, @app, env_variable),
        class: "link link-primary font-semibold" %>
      <%= link_to "Delete",
        project_app_env_variable_path(@project, @app, env_variable),
        class: "link link-error font-semibold ml-4",
        data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this environment variable?" } %>
    </div>
  </dd>
<% end %>
