<div id="<%= dom_id(env_variable) %>" class="flex items-center justify-between" style="padding: 10px 16px;"
     data-controller="secret-field clipboard"
     data-secret-field-value-value="<%= env_variable.value %>"
     data-clipboard-text-value="<%= env_variable.value %>">
  <div class="flex items-center flex-1 min-w-0" style="gap: 12px;">
    <span class="shrink-0 rounded-full <%= env_variable_dot_color(env_variable.status) %>" style="width: 6px; height: 6px;"></span>
    <code class="font-mono font-medium text-text-primary shrink-0" style="font-size: 12px; min-width: 160px;"><%= env_variable.name %></code>
    <code class="font-mono text-text-muted truncate" style="font-size: 11px;" data-secret-field-target="display">••••••••</code>
  </div>
  <div class="flex items-center shrink-0" style="gap: 2px; margin-left: 12px;">
    <button type="button" class="inline-flex items-center justify-center text-text-muted hover:text-text-primary transition-colors rounded cursor-pointer" style="width: 28px; height: 28px; padding: 6px; background: transparent; border: none;" data-action="secret-field#toggle" title="Reveal">
      <svg data-secret-field-target="iconHidden" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" />
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
      </svg>
      <svg data-secret-field-target="iconRevealed" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="hidden">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 0 0 1.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.451 10.451 0 0 1 12 4.5c4.756 0 8.773 3.162 10.065 7.498a10.522 10.522 0 0 1-4.293 5.774M6.228 6.228 3 3m3.228 3.228 3.65 3.65m7.894 7.894L21 21m-3.228-3.228-3.65-3.65m0 0a3 3 0 1 0-4.243-4.243m4.242 4.242L9.88 9.88" />
      </svg>
    </button>
    <button type="button" class="inline-flex items-center justify-center text-text-muted hover:text-text-primary transition-colors rounded cursor-pointer" style="width: 28px; height: 28px; padding: 6px; background: transparent; border: none;" data-action="clipboard#copy" data-clipboard-target="icon" title="Copy value">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 17.25v3.375c0 .621-.504 1.125-1.125 1.125h-9.75a1.125 1.125 0 0 1-1.125-1.125V7.875c0-.621.504-1.125 1.125-1.125H6.75a9.06 9.06 0 0 1 1.5.124m7.5 10.376h3.375c.621 0 1.125-.504 1.125-1.125V11.25c0-4.46-3.243-8.161-7.5-8.876a9.06 9.06 0 0 0-1.5-.124H9.375c-.621 0-1.125.504-1.125 1.125v3.5m7.5 10.375H9.375a1.125 1.125 0 0 1-1.125-1.125v-9.25m12 6.625v-1.875a3.375 3.375 0 0 0-3.375-3.375h-1.5a1.125 1.125 0 0 1-1.125-1.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H9.75" />
      </svg>
    </button>
    <%= link_to edit_project_app_env_variable_path(@project, @app, env_variable),
        class: "inline-flex items-center justify-center text-text-muted hover:text-text-primary transition-colors rounded",
        style: "width: 28px; height: 28px; padding: 6px; background: transparent; border: none;",
        title: "Edit",
        data: { turbo_frame: "env_variable_form" } do %>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" />
      </svg>
    <% end %>
    <%= link_to project_app_env_variable_path(@project, @app, env_variable),
        class: "inline-flex items-center justify-center text-error hover:text-error transition-colors rounded",
        style: "width: 28px; height: 28px; padding: 6px; background: transparent; border: none;",
        title: "Delete",
        data: { turbo_method: :delete, turbo_confirm: "Delete #{env_variable.name}?" } do %>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
      </svg>
    <% end %>
  </div>
</div>
