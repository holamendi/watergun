<div id="<%= dom_id(env_variable) %>" class="flex items-center justify-between px-4 py-2.5"
     data-controller="secret-field clipboard"
     data-secret-field-value-value="<%= env_variable.value %>"
     data-clipboard-text-value="<%= env_variable.value %>">
  <div class="variable-row-content">
    <span class="shrink-0 rounded-full w-1.5 h-1.5 <%= env_variable_dot_color(env_variable.status) %>"></span>
    <code class="font-mono font-medium text-text-primary shrink-0 text-xs variable-row-name"><%= env_variable.name %></code>
    <code class="font-mono text-text-muted truncate text-xxs" data-secret-field-target="display">••••••••</code>
  </div>

  <%= row_actions(id: dom_id(env_variable, :actions), label: "Actions for #{env_variable.name}") do %>
    <%= button "Reveal value", variant: :ghost, role: "menuitem", tabindex: -1, aria: {pressed: false}, data: {action: "secret-field#toggle", secret_field_target: "toggle"} %>
    <%= button "Copy value", variant: :ghost, role: "menuitem", tabindex: -1, data: {action: "clipboard#copy"} %>
    <%= button "Edit Variable", href: edit_project_app_env_variable_path(@project, @app, env_variable), variant: :ghost, role: "menuitem", tabindex: -1, data: {turbo_frame: "env_variable_form"} %>
    <%= button "Delete Variable", href: project_app_env_variable_path(@project, @app, env_variable), variant: :ghost, class: "text-error", role: "menuitem", tabindex: -1, method: :delete, data: {turbo_confirm: "Delete #{env_variable.name}?"} %>
  <% end %>
  <span class="sr-only" role="status" data-clipboard-target="status"></span>
</div>
