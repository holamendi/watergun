<%= turbo_frame_tag env_variable do %>
  <div class="flex flex-row px-4 py-3 space-x-4 border rounded-md group">
    <div class="w-1/4">
      <%= env_variable.name %>
    </div>
    <div class="w-2/4 overflow-auto ">
      <span class="group-hover:hidden">*******</span>
      <span class="hidden group-hover:inline-block"><%= env_variable.value %></span>
    </div>
    <div class="w-1/4 text-right">
      <%= link_to "Edit", edit_project_app_env_variable_path(env_variable.app.project, env_variable.app, env_variable), class: "btn btn-xs btn-ghost" %>
      <%= link_to "Delete", project_app_env_variable_path(env_variable.app.project, env_variable.app, env_variable), class: "btn btn-xs btn-ghost text-error", data: { turbo_method: :delete, turbo_confirm: "Sure? "} %>
    </div>
  </div>
<% end %>
