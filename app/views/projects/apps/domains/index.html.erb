<%= turbo_stream_from @app %>
<%= turbo_stream_from @app, :domains %>

<%= render "projects/apps/settings/layout", app: @app, active_section: :domains do %>
  <div class="page-header">
    <div>
      <h1 style="font-size: 16px; font-weight: 600;">Domains</h1>
      <div class="page-header-sub"><%= @domains.size %> <%= "domain".pluralize(@domains.size) %> configured</div>
    </div>
    <button onclick="domain_modal.showModal()" class="btn btn-primary btn-sm">
      + Add Domain
    </button>
  </div>

  <% if @domains.any? %>
    <div class="card bg-elevated divide-y divide-border">
      <div id="domains">
        <%= render @domains %>
      </div>
    </div>
  <% else %>
    <div class="bg-surface rounded border border-border p-12 text-center">
      <svg class="mx-auto h-12 w-12 text-text-muted" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 0 1 3 12c0-1.605.42-3.113 1.157-4.418" />
      </svg>
      <h3 class="mt-4 text-lg font-medium">No domains configured</h3>
      <p class="mt-1 text-sm text-text-secondary">Add a custom domain to access your app.</p>
    </div>
  <% end %>
<% end %>

<%= render "shared/modal", id: "domain_modal", title: "Add Domain" do %>
  <%= render "projects/apps/domains/form", domain: @app.domains.new %>
<% end %>
