<%= turbo_stream_from @app %>
<%= turbo_stream_from @app, :domains %>

<% modal_id = dom_id(@app, :domain_modal) %>

<%= render "projects/apps/settings/layout", app: @app, active_section: :domains do %>
  <%= ui_page_header(
      title: "Domains",
      subtitle: "#{@domains.size} #{'domain'.pluralize(@domains.size)} configured"
    ) do %>
    <%= ui_modal_trigger "+ Add Domain", modal_id: modal_id, size: :sm %>
  <% end %>

  <%= render "domains", project: @project, app: @app, domains: @domains, modal_id: modal_id %>
<% end %>

<%= render "shared/modal", id: modal_id, title: "Add Domain" do %>
  <%= render "projects/apps/domains/form", domain: @app.domains.new %>
<% end %>
