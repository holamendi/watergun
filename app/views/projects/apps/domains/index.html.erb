<%= turbo_stream_from @app %>
<%= turbo_stream_from @app, :domains %>

<div class="p-6">
  <div class="flex justify-between pb-6">
    <h1 class="text-xl font-bold">Domains</h1>
    <div>
      <%= button_tag "Add Domain", class: "btn btn-primary btn-sm", onclick: "domain_modal.showModal()" %>
    </div>
  </div>

  <div class="card bg-base-100 shadow-sm">
    <div class="overflow-x-auto">
      <table class="table">
        <thead>
          <tr>
            <th>Domain</th>
            <th>Status</th>
            <th>SSL</th>
            <th></th>
          </tr>
        </thead>
        <tbody id="domains">
          <%= render @domains %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%= render "shared/modal", id: "domain_modal", title: "New Domain" do %>
  <%= render "projects/apps/domains/form", domain: @app.domains.new %>
<% end %>
