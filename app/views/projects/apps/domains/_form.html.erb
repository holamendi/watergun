<%= form_with model: [domain.project, domain.app, domain], class: "space-y-4", id: "domain_form", data: {turbo_frame: "domain_form"} do |form| %>
  <fieldset class="fieldset">
    <legend class="fieldset-legend">Hostname</legend>
    <%= form.text_field :hostname, class: "input w-full", placeholder: "example.com", pattern: "^([a-zA-Z0-9]([-a-zA-Z0-9]{0,61}[a-zA-Z0-9])?\.)+[a-zA-Z]{2,}$" %>
    <%= error_messages_for(form.object, :hostname) %>
  </fieldset>
  <%= config_modal_footer submit: "Save domain" %>
<% end %>
