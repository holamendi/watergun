<%# locals: (project:, app:, domains:, modal_id:) -%>

<div id="domains">
  <% if domains.any? %>
    <div class="card bg-elevated divide-y divide-border">
      <%= render partial: "projects/apps/domains/domain", collection: domains %>
    </div>
  <% else %>
    <%= ui_empty_state(
        title: "No domains configured",
        body: "Add a custom domain to access your app."
      ) do %>
      <%= ui_modal_trigger "+ Add Domain", modal_id: modal_id, size: :sm %>
    <% end %>
  <% end %>
</div>
