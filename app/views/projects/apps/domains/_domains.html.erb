<%= turbo_stream_from app, :domains %>

<div id="domains" class="space-y-4">
  <div class="flex justify-end">
    <button onclick="domain_modal_<%= app.id %>.showModal()" class="btn btn-sm btn-ghost">
      Add Domain
    </button>
  </div>

  <% domains = app.domains.select(&:kept?) %>
  <% if domains.any? %>
    <div class="card bg-base-200 divide-y divide-base-300">
      <%= render partial: "projects/apps/domains/domain", collection: domains %>
    </div>
  <% else %>
    <p class="text-base-content/60 text-sm">No domains configured</p>
  <% end %>
</div>

<%= render "shared/modal", id: "domain_modal_#{app.id}", title: "Add Domain" do %>
  <%= render "projects/apps/domains/form", domain: app.domains.new %>
<% end %>
