<%= turbo_stream_from app, :domains %>

<div id="domains">
  <div class="flex justify-end mb-4">
    <button class="w-32 btn btn-primary btn-outline" onclick="domain_modal.showModal()">+ Domain</button>
  </div>
  <table class="table">
    <thead>
      <tr>
        <th>Domain</th>
        <th>Status</th>
        <th></th>
      </tr>
    </thead>
    <tbody id="domains">
      <%= render partial: "projects/apps/domains/domain", collection: app.domains.kept %>
    </tbody>
  </table>
  <%= render "shared/modal", id: "domain_modal", title: "New domain" do %>
    <%= render "projects/apps/domains/form", domain: app.domains.new %>
  <% end %>
</div>
