<%= turbo_stream_from app, :domains %>
<div id="domains">
  <table class="table">
    <thead>
      <tr>
        <th>Domain</th>
        <th>Status</th>
        <th>Role</th>
        <th>
          <span class="sr-only">Edit</span>
        </th>
      </tr>
    </thead>
    <tbody>
      <%= render partial: "projects/apps/domains/domain", collection: app.domains.kept %>
    </tbody>
  </table>
</div>
