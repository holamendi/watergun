<%= form_with model: [service, database], class: "space-y-4" do |form| %>
  <div class="form-control">
    <%= form.label :service_type, "Type", class: "label" %>
    <%= form.select :service_type, Service.service_types.keys, {}, class: "select select-bordered select-sm px-2 text-sm rounded-md", disabled: form.object.persisted? %>
  </div>
  <div class="form-control">
    <%= form.label :name, class: "label" %>
    <%= form.text_field :name, class: "input input-sm px-2 text-sm rounded-md input-bordered" %>
  </div>
  <%= button_tag type: "submit",
                 class: "btn btn-primary no-animation",
                 data: { turbo_submits_with: "<span class='loading loading-spinner'></span>" } do %>
    Save
  <% end %>
  <a class="btn btn-ghost" onclick="github_repo_modal.close()">Cancel</a>
<% end %>
