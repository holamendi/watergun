<%= form_with model: create_app, scope: :create_app, url: project_apps_path(create_app.project), method: :post do |form| %>
  <div class="grid max-w-2xl grid-cols-1 gap-x-6 gap-y-6 sm:grid-cols-6 md:col-span-2">
    <div class="sm:col-span-3">
      <fieldset class="fieldset">
        <legend class="fieldset-legend">Repository</legend>
        <%= form.text_field :repo, class: "input w-full", placeholder: "owner/repo" %>
        <%= error_messages_for(create_app, :repo) %>
      </fieldset>
    </div>
    <div class="sm:col-span-3">
      <fieldset class="fieldset">
        <legend class="fieldset-legend">Branch</legend>
        <%= form.text_field :branch, class: "input w-full", placeholder: "main" %>
        <%= error_messages_for(create_app, :branch) %>
      </fieldset>
    </div>
    <div class="sm:col-span-full">
      <label class="flex items-start gap-3 cursor-pointer">
        <%= form.check_box :webhook_deploy, class: "checkbox checkbox-primary mt-1" %>
        <div>
          <span class="font-medium">Deploy on Push</span>
          <p class="text-sm text-base-content/60">Automatically deploy the app when a push is made to the specified branch.</p>
        </div>
      </label>
      <%= error_messages_for(create_app, :webhook_deploy) %>
    </div>
  </div>
  <div class="flex items-center mt-8 gap-x-6">
    <%= link_to "Cancel", project_path(create_app.project), class: "btn btn-ghost" %>
    <%= submit_button "Create app" %>
  </div>
<% end %>
