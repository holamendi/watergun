<%= link_to project_app_deployments_path(app.project, app),
    class: "resource-item",
    id: dom_id(app) do %>
  <div class="resource-item-left">
    <div>
      <div class="resource-name"><%= app.name %></div>
      <div class="resource-meta">
        <% if app.github_repo.present? %>
          <%= app.github_repo.repo %> · <%= app.github_repo.branch %>
        <% end %>
      </div>
    </div>
  </div>
  <div class="resource-item-right">
    <%= status_badge(app.status) %>
    <span class="arrow-icon">›</span>
  </div>
<% end %>
