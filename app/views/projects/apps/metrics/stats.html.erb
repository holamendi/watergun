<%= turbo_frame_tag :stats do %>
  <div class="w-full mb-4 shadow stats stats-vertical lg:stats-horizontal">
    <div class="stat bg-base-100">
      <div class="stat-title">Running Containers</div>
      <div class="stat-value"><%= @running_containers_count %></div>
    </div>
    <div class="stat bg-base-100">
      <div class="stat-title">CPU Usage</div>
      <div class="stat-value"><%= @total_cpu_usage %>%</div>
    </div>
    <div class="stat bg-base-100">
      <div class="stat-title">RAM Usage</div>
      <div class="stat-value"><%= @total_memory_usage %>%</div>
    </div>
  </div>
<% end %>
