<%= turbo_stream_from @app %>

<%= render "projects/apps/header", project: current_project, app: current_app %>

<%= turbo_frame_tag :stats, src: stats_project_app_metrics_path(current_project, current_app) %>
<%= turbo_frame_tag :cpu_chart, src: cpu_chart_project_app_metrics_path(current_project, current_app) %>
<%= turbo_frame_tag :memory_chart, src: memory_chart_project_app_metrics_path(current_project, current_app) %>
