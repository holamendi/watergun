<%= turbo_stream_from @app, :metrics %>

<%= render "projects/apps/header", app: @app %>

<%= container do %>
  <%= turbo_frame_tag :stats, src: stats_project_app_metrics_path(@project, @app) %>
  <%= turbo_frame_tag :cpu_chart, src: cpu_chart_project_app_metrics_path(@project, @app) %>
  <%= turbo_frame_tag :memory_chart, src: memory_chart_project_app_metrics_path(@project, @app) %>
<% end %>
