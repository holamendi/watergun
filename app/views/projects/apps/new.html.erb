<% @title = "New App" %>

<% content_for :header do %>
  <div class="flex justify-center">
    <div class="w-full max-w-screen-sm mx-auto">
      <h2 class="text-2xl font-bold leading-7 text-gray-900 sm:truncate sm:text-3xl sm:tracking-tight"><%= @title %></h2>
    </div>
  </div>
<% end %>

<div class="max-w-screen-sm mx-auto">
  <% if Current.account.github_integration.app_installed? %>
    <%= render "projects/apps/create_form", app_creator: @app_creator %>
  <% else %>
    <%= button_to "Connect Github account", github_installation_path, class: "btn btn-primary rounded-full", data: { turbo: false } %>
  <% end %>
</div>
