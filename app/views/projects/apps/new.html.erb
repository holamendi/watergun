<% @title = "New App" %>

<div class="p-6">
  <div class="flex justify-center">
    <div class="w-full max-w-lg">
      <%= page_header(@title) %>
      <% if Current.account.github_installation.present? %>
        <%= render "projects/apps/create_form", create_app: @create_app %>
      <% else %>
        <%= button_to "Connect Github account", github_installation_path, class: "btn btn-primary rounded-full", data: { turbo: false } %>
      <% end %>
    </div>
  </div>
</div>
