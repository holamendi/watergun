<% @title = "New App" %>

<div class="page-shell py-6">
  <div class="max-w-2xl">
    <div class="page-header">
      <h1 class="page-title">New App</h1>
    </div>

    <% if Current.account.github_installation.present? %>
      <%= form_with model: @create_app, scope: :create_app, url: project_apps_path(@project), method: :post do |form| %>
        <div class="settings-sections">
          <div class="settings-section">
            <h3 class="settings-section-title">Repository</h3>
            <div class="max-w-xl">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <fieldset class="fieldset">
                  <legend class="fieldset-legend">Repository</legend>
                  <%= form.text_field :repo,
                      class: "input w-full font-mono",
                      placeholder: "owner/repo",
                      autocomplete: "off" %>
                </fieldset>
                <fieldset class="fieldset">
                  <legend class="fieldset-legend">Branch</legend>
                  <%= form.text_field :branch,
                      class: "input w-full font-mono",
                      placeholder: "main",
                      autocomplete: "off" %>
                </fieldset>
              </div>
              <% if @create_app.errors.any? %>
                <div class="text-error text-xs mt-3">
                  <%= @create_app.errors.full_messages.join(", ") %>
                </div>
              <% end %>
            </div>
          </div>

          <div class="settings-section settings-section-last">
            <h3 class="settings-section-title">Deployment</h3>
            <label class="flex items-start gap-3 cursor-pointer">
              <%= form.check_box :webhook_deploy, class: "checkbox mt-1" %>
              <div>
                <span class="text-xs font-medium">Deploy automatically on push</span>
                <p class="text-xs text-text-muted mt-0.5">Automatically deploy the app when code is pushed to the branch.</p>
              </div>
            </label>
          </div>
        </div>

        <div class="flex justify-end gap-3 mt-6">
          <%= button "Cancel", href: project_path(@project), variant: :secondary, size: :sm %>
          <%= submit_button "Create App" %>
        </div>
      <% end %>
    <% else %>
      <div class="text-center py-12">
        <svg class="mx-auto w-12 h-12 text-text-muted" fill="currentColor" viewBox="0 0 24 24">
          <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
        </svg>
        <p class="text-text-secondary mt-2">Connect GitHub to deploy apps from your repositories.</p>
        <%= button "Connect GitHub", href: account_path, size: :sm %>
      </div>
    <% end %>
  </div>
</div>
