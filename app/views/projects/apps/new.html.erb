<% @title = "New App" %>

<div class="px-4 sm:px-6 lg:px-8 max-w-lg mx-auto py-12">
  <div class="text-center mb-8">
    <h1 class="text-2xl font-semibold">Deploy from GitHub</h1>
    <p class="text-base-content/60 mt-2">Connect a repository to deploy your app.</p>
  </div>

  <% if Current.account.github_installation.present? %>
    <%= form_with model: @create_app, scope: :create_app, url: project_apps_path(@project), method: :post, class: "space-y-4" do |form| %>
      <div class="grid grid-cols-3 gap-3">
        <div class="col-span-2">
          <%= form.text_field :repo,
              class: "input w-full font-mono",
              placeholder: "owner/repo",
              autocomplete: "off" %>
        </div>
        <div>
          <%= form.text_field :branch,
              class: "input w-full font-mono",
              placeholder: "main",
              autocomplete: "off" %>
        </div>
      </div>
      <% if @create_app.errors.any? %>
        <div class="text-error text-sm">
          <%= @create_app.errors.full_messages.join(", ") %>
        </div>
      <% end %>

      <label class="flex items-center gap-3 cursor-pointer py-2">
        <%= form.check_box :webhook_deploy, class: "toggle toggle-primary toggle-sm" %>
        <span class="text-sm">Deploy automatically on push</span>
      </label>

      <div class="flex justify-center gap-3 pt-4">
        <%= link_to "Cancel", project_path(@project), class: "btn btn-ghost" %>
        <%= form.submit "Create App", class: "btn btn-primary" %>
      </div>
    <% end %>
  <% else %>
    <div class="card bg-base-200">
      <div class="card-body items-center text-center">
        <svg class="w-12 h-12 text-base-content/40" fill="currentColor" viewBox="0 0 24 24">
          <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
        </svg>
        <p class="text-base-content/60 mt-2">Connect GitHub to deploy apps from your repositories.</p>
        <%= button_to "Connect GitHub", github_installation_path, class: "btn btn-primary mt-4", data: { turbo: false } %>
      </div>
    </div>
  <% end %>
</div>
