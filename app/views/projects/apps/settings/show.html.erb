<% @title = "#{@app.name} · Settings" %>

<%= render "layout", app: @app, active_section: :general do %>
  <div class="settings-sections">
    <div class="settings-section" id="general">
      <h3 class="settings-section-title">App Name</h3>
      <%= render "projects/apps/form", app: @app %>
    </div>

    <div class="settings-section" id="repository">
      <h3 class="settings-section-title">Repository</h3>
      <% if @app.github_repo.present? %>
        <%= render "projects/apps/github_repos/form", github_repo: @app.github_repo %>
      <% else %>
        <p class="text-xs text-text-muted">Repositories are selected when creating an app.</p>
        <%= button "Create App", href: new_project_app_path(@project), size: :sm %>
      <% end %>
    </div>

    <div class="settings-section" id="builder">
      <h3 class="settings-section-title">Builder</h3>
      <%= render "projects/apps/builders/form", app: @app %>
    </div>

    <div class="settings-section settings-section-last" id="danger-zone">
      <div class="section-label text-error">Danger Zone</div>
      <%= danger_zone(
          title: "Delete Application",
          description: "Once you delete this application, there is no going back. This will permanently remove the app, its deployments, domains, and environment variables from the server."
        ) do %>
        <%= config_action "Delete Application",
            href: project_app_path(@project, @app),
            method: :delete,
            variant: :danger,
            data: { turbo_confirm: "Delete #{@app.name}? This cannot be undone." } %>
      <% end %>
    </div>
  </div>
<% end %>
