<% @title = "#{@app.name} · Settings" %>

<%= render "layout", app: @app, active_section: :general do %>
  <div class="space-y-6">
    <div class="form-card" id="general">
      <div class="card-header">
        <span class="card-title">App Name</span>
      </div>
      <div class="card-body">
        <%= render "projects/apps/form", app: @app %>
      </div>
    </div>

    <div class="form-card" id="repository">
      <div class="card-header">
        <span class="card-title">Repository</span>
      </div>
      <div class="card-body">
        <%= render "projects/apps/github_repos/form", github_repo: @app.github_repo || @app.build_github_repo %>
      </div>
    </div>

    <div class="form-card" id="builder">
      <div class="card-header">
        <span class="card-title">Builder</span>
      </div>
      <div class="card-body">
        <%= render "projects/apps/builders/form", app: @app %>
      </div>
    </div>

    <div id="danger-zone">
      <div class="section-label text-error">Danger Zone</div>
      <%= ui_danger_zone(
          title: "Delete Application",
          description: "Once you delete this application, there is no going back. This will permanently remove the app, its deployments, domains, and environment variables from the server."
        ) do %>
        <%= ui_button "Delete Application",
            href: project_app_path(@project, @app),
            method: :delete,
            variant: :danger,
            size: :sm,
            data: { turbo_confirm: "Delete #{@app.name}? This cannot be undone." } %>
      <% end %>
    </div>
  </div>
<% end %>
