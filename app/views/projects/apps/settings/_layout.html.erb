<%= render "projects/apps/header", app: app, active_tab: :settings %>

<div class="page-shell settings-page">
  <div class="settings-layout">
    <aside>
      <nav class="settings-nav" aria-label="Settings navigation">
        <%= link_to "General", project_app_settings_path(app.project, app),
            class: class_names("settings-nav-item",
              "settings-nav-item-active": active_section == :general,
              "settings-nav-item-inactive": active_section != :general),
            aria: { current: (active_section == :general ? "page" : nil) } %>
        <%= link_to "Variables", project_app_env_variables_path(app.project, app),
            class: class_names("settings-nav-item",
              "settings-nav-item-active": active_section == :variables,
              "settings-nav-item-inactive": active_section != :variables),
            aria: { current: (active_section == :variables ? "page" : nil) } %>
        <%= link_to "Domains", project_app_domains_path(app.project, app),
            class: class_names("settings-nav-item",
              "settings-nav-item-active": active_section == :domains,
              "settings-nav-item-inactive": active_section != :domains),
            aria: { current: (active_section == :domains ? "page" : nil) } %>
        <%= link_to "Storage", project_app_storage_mounts_path(app.project, app),
            class: class_names("settings-nav-item",
              "settings-nav-item-active": active_section == :storage,
              "settings-nav-item-inactive": active_section != :storage),
            aria: { current: (active_section == :storage ? "page" : nil) } %>
      </nav>
    </aside>

    <div class="min-w-0">
      <%= yield %>
    </div>
  </div>
</div>
