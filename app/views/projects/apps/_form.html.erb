<%= form_with model: [app.project, app], class: "config-settings-form", id: "app_form" do |form| %>
  <fieldset class="fieldset">
    <legend class="fieldset-legend">App name</legend>
    <%= form.text_field :name, class: "input w-full font-mono" %>
    <%= error_messages_for app, :name %>
  </fieldset>
  <div class="config-form-footer">
    <%= config_action "Save", type: :submit %>
  </div>
<% end %>
