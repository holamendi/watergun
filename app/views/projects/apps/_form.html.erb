<%= form_with model: [app.project, app],  id: "app_form" do |form| %>
  <div class="grid max-w-2xl grid-cols-1 gap-x-6 gap-y-6 sm:grid-cols-6 md:col-span-2">
    <div class="sm:col-span-6">
      <%= form.label :name, class: "block text-sm font-medium leading-6 text-gray-900" %>
      <div class="mt-2">
        <%= form.text_field :name, class: "block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
        <%= error_messages_for app, :name %>
      </div>
    </div>
    <div class="sm:col-span-6" data-controller="clipboard">
      <%= form.label :dokku_id, "Dokku App ID", class: "block text-sm font-medium leading-6 text-gray-900" %>
      <div class="relative mt-2">
        <%= form.text_field :dokku_id,
                            class: "opacity-50 bg-gray-200 cursor-not-allowed block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-gray-600 sm:text-sm sm:leading-6 pr-10",
                            disabled: true,
                            data: { clipboard_target: "source" } %>
        <button type="button"
                class="absolute inset-y-0 right-0 flex items-center px-3 copy-button"
                data-action="clipboard#copy">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5" data-clipboard-target="icon">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0013.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 01-.75.75H9a.75.75 0 01-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 01-2.25 2.25H6.75A2.25 2.25 0 014.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 011.927-.184" />
          </svg>
        </button>
      </div>
    </div>
  </div>
  <div class="flex items-center mt-6 gap-x-6">
    <%= submit_button "Save" %>
  </div>
<% end %>
