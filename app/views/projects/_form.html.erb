<%= form_with(model: project, class: "space-y-4") do |form| %>
  <fieldset class="fieldset">
    <legend class="fieldset-legend">Project name</legend>
    <%= form.text_field :name, class: "input w-full", placeholder: "my-awesome-project", autofocus: true %>
    <%= error_messages_for(project, :name) %>
  </fieldset>
  <div class="flex justify-end gap-2 pt-2">
    <%= link_to "Cancel", projects_path, class: "btn btn-ghost" %>
    <%= submit_button "Create project" %>
  </div>
<% end %>
