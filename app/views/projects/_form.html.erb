<%= form_with model: project, class: "space-y-5" do |f| %>
  <% if project.errors.any? %>
    <div class="bg-error/10 border border-error/20 rounded p-4">
      <ul class="text-error text-sm space-y-1">
        <% project.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, class: "block text-xs font-medium text-text-secondary mb-1.5" %>
    <%= f.text_field :name,
        class: "w-full px-3 py-2 bg-base border border-border rounded text-sm font-mono placeholder:text-text-muted focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20 transition-all",
        placeholder: "my-project" %>
    <p class="text-xxs text-text-muted mt-1.5">A short identifier for your project</p>
  </div>

  <div class="flex justify-end gap-2 pt-2">
    <%= link_to "Cancel", projects_path, class: "px-4 py-2 text-xs text-text-secondary hover:text-text-primary rounded" %>
    <%= submit_button "Create Project" %>
  </div>
<% end %>
