<h1 class="pb-6 text-2xl font-bold">New project</h1>

<%= form_with model: @project, class: "space-y-4" do |form| %>
  <%= form.label :name, class: "form-control" do %>
    <div class="label"><span class="label-text">Name</span></div>
    <%= form.text_field :name, class: "input input-bordered w-full" %>
    <%= error_messages_for(form.object, :name) %>
  <% end %>
  <%= form.submit "Save", class: "btn btn-primary" %>
<% end %>

