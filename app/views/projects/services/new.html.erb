<% @title = "New Service" %>

<div class="page-shell py-6">
  <div class="max-w-2xl">
    <div class="page-header">
      <h1 class="page-title">New Service</h1>
    </div>

    <%= form_with model: @create_service, scope: :create_service, url: project_services_path(@project), method: :post do |form| %>
      <div class="settings-sections">
        <div class="settings-section settings-section-last">
          <h3 class="settings-section-title">Service Type</h3>
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
            <%
              services = {
                postgres: { name: "PostgreSQL", desc: "Relational database" },
                redis: { name: "Redis", desc: "In-memory cache" },
                mysql: { name: "MySQL", desc: "Relational database" },
                mariadb: { name: "MariaDB", desc: "MySQL fork" },
                mongo: { name: "MongoDB", desc: "Document database" },
                memcached: { name: "Memcached", desc: "Memory cache" },
                elasticsearch: { name: "Elasticsearch", desc: "Search engine" },
                rabbitmq: { name: "RabbitMQ", desc: "Message queue" },
                clickhouse: { name: "ClickHouse", desc: "Analytics database" },
                meilisearch: { name: "Meilisearch", desc: "Search engine" }
              }
            %>
            <% services.each do |key, info| %>
              <label class="cursor-pointer">
                <%= form.radio_button :service_type, key, class: "hidden peer" %>
                <div class="bg-surface rounded-xl border-2 border-border p-4 peer-checked:border-accent peer-checked:bg-accent/5 hover:bg-elevated/30 transition-colors">
                  <div class="font-mono text-sm font-medium text-text-primary"><%= info[:name] %></div>
                  <div class="text-xxs text-text-muted"><%= info[:desc] %></div>
                </div>
              </label>
            <% end %>
          </div>

          <% if @create_service.errors.any? %>
            <div class="text-error text-xs mt-4">
              <%= @create_service.errors.full_messages.join(", ") %>
            </div>
          <% end %>
        </div>
      </div>

      <div class="flex justify-end gap-3 mt-6">
        <%= button "Cancel", href: project_path(@project), variant: :secondary, size: :sm %>
        <%= submit_button "Create Service" %>
      </div>
    <% end %>
  </div>
</div>
