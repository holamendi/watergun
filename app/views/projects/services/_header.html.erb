<div id="<%= dom_id(service, :header) %>">
  <div class="flex justify-between pb-6">
    <div>
      <h1 class="pb-2 text-3xl font-bold">
        <%= service.name %>
        <% if service.temporary_status? %>
          <span class="text-sm font-normal text-success">
            <%= service.status %>
            <span class="loading loading-spinner loading-xs"></span>
          </span>
        <% end %>
      </h1>
    </div>
    <div class="flex gap-x-2">
      <%# actions %>
    </div>
  </div>
  <div role="tablist" class="w-full pb-6 overflow-auto md:w-1/2 lg:overflow-hidden tabs tabs-lifted">
    <%= link_to "Metrics", project_service_metrics_path(service.project, service), class: class_names("tab", "tab-active" => (controller_name == "metrics")), role: "tab" %>
    <%= link_to "Logs", project_service_log_streams_path(service.project, service), class: class_names("tab", "tab-active" => (controller_name == "log_streams")), data: { turbo_prefetch: false}, role: "tab" %>
    <%= link_to "Settings", edit_project_service_path(service.project, service), class: class_names("tab", "tab-active" => (controller_name == "apps" && action_name.in?(%w[edit update]))), role: "tab"  %>
  </div>
</div>
