<%= turbo_stream_from service %>
<% @title = service.name %>
<% active_tab ||= nil %>

<div class="app-tabs-wrapper">
  <div class="app-tabs">
    <nav class="scrollable-tabs flex items-center gap-0 -mb-px overflow-x-auto" aria-label="Service navigation">
      <%= link_to "Overview", project_service_path(service.project, service),
          class: class_names("app-tab",
            "app-tab-active": active_tab == :overview,
            "app-tab-inactive": active_tab != :overview),
          aria: { current: (active_tab == :overview ? "page" : nil) } %>
      <%= link_to "Metrics", project_service_metrics_path(service.project, service),
          class: class_names("app-tab",
            "app-tab-active": active_tab == :metrics,
            "app-tab-inactive": active_tab != :metrics),
          aria: { current: (active_tab == :metrics ? "page" : nil) } %>
      <%= link_to "Logs", project_service_log_streams_path(service.project, service),
          class: class_names("app-tab",
            "app-tab-active": active_tab == :logs,
            "app-tab-inactive": active_tab != :logs),
          aria: { current: (active_tab == :logs ? "page" : nil) },
          data: { turbo_prefetch: false } %>
      <%= link_to "Settings", edit_project_service_path(service.project, service),
          class: class_names("app-tab",
            "app-tab-active": active_tab == :edit,
            "app-tab-inactive": active_tab != :edit),
          aria: { current: (active_tab == :edit ? "page" : nil) } %>
    </nav>

    <div class="flex items-center shrink-0">
      <span class="text-xxs text-text-muted">
        <span class="w-1.5 h-1.5 rounded-full bg-success inline-block mr-1"></span>
        <%= service.service_type.to_s.titleize %> · <%= service.version.presence || "latest" %>
      </span>
    </div>
  </div>
</div>
