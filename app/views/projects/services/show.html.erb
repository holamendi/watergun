<div class="px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto">
  <%= render "projects/services/header", service: @service, active_tab: :metrics %>

  <%# Linked Apps %>
  <% if @linked_apps.any? %>
    <section class="mb-8">
      <h2 class="text-sm font-medium text-base-content/60 uppercase tracking-wide mb-3">Linked Apps</h2>
      <div class="card bg-base-200 divide-y divide-base-300">
        <% @linked_apps.each do |app| %>
          <div class="p-4 flex items-center justify-between">
            <div class="flex items-center gap-2">
              <%= status_dot(app.status) %>
              <%= link_to app.name, project_app_deployments_path(@project, app), class: "font-mono hover:text-primary" %>
            </div>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>

  <%# Connection info %>
  <% if @service.dsn.present? %>
    <section>
      <h2 class="text-sm font-medium text-base-content/60 uppercase tracking-wide mb-3">Connection</h2>
      <div class="card bg-base-200 p-4" data-controller="clipboard">
        <div class="flex items-center justify-between gap-4">
          <code class="text-sm font-mono break-all" data-clipboard-target="source"><%= @service.dsn %></code>
          <button type="button" class="btn btn-ghost btn-sm btn-square shrink-0" data-action="clipboard#copy" title="Copy">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" data-clipboard-target="icon">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0 0 13.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 0 1-.75.75H9a.75.75 0 0 1-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 0 1-2.25 2.25H6.75A2.25 2.25 0 0 1 4.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 0 1 1.927-.184" />
            </svg>
          </button>
        </div>
      </div>
    </section>
  <% end %>
</div>
