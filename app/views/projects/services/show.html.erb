<div class="px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto">
  <%= render "projects/services/header", service: @service, active_tab: :overview %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <%# Left column: Status %>
    <div class="card bg-base-200 p-4">
      <h2 class="text-sm font-medium text-base-content/60 uppercase tracking-wide mb-3">Status</h2>

      <% container = @service.containers.find(&:running?) %>
      <% if container %>
        <div class="flex items-center gap-2 mb-3">
          <span class="status status-success status-sm"></span>
          <span class="font-medium">Running</span>
        </div>
        <% if container.cpu_percentage.present? %>
          <div class="text-sm text-base-content/60">
            <%= number_to_percentage(container.cpu_percentage, precision: 1) %> CPU · <%= number_to_human_size(container.memory_used_bytes || 0) %>
          </div>
        <% end %>
      <% else %>
        <div class="flex items-center gap-2">
          <span class="status status-error status-sm"></span>
          <span class="font-medium">Not running</span>
        </div>
      <% end %>

      <% if @service.dsn.present? %>
        <div class="mt-4 pt-4 border-t border-base-300">
          <button type="button" class="btn btn-ghost btn-sm gap-2" data-controller="clipboard" data-clipboard-text="<%= @service.dsn %>" data-action="clipboard#copy">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0 0 13.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 0 1-.75.75H9a.75.75 0 0 1-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 0 1-2.25 2.25H6.75A2.25 2.25 0 0 1 4.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 0 1 1.927-.184" />
            </svg>
            Copy DSN
          </button>
        </div>
      <% end %>
    </div>

    <%# Right column: Linked Apps %>
    <div class="card bg-base-200 p-4">
      <h2 class="text-sm font-medium text-base-content/60 uppercase tracking-wide mb-3">Linked Apps</h2>

      <% if @linked_apps.any? %>
        <div class="divide-y divide-base-300 -mx-4">
          <% @linked_apps.each do |app| %>
            <div class="px-4 py-2 flex items-center gap-2">
              <%= status_dot(app.status) %>
              <%= link_to app.name, project_app_path(@project, app), class: "font-mono hover:text-primary" %>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="text-base-content/60 text-sm">
          No apps linked to this service.
        </div>
      <% end %>
    </div>
  </div>
</div>
