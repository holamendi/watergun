<%= render "projects/services/header", service: @service, active_tab: :overview %>

<div class="page-shell py-6">
  <%= page_header(
      title: @service.name,
      subtitle: "#{@service.service_type.to_s.titleize} service"
    ) %>

  <% container = @service.containers.find(&:running?) %>
  <div class="service-info-grid">
    <div class="service-info-card">
      <div class="service-info-label">Status</div>
      <div>
        <% if container %>
          <%= status_badge(:running) %>
        <% else %>
          <%= status_badge(:error) %>
        <% end %>
      </div>
    </div>
    <div class="service-info-card">
      <div class="service-info-label">Type</div>
      <div class="service-info-value"><%= @service.service_type.to_s.titleize %></div>
    </div>
    <div class="service-info-card">
      <div class="service-info-label">Version</div>
      <div class="service-info-value mono"><%= @service.version.presence || "latest" %></div>
    </div>
    <div class="service-info-card">
      <div class="service-info-label">Linked Apps</div>
      <div class="service-info-value"><%= @linked_apps.size %></div>
    </div>
  </div>

  <% if @service.dsn.present? %>
    <div class="section-label">Connection String</div>
    <div class="dsn-box">
      <span class="overflow-hidden text-ellipsis"><%= @service.dsn %></span>
      <%= button nil,
          variant: :secondary,
          size: :xs,
          type: :button,
          data: {
            controller: "clipboard",
            clipboard_text: @service.dsn,
            action: "clipboard#copy"
          } do %>
        <span data-clipboard-target="icon">Copy</span>
      <% end %>
    </div>
  <% end %>

  <div class="flex items-center justify-between mb-3">
    <div class="section-label mb-0">Linked Apps</div>
  </div>

  <% if @linked_apps.any? %>
    <div class="linked-apps-list">
      <% @linked_apps.each do |app| %>
        <div class="linked-app-item">
          <div>
            <div class="linked-app-name"><%= app.name %></div>
          </div>
          <%= button "View",
              href: project_app_deployments_path(@project, app),
              variant: :ghost,
              size: :xs %>
        </div>
      <% end %>
    </div>
  <% else %>
    <%= empty_state(title: "No apps linked to this service.") %>
  <% end %>
</div>
