<%= turbo_stream_from @service %>

<div class="p-6">
  <div class="divide-y divide-base-300">
    <div class="grid grid-cols-1 gap-x-8 gap-y-8 pb-10 md:grid-cols-3">
      <div>
        <h2 class="text-base font-semibold leading-7">General</h2>
      </div>
      <div class="md:col-span-2">
        <%= render "form", service: @service %>
      </div>
    </div>
    <div class="grid grid-cols-1 pt-10 gap-x-8 gap-y-8 md:grid-cols-3">
      <div>
        <h2 class="text-base font-semibold leading-7">Delete Service</h2>
      </div>
      <div class="md:col-span-2">
        <%= button_to "Delete Service", project_service_path(@project, @service), method: :delete, class: "btn btn-error", data: { turbo_confirm: "Sure?"} %>
      </div>
    </div>
  </div>
</div>
