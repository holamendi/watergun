<%= render "projects/services/header", service: @service, active_tab: :edit %>

<div class="page-shell py-6">
  <div class="max-w-2xl space-y-12">
    <section>
      <h2 class="text-xs font-medium text-text-muted uppercase tracking-wider mb-4">General</h2>
      <%= render "form", service: @service %>
    </section>

    <% if @service.dsn.present? %>
      <section>
        <h2 class="text-xs font-medium text-text-muted uppercase tracking-wider mb-4">Connection</h2>
        <div class="bg-surface rounded-xl border border-border p-4"
             data-controller="clipboard"
             data-clipboard-text-value="<%= @service.dsn %>">
          <div class="flex items-center justify-between gap-4">
            <code class="font-mono text-xs text-text-secondary break-all flex-1"><%= @service.dsn %></code>
            <%= icon_button(label: "Copy connection string", size: :sm, data: { action: "clipboard#copy" }) do %>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" data-clipboard-target="icon">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0 0 13.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 0 1-.75.75H9a.75.75 0 0 1-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 0 1-2.25 2.25H6.75A2.25 2.25 0 0 1 4.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 0 1 1.927-.184" />
              </svg>
            <% end %>
          </div>
        </div>
      </section>
    <% end %>

    <section class="pt-8 border-t border-border">
      <%= danger_zone(
          title: "Delete service",
          description: "Deleting this service will permanently remove it and all its data."
        ) do %>
        <%= button "Delete service",
            href: project_service_path(@project, @service),
            method: :delete,
            variant: :danger,
            size: :sm,
            data: { turbo_confirm: "Delete #{@service.name}? This cannot be undone." } %>
      <% end %>
    </section>
  </div>
</div>
