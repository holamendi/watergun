<%= turbo_stream_from @service %>
<% @title = "#{@service.name} · Settings" %>

<div class="px-4 sm:px-6 lg:px-8 max-w-2xl mx-auto">
  <div class="mb-8">
    <%= link_to project_service_path(@project, @service), class: "text-sm text-base-content/60 hover:text-base-content inline-flex items-center gap-1" do %>
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
      </svg>
      <%= @service.name %>
    <% end %>
    <h1 class="text-2xl font-semibold mt-1">Settings</h1>
  </div>

  <div class="space-y-12">
    <section>
      <h2 class="text-sm font-medium text-base-content/60 uppercase tracking-wide mb-4">General</h2>
      <%= render "form", service: @service %>
    </section>

    <% if @service.dsn.present? %>
      <section>
        <h2 class="text-sm font-medium text-base-content/60 uppercase tracking-wide mb-4">Connection</h2>
        <div class="bg-base-200 rounded-lg p-4" data-controller="clipboard">
          <div class="flex items-center justify-between gap-4">
            <code class="font-mono text-sm break-all flex-1" data-clipboard-target="source"><%= @service.dsn %></code>
            <button type="button" class="btn btn-ghost btn-sm btn-square shrink-0" data-action="clipboard#copy" title="Copy">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" data-clipboard-target="icon">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0 0 13.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 0 1-.75.75H9a.75.75 0 0 1-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 0 1-2.25 2.25H6.75A2.25 2.25 0 0 1 4.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 0 1 1.927-.184" />
              </svg>
            </button>
          </div>
        </div>
      </section>
    <% end %>

    <section class="pt-8 border-t border-base-300">
      <h2 class="text-lg font-medium text-error">Danger zone</h2>
      <p class="text-sm text-base-content/60 mt-2">
        Deleting this service will permanently remove it and all its data.
      </p>
      <%= button_to "Delete service", project_service_path(@project, @service),
          method: :delete,
          class: "btn btn-error btn-outline mt-4",
          data: { turbo_confirm: "Delete #{@service.name}? This cannot be undone." } %>
    </section>
  </div>
</div>
