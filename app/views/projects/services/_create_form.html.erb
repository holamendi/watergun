<%= form_with model: create_service, scope: :create_service, url: project_services_path(create_service.project), method: :post, id: "service_form" do |form| %>
  <div class="grid max-w-2xl grid-cols-1 gap-x-6 gap-y-6 sm:grid-cols-6 md:col-span-2">
    <div class="sm:col-span-6">
      <fieldset class="fieldset">
        <legend class="fieldset-legend">Service Type</legend>
        <%= form.select :service_type, Service.service_types.keys.map { |key| [key.titleize, key] }, {}, class: "select w-full" %>
        <%= error_messages_for create_service, :service_type %>
      </fieldset>
    </div>
    <div class="flex items-center mt-8 gap-x-6">
      <%= link_to "Cancel", project_path(create_service.project), class: "btn btn-ghost" %>
      <%= submit_button "Save" %>
    </div>
  </div>
<% end %>
