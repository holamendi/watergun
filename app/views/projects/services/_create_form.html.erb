<%= form_with model: service_creator, url: project_services_path(service_creator.project), method: :post, id: "service_form" do |form| %>
  <div class="grid max-w-2xl grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-6 md:col-span-2">
    <div class="sm:col-span-6">
      <%= form.label :service_type, class: "block text-sm font-medium leading-6 text-gray-900" %>
      <div class="mt-2">
        <%= form.select :service_type, Service.service_types.keys.map { |key| [key.titleize, key] }, {}, class: "block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
        <%= error_messages_for service_creator, :service_type %>
      </div>
    </div>
    <div class="flex items-center mt-8 gap-x-6">
      <%= link_to "Cancel", project_path(service_creator.project), class: "text-sm font-semibold leading-6 text-gray-900" %>
      <%= submit_button "Save" %>
    </div>
  </div>
<% end %>
