<%= turbo_stream_from current_service, :metrics %>

<%= render "projects/services/header", service: current_service %>

<%= turbo_frame_tag :stats, src: stats_project_service_metrics_path(current_project, current_service) %>
<%= turbo_frame_tag :cpu_chart, src: cpu_chart_project_service_metrics_path(current_project, current_service) %>
<%= turbo_frame_tag :memory_chart, src: memory_chart_project_service_metrics_path(current_project, current_service) %>
