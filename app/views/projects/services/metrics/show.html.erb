<%= turbo_stream_from @service, :metrics %>

<%= render "projects/services/header", service: @service %>
<%= render "projects/services/tabs", service: @service %>

<%= container do %>
  <%= turbo_frame_tag :stats, src: stats_project_service_metrics_path(@project, @service) %>
  <%= turbo_frame_tag :cpu_chart, src: cpu_chart_project_service_metrics_path(@project, @service) %>
  <%= turbo_frame_tag :memory_chart, src: memory_chart_project_service_metrics_path(@project, @service) %>
<% end %>
