<li id="<%= dom_id(service) %>" class="relative flex justify-between px-4 py-5 gap-x-6 hover:bg-base-200 sm:px-6">
  <div class="flex min-w-0 gap-x-4">
    <div class="flex-auto min-w-0">
      <p class="text-sm font-semibold leading-6">
        <%= link_to project_service_path(service.project, service) do %>
          <span class="absolute inset-x-0 bottom-0 -top-px"></span>
          <%= service.name %>
        <% end %>
      </p>
      <p class="flex mt-1 text-sm leading-5 text-base-content/60">
        <%= service.service_type.titleize %> Database
      </p>
    </div>
  </div>
  <div class="flex items-center shrink-0 gap-x-4">
    <div class="hidden sm:flex sm:flex-col sm:items-end">
      <% if service.pending? %>
        <div class="mt-1 flex items-center gap-x-1.5">
          <%= spinner %>
          <p class="text-sm leading-5 text-base-content/60">Initializing</p>
        </div>
      <% elsif service.active? %>
        <div class="mt-1 flex items-center gap-x-1.5">
          <div class="flex-none p-1 rounded-full bg-success/20">
            <div class="h-1.5 w-1.5 rounded-full bg-success"></div>
          </div>
          <p class="text-sm leading-5 text-base-content/60">Active</p>
        </div>
      <% end %>
    </div>
    <svg class="flex-none w-5 h-5 text-base-content/40" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
      <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" />
    </svg>
  </div>
</li>
