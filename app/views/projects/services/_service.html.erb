<%= link_to project_service_path(service.project, service),
    class: "resource-item",
    id: dom_id(service) do %>
  <div class="resource-item-left">
    <div>
      <div class="resource-name"><%= service.name %></div>
      <div class="resource-meta"><%= service.service_type.to_s.titleize %><%= " · #{service.version}" if service.version.present? %></div>
    </div>
  </div>
  <div class="resource-item-right">
    <%= status_badge(service.status) %>
    <span class="arrow-icon">›</span>
  </div>
<% end %>
