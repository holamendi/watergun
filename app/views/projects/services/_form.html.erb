<%= form_with model: [service.project, service], id: dom_id(service, :form) do |form| %>
  <div class="flex gap-4 items-end">
    <fieldset class="fieldset flex-1">
      <legend class="fieldset-legend">Service name</legend>
      <%= form.text_field :name, class: "input w-full font-mono" %>
      <%= error_messages_for service, :name %>
    </fieldset>
    <%= submit_button "Save" %>
  </div>
<% end %>
