<%= form_with model: [service.project, service], id: dom_id(service, :form) do |form| %>
  <div class="flex gap-4 items-end">
    <fieldset class="flex-1">
      <label for="<%= form.field_id(:name) %>" class="block text-xs text-text-muted mb-1.5">Service name</label>
      <%= form.text_field :name, class: "w-full px-3 py-2 bg-base border border-border rounded text-sm text-text-primary font-mono placeholder:text-text-muted focus:outline-none focus:ring-1 focus:ring-accent focus:border-accent" %>
      <%= error_messages_for service, :name %>
    </fieldset>
    <%= form.submit "Save", class: "px-4 py-2 bg-gradient-to-r from-accent to-accent-hover text-white text-xs font-medium rounded-lg shadow shadow-accent/20 cursor-pointer" %>
  </div>
<% end %>
