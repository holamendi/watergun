<%= form_with model: [service.project, service], class: "gap-6 flex flex-col", id: "service_form" do |form| %>
  <%= form.label :name, class: "form-control" do %>
    <div class="label">
      <span class="label-text">Name</span>
    </div>
    <%= form.select :service_type, Service.service_types, {}, class: "select select-bordered", disabled: form.object.persisted? %>
    <%= error_messages_for(service, :service_type) %>
  <% end %>
  <div class="flex justify-end gap-4">
    <%= link_to "Cancel", project_path(service.project), class: "btn" %>
    <%= button_tag "Save", class: "btn btn-primary" %>
  </div>
<% end %>
