<%= form_with model: [service.project, service], class: "space-y-4" do |form| %>
  <div>
    <%= form.label :service_type, "Type", class: "block text-sm font-medium text-gray-700" %>
    <div class="mt-2">
      <%= form.select :service_type, Service.service_types, {}, class: "select select-bordered" %>
    </div>
  </div>
  <%= form.submit "Save", class: "disabled:opacity-50 rounded-md border border-gray-300 bg-white py-2 px-4 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:ring-offset-2" %>
<% end %>
