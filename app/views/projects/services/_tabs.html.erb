<div class="py-3">
  <div class="max-w-5xl px-4 mx-auto lg:px-8 sm:px-6">
    <div role="tablist" class="tabs tabs-bordered">
      <%= tab_link "Metrics", project_service_metrics_path(service.project, service), controller_name == "metrics" %>
      <%= tab_link "Logs", project_service_log_streams_path(service.project, service), controller_name == "log_streams", data: { turbo_prefetch: false } %>
      <%= tab_link "Settings", edit_project_service_path(service.project, service), controller_name == "services" && action_name.in?(%w[edit update]) %>
    </div>
  </div>
</div>
