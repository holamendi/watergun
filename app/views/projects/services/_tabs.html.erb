<% if false %>
<div role="tablist" class="flex w-full mb-12 overflow-auto md:w-2/3 lg:overflow-hidden gap-x-2">
  <%= link_to "Metrics", project_service_metrics_path(service.project, service), class: class_names("bg-base-100 px-4 py-1 rounded-lg", "border border-primary" => (controller_name == "metrics")) %>
  <%= link_to "Logs", project_service_log_streams_path(service.project, service), class: class_names("bg-base-100 px-4 py-1 rounded-lg", "border border-primary" => (controller_name == "log_streams")), data: { turbo_prefetch: false} %>
  <%= link_to "Settings", edit_project_service_path(service.project, service), class: class_names("bg-base-100 px-4 py-1 rounded-lg", "border border-primary" => (controller_name == "services" && action_name.in?(%w[edit update])))  %>
</div>
<% end %>

<div role="tablist" class="px-0 mb-12 overflow-auto lg:overflow-hidden tabs tabs-bordered md:w-1/3">
  <%= link_to "Metrics", project_service_metrics_path(service.project, service), class: class_names("tab", "tab-active" => (controller_name == "metrics")) %>
  <%= link_to "Logs", project_service_log_streams_path(service.project, service), class: class_names("tab", "tab-active" => (controller_name == "log_streams")) %>
  <%= link_to "Settings", edit_project_service_path(service.project, service), class: class_names("tab", "tab-active" => (controller_name == "services" && action_name.in?(%w[edit update])))  %>
</div>
