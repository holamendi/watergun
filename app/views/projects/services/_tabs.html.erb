<div class="pt-4">
  <%= component :tabs, [
    {
      title: "Metrics",
      path: project_service_metrics_path(service.project, service),
      current: controller_name == "metrics"
    },
    {
      title: "Logs",
      path: project_service_log_streams_path(service.project, service),
      current: controller_name == "log_streams",
      prefetch: false
    },
    {
      title: "Settings",
      path: edit_project_service_path(service.project, service),
      current: controller_name == "services" && action_name.in?(%w[edit update])
    }
  ] %>
</div>

