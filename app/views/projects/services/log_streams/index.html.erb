<%= turbo_stream_from @service %>
<%= turbo_stream_from @log_stream %>

<div class="max-w-6xl mx-auto px-4">
  <%= render "projects/services/header", service: @service, active_tab: :logs %>
</div>

<div class="h-[calc(100vh-16rem)] bg-[#303446] rounded-lg mx-4 sm:mx-6 lg:mx-8">
  <%= render "shared/log_streams/log_stream",
      log_stream: @log_stream,
      url: project_service_log_stream_path(@project, @service, @log_stream) %>
</div>
