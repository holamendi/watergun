<% @title = "#{@project.name} · Settings" %>

<div class="max-w-sm mx-auto px-4 py-12">
  <div class="mb-6">
    <%= link_to project_path(@project), class: "text-sm text-text-muted hover:text-text-secondary inline-flex items-center gap-1" do %>
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
      </svg>
      <%= @project.name %>
    <% end %>
  </div>

  <div class="bg-surface rounded-xl border border-border p-6">
    <h1 class="text-lg font-semibold mb-5">Settings</h1>

    <%= form_with model: @project, class: "space-y-5" do |form| %>
      <div>
        <label class="block text-xs font-medium text-text-secondary mb-1.5">Project name</label>
        <%= form.text_field :name,
            class: "w-full px-3 py-2 bg-base border border-border rounded text-sm font-mono focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20 transition-all",
            autocomplete: "off" %>
        <%= error_messages_for(@project, :name) %>
      </div>

      <div class="flex justify-end">
        <%= submit_button "Save" %>
      </div>
    <% end %>

    <section class="pt-6 mt-6 border-t border-border">
      <h2 class="text-sm font-medium text-error">Danger zone</h2>
      <p class="text-xs text-text-muted mt-1">
        Deleting this project will permanently remove all apps, services, and deployment history.
      </p>
      <div class="flex justify-end mt-4">
        <%= button_to "Delete project", project_path(@project),
            method: :delete,
            class: "px-4 py-2 bg-transparent border border-error text-error text-xs rounded hover:bg-error/10 transition-colors",
            data: { turbo_confirm: "Delete #{@project.name}? This cannot be undone." } %>
      </div>
    </section>
  </div>
</div>
