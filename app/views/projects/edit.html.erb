<% @title = "#{@project.name} · Settings" %>

<div class="page-shell py-6">
  <div class="max-w-md mx-auto">
    <div class="mb-4">
      <%= link_to project_path(@project), class: "text-xs text-text-muted hover:text-accent inline-flex items-center gap-1" do %>
        <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
        </svg>
        <%= @project.name %>
      <% end %>
    </div>

    <div class="form-card">
      <div class="form-card-header">
        <h2>Settings</h2>
      </div>
      <div class="form-card-body">
        <%= form_with model: @project, class: "space-y-5" do |form| %>
          <div>
            <label class="block text-xs font-medium text-text-secondary mb-1.5">Project name</label>
            <%= form.text_field :name,
                class: "input w-full font-mono",
                autocomplete: "off" %>
            <%= error_messages_for(@project, :name) %>
          </div>

          <div class="form-card-footer -mx-5 -mb-5 mt-5">
            <%= submit_button "Save" %>
          </div>
        <% end %>
      </div>
    </div>

    <div class="form-card mt-6">
      <div class="form-card-header">
        <h2 class="text-error">Danger zone</h2>
      </div>
      <div class="form-card-body">
        <p class="text-xs text-text-muted">
          Deleting this project will permanently remove all apps, services, and deployment history.
        </p>
        <div class="flex justify-end mt-4">
          <%= button_to "Delete project", project_path(@project),
              method: :delete,
              class: "btn btn-sm bg-transparent border border-error text-error hover:bg-error/10",
              data: { turbo_confirm: "Delete #{@project.name}? This cannot be undone." } %>
        </div>
      </div>
    </div>
  </div>
</div>
