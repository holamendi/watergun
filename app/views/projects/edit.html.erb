<% @title = @project.name %>

<%= container do %>
  <div class="flex justify-center">
    <div class="w-full max-w-lg">
      <%= page_header(@title) %>
    </div>
  </div>
  <div class="flex justify-center">
    <div class="w-full max-w-lg">
      <div class="space-y-10 divide-y divide-base-300">
        <div>
          <%= render "form", project: @project %>
        </div>
        <div class="pt-10">
          <%= button_to "Delete Project", project_path(@project), method: :delete, class: "btn btn-error", data: { turbo_confirm: "Sure?"} %>
        </div>
      </div>
    </div>
  </div>
<% end %>
