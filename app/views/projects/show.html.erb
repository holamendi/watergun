<%= turbo_stream_from @project %>

<%= render PageHeaderComponent.new(title: @project.name) do |component| %>
  <% component.with_actions do %>
    <button class="w-32 btn btn-primary btn-outline" onclick="app_modal.showModal()">+ App</button>
    <button class="w-32 btn btn-primary btn-outline" onclick="service_modal.showModal()">+ Service</button>
  <% end %>
<% end %>

<div id="<%= dom_id(@project) %>" class="grid grid-cols-1 gap-7 lg:grid-cols-3 xl:grid-cols-4">
  <%= render partial: "projects/apps/app", collection: @apps, as: :app %>
  <%= render partial: "projects/services/service", collection: @services, as: :service %>
</div>

<%= render "shared/modal", id: "app_modal", title: "Connect Github Repo" do %>
  <%= render "projects/apps/form", project: @project, app: @app %>
<% end %>

<%= render "shared/modal", id: "service_modal", title: "Add a Database" do %>
  <%= render "projects/services/form", project: @project, service: @service %>
<% end %>
