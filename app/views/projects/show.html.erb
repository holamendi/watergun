<%= turbo_stream_from @project %>

<%= render PageHeaderComponent.new(title: @project.name) do |component| %>
  <% component.with_actions do %>
    <%= link_to "+ App", new_project_app_path(@project), class: "btn text-primary" %>
    <%= link_to "+ Service", new_project_service_path(@project), class: "btn text-primary" %>
  <% end %>
<% end %>

<div id="<%= dom_id(@project) %>" class="grid grid-cols-1 gap-7 lg:grid-cols-3 xl:grid-cols-4">
  <%= render partial: "projects/apps/app", collection: @apps, as: :app %>
  <%= render partial: "projects/services/service", collection: @services, as: :service %>
</div>
