<%= turbo_stream_from @project %>
<% content_for :breadcrumb do %>
  <span class="pl-2 select-none">/</span>
  <span><%= @project.name %></span>
<% end %>
<div class="flex justify-between">
  <h1 class="text-2xl font-bold"><%= @project.name %></h1>
  <% if @apps.any? || @services.any? %>
    <div>
      <button class="font-normal btn btn-sm btn-ghost" onclick="app_modal.showModal()">Add Github Repo</button>
      <button class="font-normal btn btn-sm btn-ghost" onclick="service_modal.showModal()">Add a Database</button>
    </div>
  <% end %>
</div>
<div class="py-6">
  <% if @apps.any? || @services.any? %>
    <table class="table">
      <thead>
        <tr>
          <th>Resource</th>
          <th>Type</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        <% @apps.each do |app| %>
          <tr>
            <td><a href="<%= project_app_path(@project, app) %>" class="link"><%= app.name %></a></td>
            <td>App</td>
            <td>
              <span class="badge <%= status_badge_class(app.status) %>"><%= app.status %></span>
            </td>
          </tr>
        <% end %>
        <% @services.each do |service| %>
          <tr>
            <td><a href="<%= project_service_path(@project, service) %>" class="link"><%= service.name %></a></td>
            <td><%= service.service_type.titleize %> Database</td>
            <td>
              <span class="badge <%= status_badge_class(service.status) %>"><%= service.status %></span>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <div class="flex justify-center py-10">
      <div>
        <button class="text-lg font-normal link btn btn-ghost no-animation" onclick="app_modal.showModal()">Connect a Github Repo</button> or
        <button class="text-lg font-normal link btn btn-ghost no-animation" onclick="service_modal.showModal()">Add a Database</button>
      </div>
    </div>
  <% end %>
</div>

<%= render "shared/modal", id: "app_modal", title: "Connect Github Repo" do %>
  <%= render "projects/apps/form", project: @project, app: @app %>
<% end %>

<%= render "shared/modal", id: "service_modal", title: "Add a Database" do %>
  <%= render "projects/services/form", project: @project, service: @service %>
<% end %>
