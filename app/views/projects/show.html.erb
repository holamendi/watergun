<% content_for :breadcrumb do %>
  <span class="pl-2 select-none">/</span>
  <span><%= @project.name %></span>
<% end %>
<h1 class="text-2xl font-bold">Apps</h1>
<hr>
<div class="py-6">
  <button class="link" onclick="app_modal.showModal()">Connect Github Repo</button>
  <dialog id="app_modal" class="modal">
    <div class="modal-box">
      <h3 class="text-lg font-bold">Connect Github Repo</h3>
      <%= turbo_frame_tag @app do %>
        <%= render "projects/apps/form", project: @project, app: @app %>
      <% end %>
    </div>
  </dialog>
</div>
<table class="table">
  <thead>
    <tr>
      <th>Name</th>
    </tr>
  </thead>
  <tbody>
    <% @apps.select(&:persisted?).each do |app| %>
      <tr>
        <td><%= link_to app.name, project_app_path(@project, app), class: "link" %></td>
      </tr>
    <% end %>
  </tbody>
</table>
<h1 class="mt-6 text-2xl font-bold">Services</h1>
<hr>
<div class="py-6">

</div>
