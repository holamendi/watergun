<%= turbo_stream_from @project %>
<% @title = @project.name %>

<div class="page-shell py-6">
  <div class="page-header">
    <div>
      <h1 class="page-title"><%= @project.name %></h1>
      <div class="page-header-sub"><%= @apps.size %> <%= "app".pluralize(@apps.size) %> · <%= @services.size %> <%= "service".pluralize(@services.size) %></div>
    </div>
    <div class="flex items-center gap-2">
      <div class="action-dropdown">
        <button class="btn btn-primary btn-sm" tabindex="0">+ New</button>
        <div class="action-dropdown-menu">
          <div class="action-dropdown-label">Apps</div>
          <%= link_to "From GitHub repo", new_project_app_path(@project), class: "action-dropdown-item" %>
          <div class="action-dropdown-divider"></div>
          <div class="action-dropdown-label">Services</div>
          <%= link_to "Add a service", new_project_service_path(@project), class: "action-dropdown-item" %>
        </div>
      </div>
      <%= link_to edit_project_path(@project), class: "p-2 text-text-muted hover:text-text-secondary hover:bg-elevated rounded transition-colors", title: "Settings" do %>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.325.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 0 1 1.37.49l1.296 2.247a1.125 1.125 0 0 1-.26 1.431l-1.003.827c-.293.241-.438.613-.43.992a7.723 7.723 0 0 1 0 .255c-.008.378.137.75.43.991l1.004.827c.424.35.534.955.26 1.43l-1.298 2.247a1.125 1.125 0 0 1-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.47 6.47 0 0 1-.22.128c-.331.183-.581.495-.644.869l-.213 1.281c-.09.543-.56.94-1.11.94h-2.594c-.55 0-1.019-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 0 1-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 0 1-1.369-.49l-1.297-2.247a1.125 1.125 0 0 1 .26-1.431l1.004-.827c.292-.24.437-.613.43-.991a6.932 6.932 0 0 1 0-.255c.007-.38-.138-.751-.43-.992l-1.004-.827a1.125 1.125 0 0 1-.26-1.43l1.297-2.247a1.125 1.125 0 0 1 1.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.086.22-.128.332-.183.582-.495.644-.869l.214-1.28Z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
        </svg>
      <% end %>
    </div>
  </div>

  <%# Apps Section %>
  <section class="mb-6">
    <div class="section-label">Apps</div>
    <% if @apps.any? %>
      <div class="resource-list">
        <%= render partial: "projects/apps/app", collection: @apps %>
      </div>
    <% else %>
      <div class="bg-surface rounded-lg border border-border p-6 text-center">
        <p class="text-text-secondary text-sm">No apps yet</p>
      </div>
    <% end %>
  </section>

  <%# Services Section %>
  <section>
    <div class="section-label">Services</div>
    <% if @services.any? %>
      <div class="resource-list">
        <%= render partial: "projects/services/service", collection: @services %>
      </div>
    <% else %>
      <div class="bg-surface rounded-lg border border-border p-6 text-center">
        <p class="text-text-secondary text-sm">No services yet</p>
      </div>
    <% end %>
  </section>
</div>
