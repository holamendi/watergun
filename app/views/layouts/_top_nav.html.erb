<nav class="glass border-b border-border sticky top-0 z-50" aria-label="Main navigation">
  <div class="max-w-7xl mx-auto px-4">
    <div class="flex items-center justify-between h-12">
      <div class="flex items-center gap-4">
        <%= link_to root_path, class: "font-semibold text-base bg-gradient-to-r from-accent to-pink bg-clip-text text-transparent" do %>
          Watergun
        <% end %>

        <%# Project selector dropdown - shown on project pages %>
        <% if @project %>
          <div class="relative group">
            <button class="flex items-center gap-1.5 px-2.5 py-1.5 text-xs text-text-primary bg-elevated hover:bg-border rounded border border-border transition-colors">
              <span class="font-medium"><%= @project.name %></span>
              <svg class="w-3 h-3 text-text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </button>
            <div class="hidden group-hover:block absolute top-full left-0 mt-1 w-48 bg-surface border border-border rounded shadow-lg z-50">
              <div class="py-1">
                <% Current.account.projects.kept.each do |project| %>
                  <%= link_to project_path(project), class: "flex items-center gap-2 px-3 py-2 text-xs hover:bg-elevated" do %>
                    <div class="w-5 h-5 rounded bg-gradient-to-br from-accent to-pink flex items-center justify-center text-white text-xxs font-bold">
                      <%= project.name.first.upcase %>
                    </div>
                    <span class="<%= project == @project ? 'font-medium' : '' %>"><%= project.name %></span>
                    <% if project == @project %>
                      <svg class="w-3 h-3 ml-auto text-accent" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                      </svg>
                    <% end %>
                  <% end %>
                <% end %>
                <div class="border-t border-border my-1"></div>
                <%= link_to projects_path, class: "flex items-center gap-2 px-3 py-2 text-xs text-text-secondary hover:bg-elevated hover:text-text-primary" do %>
                  View all projects
                <% end %>
              </div>
            </div>
          </div>
        <% end %>

        <div class="flex items-center gap-0.5">
          <%= link_to "Activity", server_actions_path,
              class: "px-3 py-1.5 text-xs rounded #{current_page?(server_actions_path) ? 'text-text-primary bg-elevated font-medium' : 'text-text-secondary hover:text-text-primary'}" %>
          <%= link_to "Settings", account_path,
              class: "px-3 py-1.5 text-xs rounded #{current_page?(account_path) ? 'text-text-primary bg-elevated font-medium' : 'text-text-secondary hover:text-text-primary'}" %>
        </div>
      </div>

      <div class="flex items-center gap-2">
        <span class="text-xs text-text-muted hidden sm:inline"><%= Current.user&.email %></span>
        <div class="w-7 h-7 rounded-full bg-gradient-to-br from-accent to-pink" aria-hidden="true"></div>
      </div>
    </div>
  </div>
</nav>
