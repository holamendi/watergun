<nav class="top-nav">
  <div class="top-nav-left">
    <%# Logo %>
    <%= link_to projects_path, class: "top-nav-logo" do %>
      <svg viewBox="132.84 235.85 667.16 328.29" xmlns="http://www.w3.org/2000/svg">
        <path d="M635.86,564.14c-53.14,0-96.37-43.23-96.37-96.37v-135.55c0-21.61-17.58-39.18-39.18-39.18s-39.18,17.58-39.18,39.18v135.55c0,53.13-43.23,96.37-96.37,96.37s-96.37-43.23-96.37-96.37v-135.55c0-21.61-17.57-39.18-39.18-39.18s-39.18,17.58-39.18,39.18v28.59h-57.19v-28.59c0-53.14,43.23-96.37,96.37-96.37s96.37,43.23,96.37,96.37v135.55c0,21.6,17.58,39.18,39.19,39.18s39.18-17.58,39.18-39.18v-135.55c0-53.14,43.23-96.37,96.37-96.37s96.37,43.23,96.37,96.37v135.55c0,21.6,17.57,39.18,39.18,39.18s39.18-17.58,39.18-39.18v-135.55c0-53.14,43.23-96.37,96.36-96.37h28.59v57.19h-28.59c-21.6,0-39.18,17.58-39.18,39.18v135.55c0,53.13-43.23,96.37-96.37,96.37Z"/>
      </svg>
    <% end %>

    <%# Breadcrumb - only show when in a project context %>
    <% if defined?(@project) && @project.present? %>
      <div class="nav-breadcrumb">
        <%# Project dropdown %>
        <div class="nav-dropdown">
          <a class="nav-breadcrumb-item" tabindex="0">
            <span><%= @project.name %></span>
            <svg class="chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
            </svg>
          </a>
          <div class="nav-dropdown-menu">
            <div class="nav-dropdown-label">Projects</div>
            <% @nav_projects.each do |project| %>
              <%= link_to project_path(project), class: "nav-dropdown-item #{project.id == @project.id ? 'active' : ''}" do %>
                <%= project.name %>
              <% end %>
            <% end %>
            <div class="nav-dropdown-divider"></div>
            <%= link_to projects_path, class: "nav-dropdown-item nav-dropdown-item-muted" do %>
              View all projects
            <% end %>
          </div>
        </div>

        <%# App or Service segment %>
        <% if defined?(@app) && @app.present? %>
          <span class="nav-breadcrumb-separator">/</span>
          <%= link_to project_app_path(@project, @app), class: "nav-breadcrumb-item" do %>
            <span><%= @app.name %></span>
          <% end %>
        <% elsif defined?(@service) && @service.present? %>
          <span class="nav-breadcrumb-separator">/</span>
          <%= link_to project_service_path(@project, @service), class: "nav-breadcrumb-item" do %>
            <span><%= @service.name %></span>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="top-nav-right">
    <%# Server selector - only show when multiple servers exist %>
    <% if Current.account&.servers&.count.to_i > 1 %>
      <div class="nav-dropdown nav-server-dropdown">
        <a class="nav-server-selector" tabindex="0">
          <span><%= Current.server&.name %></span>
          <svg class="chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
          </svg>
        </a>
        <div class="nav-dropdown-menu">
          <div class="nav-dropdown-label">Servers</div>
          <% Current.account.servers.each do |server| %>
            <%= link_to select_server_path(server), data: { turbo_method: :post }, class: "nav-dropdown-item #{server.id == Current.server&.id ? 'active' : ''}" do %>
              <%= server.name %>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>

    <%# User avatar dropdown %>
    <div class="nav-dropdown nav-avatar-dropdown">
      <div class="nav-avatar" tabindex="0">
        <%= Current.user&.email&.first&.upcase || "?" %>
      </div>
      <div class="nav-dropdown-menu">
        <div class="nav-user-info">
          <div class="nav-user-email"><%= Current.user&.email %></div>
          <div class="nav-user-account"><%= Current.account&.name %></div>
        </div>
        <%= link_to "Settings", account_path, class: "nav-dropdown-item nav-dropdown-item-muted" %>
        <div class="nav-dropdown-divider"></div>
        <%= link_to "Sign out", logout_path, data: { turbo_method: :delete }, class: "nav-dropdown-item nav-dropdown-item-muted" %>
      </div>
    </div>
  </div>
</nav>
