<nav class="navbar bg-base-200 border-b border-base-300 px-4">
  <div class="flex-1 flex items-center gap-2">
    <%# Logo %>
    <%= link_to projects_path, class: "btn btn-ghost gap-2 px-2" do %>
      <svg class="w-6 h-6 fill-primary" viewBox="132.84 235.85 667.16 328.29" xmlns="http://www.w3.org/2000/svg">
        <path d="M635.86,564.14c-53.14,0-96.37-43.23-96.37-96.37v-135.55c0-21.61-17.58-39.18-39.18-39.18s-39.18,17.58-39.18,39.18v135.55c0,53.13-43.23,96.37-96.37,96.37s-96.37-43.23-96.37-96.37v-135.55c0-21.61-17.57-39.18-39.18-39.18s-39.18,17.58-39.18,39.18v28.59h-57.19v-28.59c0-53.14,43.23-96.37,96.37-96.37s96.37,43.23,96.37,96.37v135.55c0,21.6,17.58,39.18,39.19,39.18s39.18-17.58,39.18-39.18v-135.55c0-53.14,43.23-96.37,96.37-96.37s96.37,43.23,96.37,96.37v135.55c0,21.6,17.57,39.18,39.18,39.18s39.18-17.58,39.18-39.18v-135.55c0-53.14,43.23-96.37,96.36-96.37h28.59v57.19h-28.59c-21.6,0-39.18,17.58-39.18,39.18v135.55c0,53.13-43.23,96.37-96.37,96.37Z"/>
      </svg>
      <span class="font-semibold text-base-content hidden sm:inline">Watergun</span>
    <% end %>

    <%# Project selector dropdown %>
    <div class="dropdown">
      <div tabindex="0" role="button" class="btn btn-ghost btn-sm gap-1">
        <% if defined?(@project) && @project.present? %>
          <span class="font-mono"><%= @project.name %></span>
        <% else %>
          Projects
        <% end %>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
        </svg>
      </div>
      <ul tabindex="0" class="dropdown-content menu bg-base-200 rounded-box z-10 w-56 p-2 shadow-lg border border-base-300">
        <li class="menu-title text-xs">Projects</li>
        <% @nav_projects.each do |project| %>
          <li>
            <%= link_to project_path(project), class: (defined?(@project) && @project&.id == project.id) ? 'active' : '' do %>
              <span class="font-mono truncate"><%= project.name %></span>
            <% end %>
          </li>
        <% end %>
        <li class="border-t border-base-300 mt-1 pt-1">
          <%= link_to projects_path do %>
            View all projects
          <% end %>
        </li>
      </ul>
    </div>

    <%# Activity link %>
    <%= link_to "Activity", server_actions_path,
        class: "btn btn-ghost btn-sm #{controller_name == 'server_actions' ? 'btn-active' : ''}" %>
  </div>

  <div class="flex-none flex items-center gap-2">
    <%# Settings %>
    <%= link_to account_path,
        class: "btn btn-ghost btn-sm btn-square #{controller_name.in?(%w[settings profiles]) ? 'btn-active' : ''}",
        title: "Settings" do %>
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.325.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 0 1 1.37.49l1.296 2.247a1.125 1.125 0 0 1-.26 1.431l-1.003.827c-.293.241-.438.613-.43.992a7.723 7.723 0 0 1 0 .255c-.008.378.137.75.43.991l1.004.827c.424.35.534.955.26 1.43l-1.298 2.247a1.125 1.125 0 0 1-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.47 6.47 0 0 1-.22.128c-.331.183-.581.495-.644.869l-.213 1.281c-.09.543-.56.94-1.11.94h-2.594c-.55 0-1.019-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 0 1-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 0 1-1.369-.49l-1.297-2.247a1.125 1.125 0 0 1 .26-1.431l1.004-.827c.292-.24.437-.613.43-.991a6.932 6.932 0 0 1 0-.255c.007-.38-.138-.751-.43-.992l-1.004-.827a1.125 1.125 0 0 1-.26-1.43l1.297-2.247a1.125 1.125 0 0 1 1.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.086.22-.128.332-.183.582-.495.644-.869l.214-1.28Z" />
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
      </svg>
    <% end %>

    <%# User menu %>
    <div class="dropdown dropdown-end">
      <div tabindex="0" role="button" class="btn btn-ghost btn-sm btn-square">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
        </svg>
      </div>
      <ul tabindex="0" class="dropdown-content menu bg-base-200 rounded-box z-10 w-52 p-2 shadow-lg border border-base-300">
        <li class="menu-title text-xs"><%= Current.user&.email %></li>
        <li><%= link_to "Settings", account_path %></li>
        <li><%= link_to "Sign out", logout_path, data: { turbo_method: :delete } %></li>
      </ul>
    </div>

    <%# Mobile menu button %>
    <div class="dropdown dropdown-end sm:hidden">
      <div tabindex="0" role="button" class="btn btn-ghost btn-sm btn-square">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
      </div>
      <ul tabindex="0" class="dropdown-content menu bg-base-200 rounded-box z-10 w-56 p-2 shadow-lg border border-base-300">
        <li class="menu-title text-xs">Projects</li>
        <% @nav_projects.first(5).each do |project| %>
          <li><%= link_to project.name, project_path(project), class: "font-mono" %></li>
        <% end %>
        <li><%= link_to "View all projects", projects_path %></li>
        <li class="border-t border-base-300 mt-1 pt-1">
          <%= link_to "Activity", server_actions_path %>
        </li>
      </ul>
    </div>
  </div>
</nav>
