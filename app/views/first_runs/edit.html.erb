<div class="flex flex-col min-h-full px-4 pt-40 lg:px-4">
  <div class="px-6 pt-2 pb-8 shadow-lg rounded-xl sm:mx-auto sm:w-full sm:max-w-sm bg-base-100">
    <%= form_with(model: @user, url: first_run_path, class: "space-y-4") do |form| %>
      <%= hidden_field_tag :signed_id, params[:signed_id] %>
      <%= form.label :email, class: "form-control" do %>
        <div class="label"><span class="label-text">Email</span></div>
        <%= form.email_field :email, class: "input input-sm px-2 text-sm rounded-md input-bordered", required: true %>
        <%= error_messages_for(form.object, :email) %>
      <% end %>
      <%= form.label :password, class: "form-control" do %>
        <div class="label"><span class="label-text">Password</span></div>
        <%= form.password_field :password, class: "input input-sm px-2 text-sm rounded-md input-bordered", required: true %>
        <%= error_messages_for(form.object, :password) %>
      <% end %>
      <%= form.label :password_confirmation, class: "form-control" do %>
        <div class="label"><span class="label-text">Password confirmation</span></div>
        <%= form.password_field :password_confirmation, class: "input input-sm px-2 text-sm rounded-md input-bordered", required: true %>
        <%= error_messages_for(form.object, :password_confirmation) %>
      <% end %>
      <div class="pt-2">
        <%= component "submit_button", text: "Sign up" %>
      </div>
    <% end %>
  </div>
</div>
