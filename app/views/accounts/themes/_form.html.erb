<%= turbo_frame_tag :theme_form do %>
  <%= form_with model: user, url: account_theme_path, method: :patch,
                data: { controller: "theme-selector", action: "change->theme-selector#preview" } do |form| %>
    <div class="space-y-4">
      <fieldset class="fieldset">
        <legend class="fieldset-legend">Theme</legend>
        <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
          <% User::THEMES.each do |theme| %>
            <label class="cursor-pointer">
              <%= form.radio_button :theme, theme,
                  class: "hidden peer",
                  checked: (user.theme || "watergun") == theme,
                  data: { action: "change->theme-selector#preview" } %>
              <div class="p-4 border-2 rounded-lg peer-checked:border-primary peer-checked:bg-primary/10 border-base-300 hover:border-base-content/30 transition-colors"
                   data-theme="<%= theme %>">
                <div class="flex flex-col items-center gap-2">
                  <div class="w-full h-8 rounded bg-base-100 border border-base-300 flex items-center justify-center">
                    <div class="w-3 h-3 rounded-full bg-primary"></div>
                  </div>
                  <span class="text-sm font-medium capitalize text-base-content"><%= theme %></span>
                </div>
              </div>
            </label>
          <% end %>
        </div>
      </fieldset>
      <div class="flex">
        <%= submit_button "Save theme" %>
      </div>
    </div>
  <% end %>
<% end %>
