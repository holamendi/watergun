    <label class="block text-xs font-medium text-text-secondary">Theme</label>
    <div class="p-4 border rounded-lg border-border bg-elevated">
      <div class="flex items-center gap-3">
        <div class="w-10 h-6 rounded bg-base border border-border flex items-center justify-center">
          <div class="w-2 h-2 rounded-full bg-accent"></div>
        </div>
        <div>
          <span class="text-sm font-medium text-text-primary">Watergun Dark</span>
          <p class="text-xs text-text-muted mt-0.5">Custom dark theme optimized for deployment dashboards</p>
        </div>
      </div>
    </div>
  </div>
<% end %>
