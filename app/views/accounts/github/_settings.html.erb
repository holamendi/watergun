<div>
  <% if github_app %>
    <% if github_installation %>
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm font-medium">Connected to GitHub</p>
          <p class="text-sm text-base-content/60">Account: <%= github_installation.login %></p>
        </div>
        <%= button_to "Disconnect", github_installation_path(github_installation), method: :delete, class: "btn btn-outline btn-sm" %>
      </div>
    <% else %>
      <%= link_to "Connect GitHub", github_app.new_installation_url, class: "btn btn-primary" %>
    <% end %>
  <% else %>
    <div class="flex items-center justify-between">
      <%= form_with url: github_app_manifest.registration_url, method: :post do |form| %>
        <%= form.hidden_field :manifest, value: github_app_manifest.to_param %>
        <%= submit_button "Create Github App" %>
      <% end %>
    </div>
  <% end %>
</div>
