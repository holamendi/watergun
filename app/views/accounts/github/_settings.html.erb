<div>
  <% if github_app %>
    <% if github_installation %>
      <div class="flex items-center justify-between gap-4">
        <div>
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-success" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
            </svg>
            <span class="text-sm font-medium text-text-primary">Connected to GitHub</span>
          </div>
          <p class="text-xs text-text-muted mt-1 ml-6">Account: <%= github_installation.login %></p>
        </div>
        <%= button_to "Disconnect", github_installation_path(github_installation),
            method: :delete,
            class: "px-3 py-1.5 bg-transparent hover:bg-red-500/10 text-red-400 text-xs font-medium rounded-lg border border-red-400/50 transition-colors" %>
      </div>
    <% else %>
      <div class="flex items-center justify-between gap-4">
        <p class="text-xs text-text-muted">Link your GitHub account to enable repository deployments.</p>
        <%= link_to "Connect GitHub",
            github_app.new_installation_url,
            class: "px-4 py-2 bg-gradient-to-r from-accent to-accent-hover text-white text-xs font-medium rounded-lg shadow shadow-accent/20 hover:opacity-90" %>
      </div>
    <% end %>
  <% else %>
    <div class="flex items-center justify-between gap-4">
      <p class="text-xs text-text-muted">Create a GitHub App to enable repository deployments.</p>
      <%= form_with url: github_app_manifest.registration_url, method: :post do |form| %>
        <%= form.hidden_field :manifest, value: github_app_manifest.to_param %>
        <%= form.submit "Create GitHub App",
            class: "px-4 py-2 bg-gradient-to-r from-accent to-accent-hover text-white text-xs font-medium rounded-lg shadow shadow-accent/20 cursor-pointer hover:opacity-90" %>
      <% end %>
    </div>
  <% end %>
</div>
