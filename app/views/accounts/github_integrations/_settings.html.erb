<%= turbo_frame_tag :github_integration_settings do %>
  <% if github_integration.persisted? %>
    <div class="flex flex-col gap-5">
      <div class="flex flex-col flex-wrap w-full gap-x-4 md:flex-row">
        <div class="w-full md:w-1/2">
          <label class="form-control">
            <div class="pl-0 label">
              <span class="label-text">Personal access token</span>
            </div>
            <%= text_field_tag :personal_access_token, github_integration.obfuscated_token, class: "w-full p-3 text-sm font-light input focus:border-primary focus:outline-none", readonly: true, disabled: true %>
          </label>
        </div>
      </div>
      <div>
        <%= button_to "Disconnect", account_github_integrations_path, method: :delete, class: "btn btn-error font-normal rounded-full text-white", data: { turbo_confirm: "Are you sure? "} %>
      </div>
    </div>
  <% else %>
    <%= render "accounts/github_integrations/form", github_integration: %>
  <% end %>
<% end %>
