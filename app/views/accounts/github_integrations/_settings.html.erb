<%= turbo_frame_tag :github_integration_settings do %>
  <% if github_integration.app_registered? %>
    <% if github_integration.app_installed? %>
      <%= button_to "Uninstall Github App", github_installation_path, method: :delete, class: "btn btn-error rounded-full" %>
    <% else %>
      <%= link_to "Install Github App", "#{github_integration.app_url}/installations/new", class: "btn btn-primary rounded-full" %>
    <% end%>

  <% else %>
    <%= form_with url: "https://github.com/settings/apps/new", method: :post do |form| %>
      <%= form.hidden_field :manifest, value: github_integration.app_manifest.to_json %>
      <%= form.submit "Create Github App", class: "btn btn-primary rounded-full" %>
    <% end %>
  <% end %>
<% end %>
