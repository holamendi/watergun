<%= form_with model: github_integration, url: account_github_integrations_path, method: :post, id: "github_integration_form" do |form| %>
  <div class="flex flex-col gap-5">
    <div class="flex flex-col flex-wrap w-full gap-x-4 md:flex-row">
      <div class="w-full md:w-1/2">
        <label class="form-control">
          <div class="pl-0 label">
            <span class="label-text">Personal access token</span>
          </div>
          <%= form.text_field :personal_access_token, class: "w-full p-3 text-sm font-light input focus:border-primary focus:outline-none" %>
          <%= error_messages_for(github_integration, :personal_access_token) %>
        </label>
      </div>
    </div>
    <div>
      <%= button_tag "Save", type: "submit", class: "px-6 text-sm font-normal rounded-full btn-primary btn" %>
    </div>
  </div>
<% end %>
