<h1 class="pb-6 text-xl font-bold">API Tokens</h1>

<% if false %>
<h2 class="pb-4 text-lg font-bold">Github Access Token</h2>
<div class="pb-6">
<% if @github_access_token.persisted? %>
  <div class="flex justify-start w-full pb-6">
    <span class="pr-6">
      <%= @github_access_token.obfuscated_token %>
    </span>
    <%= button_to "Delete", account_github_access_token_path(current_account.github_access_token), method: :delete, class: "link text-error", data: { turbo_confirm: "Are you sure? "} %>
  </div>
<% else %>
  <div class="flex justify-start w-full pb-6">
    <%= render "accounts/github_access_tokens/form", github_access_token: @github_access_token %>
  </div>
  <%= link_to "Generate a new token", "https://github.com/settings/tokens/new?scopes=repo&description=Watergun", target: :_blank, class: "link" %>
<% end %>
</div>
<% end %>


<%= form_with model: ApiToken.new, url: account_api_tokens_path, class: "space-y-4", id: "api_token_form" do |form| %>
  <%= form.label :name, class: "form-control" do %>
    <div class="label">
      <span class="label-text">Name</span>
    </div>
    <%= form.text_field :name, class: "input input-bordered w-1/3", required: true %>
    <%= error_messages_for(form.object, :name) %>
  <% end %>
 <%= button_tag type: "submit",
                 class: "btn btn-primary no-animation",
                 data: { turbo_submits_with: "<span class='loading loading-spinner'></span>Save" } do %>
    Save
  <% end %>
<% end %>

<% if token = cookies.delete(:api_token) %>
  <%= token  %>
<% end%>

  <table class="table table-lg">
  <thead>
    <tr>
      <th>Name</th>
      <th>Token</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @api_tokens.each do |api_token| %>
      <tr>
        <td><%= api_token.name %></td>
        <td>******<%= api_token.token.last(4) %></td>
        <td>
          <%= button_to "Delete", account_api_token_path(api_token), method: :delete, class: "text-error link", form: { data: { turbo_confirm: "Do you really…" } } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
