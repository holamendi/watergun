<% @title = "Account Settings" %>

<div class="page-shell py-6">
  <div class="page-header">
    <h1 class="page-title">Account Settings</h1>
  </div>

  <div class="max-w-2xl space-y-6">
    <div class="form-card">
      <div class="form-card-header">
        <h2>Profile</h2>
      </div>
      <div class="form-card-body">
        <%= render "accounts/profiles/form", user: Current.user %>
      </div>
    </div>

    <div class="form-card">
      <div class="form-card-header">
        <h2>GitHub Integration</h2>
      </div>
      <div class="form-card-body">
        <%= render "accounts/github/settings",
                   github_app: Current.account.github_app,
                   github_app_manifest: Current.account.github_app_manifest,
                   github_installation: Current.account.github_installation %>
      </div>
    </div>
  </div>
</div>
