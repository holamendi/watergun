<div class="flex flex-col w-full gap-8 md:flex-row">
  <div class="flex-none w-full md:w-2/12">
    <%= render "accounts/settings/menu" %>
  </div>
  <div class="flex-col w-full md:w-10/12">
    <div class="page-title">
      <h1>General Settings</h1>
    </div>
    <div class="settings-section">
      <h2>Profile</h2>
      <%= turbo_frame_tag :profile_settings do %>
        <%= render "accounts/profiles/form", user: current_user %>
      <% end %>
    </div>
    <div class="my-10 divider"></div>
    <div class="settings-section">
      <h2>Github Integration</h2>
      <%= turbo_frame_tag :github_integration_settings do %>
        <%= render "accounts/github_integrations/settings", github_integration: current_account.github_integration || current_account.build_github_integration %>
      <% end %>
    </div>
  </div>
</div>
