<div class="max-w-screen-lg mx-auto">
  <div class="flex-col w-full">
    <div class="page-title">
      <h1>General Settings</h1>
    </div>
    <div class="settings-section">
      <h2>Profile</h2>
      <%= turbo_frame_tag :profile_settings do %>
        <%= render "accounts/profiles/form", user: Current.user %>
      <% end %>
    </div>
    <div class="my-10 divider"></div>
    <div class="settings-section">
      <h2>Github Integration</h2>
      <%= turbo_frame_tag :github_integration_settings do %>
        <%= render "accounts/github_integrations/settings", github_integration: Current.account.github_integration %>
      <% end %>
    </div>
  </div>
</div>
