<%= turbo_frame_tag :profile_settings do %>
  <%= form_with model: user, url: account_profile_path, method: :patch, class: "space-y-4" do |form| %>
    <div>
      <%= form.label :name, class: "block text-xs font-medium text-text-secondary mb-1.5" %>
      <%= form.text_field :name,
          class: "w-full px-3 py-2 bg-base border border-border rounded-lg text-sm placeholder:text-text-muted focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20 transition-all" %>
    </div>

    <div>
      <%= form.label :email, class: "block text-xs font-medium text-text-secondary mb-1.5" %>
      <%= form.email_field :email,
          class: "w-full px-3 py-2 bg-base border border-border rounded-lg text-sm placeholder:text-text-muted focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20 transition-all" %>
    </div>

    <div class="flex justify-end pt-2">
      <%= form.submit "Update profile",
          class: "px-4 py-2 bg-gradient-to-r from-accent to-accent-hover text-white text-xs font-medium rounded-lg shadow shadow-accent/20 cursor-pointer hover:opacity-90" %>
    </div>
  <% end %>
<% end %>
