<%= form_with model: user, url: account_profile_path do |form| %>
  <div class="flex flex-col gap-5">
    <div class="flex flex-col flex-wrap w-full gap-x-6 md:flex-row">
      <label class="flex-1 form-control">
        <div class="label"><span class="label-text">Name</span></div>
        <%= form.text_field :name, class: "input input-bordered ", placeholder: "Veronika" %>
      </label>
      <label class="flex-1 form-control">
        <div class="label"><span class="text-sm uppercase label-text">Email</span></div>
        <%= form.email_field :email, class: "input input-bordered", placeholder: "hello@bebest.com", disabled: true %>
      </label>
    </div>
    <div class="flex justify-end">
      <%= button_tag "Save", type: "submit", class: "btn btn-primary " %>
    </div>
  </div>
<% end %>
