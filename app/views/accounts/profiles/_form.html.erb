<%= turbo_frame_tag :profile_settings do %>
  <%= form_with model: user, url: account_profile_path, method: :patch do |form| %>
    <div class="space-y-4">
      <div>
        <%= form.label :name, class: "block text-sm font-medium leading-6 text-gray-900" %>
        <div class="mt-2">
          <%= form.text_field :name, class: "block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-teal-600 sm:text-sm sm:leading-6" %>
        </div>
      </div>
      <div>
        <%= form.label :email, class: "block text-sm font-medium leading-6 text-gray-900" %>
        <div class="mt-2">
          <%= form.email_field :email, class: "block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-teal-600 sm:text-sm sm:leading-6" %>
        </div>
      </div>
      <div class="flex">
        <%= component "submit_button" %>
      </div>
    </div>
  <% end %>
<% end %>


