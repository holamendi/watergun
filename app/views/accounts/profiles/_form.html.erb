<%= turbo_frame_tag :profile_settings do %>
  <%= form_with model: user, url: account_profile_path, method: :patch, class: "space-y-4" do |form| %>
    <fieldset class="fieldset">
      <legend class="fieldset-legend">Name</legend>
      <%= form.text_field :name, class: "input w-full" %>
    </fieldset>

    <fieldset class="fieldset">
      <legend class="fieldset-legend">Email</legend>
      <%= form.email_field :email, class: "input w-full" %>
    </fieldset>

    <div class="form-card-footer -mx-5 -mb-5 mt-5">
      <%= submit_button "Update Profile" %>
    </div>
  <% end %>
<% end %>
