<%# locals: (github_access_token:) -%>
<%= form_with model: github_access_token, url: account_github_access_tokens_path, class: "space-y-4", id: "github_access_token_form" do |form| %>
  <%= form.label :token, class: "form-control" do %>
    <div class="label">
      <span class="label-text">Token</span>
    </div>
    <%= form.text_field :token, class: "input input-bordered w-full" %>
    <%= error_messages_for(form.object, :token) %>
  <% end %>
  <%= button_tag type: "submit",
                 class: "btn btn-primary no-animation",
                 data: { turbo_submits_with: "<span class='loading loading-spinner'></span>Save" } do %>
    Save
  <% end %>
<% end %>
