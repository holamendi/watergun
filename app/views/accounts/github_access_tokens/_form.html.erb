<%= form_with model: github_access_token, url: account_github_access_tokens_path, method: :post, id: "github_access_token_form" do |form| %>
  <div class="flex flex-col gap-5">
    <div class="flex flex-col flex-wrap w-full gap-x-4 md:flex-row">
      <div class="w-full md:w-1/2">
        <label class="form-control">
          <div class="pl-0 label">
            <span class="label-text">Personal access token</span>
          </div>
          <%= form.text_field :token, class: "w-full p-3 text-sm font-light input font-poppins focus:border-primary focus:outline-none", placeholder: "ghp_abc123" %>
          <%= error_messages_for(github_access_token, :token) %>
        </label>
      </div>
    </div>
    <div>
      <%= button_tag "Save", type: "submit", class: "px-6 text-sm font-normal text-white btn-primary btn"  %>
    </div>
  </div>
<% end %>
