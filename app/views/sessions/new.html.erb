<div class="flex flex-col justify-center min-h-full px-6 py-12 lg:px-8">
  <div class="p-10 shadow-lg rounded-xl sm:mx-auto sm:w-full sm:max-w-sm bg-base-100">
    <%= form_with(scope: :session, url: sessions_path, class: "space-y-6") do |form| %>
      <div class="w-full form-control">
        <%= form.label :email, "email", class: "label" %>
        <%= form.text_field :email, class: "input input-bordered" %>
      </div>
      <div class="w-full form-control">
        <%= form.label :password, "password", class: "label" %>
        <%= form.password_field :password, class: "input input-bordered" %>
      </div>
      <div>
        <%= form.submit "log in", class: "btn w-full no-animation" %>
      </div>
    <% end %>
  </div>
</div>
