{
  "healthchecks": {
    "web": [
      {
        "type": "startup",
        "name": "web check",
        "path": "/up",
        "attempts": 3
      }
    ]
  },
  "cron": [
    {
      "command": "bundle exec rails runner 'Servers::SyncContainerDataJob.perform_later'",
      "schedule": "* * * * *"
    }
  ]
}
